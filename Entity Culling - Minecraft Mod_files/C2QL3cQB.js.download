005d12cb13_350.webp","raw_url":"https://cdn.modrinth.com/data/guxw1p9V/images/d5d4c419f7ce6334ef3a3434b0a537005d12cb13.jpeg","featured":false,"title":"Meeting Hall Bomb Site","description":null,"created":"2025-05-01T10:33:27.358207Z","ordering":12},{"url":"https://cdn.modrinth.com/data/guxw1p9V/images/68a117de9b5c05af938844d8b9cd6bf2d289367a_350.webp","raw_url":"https://cdn.modrinth.com/data/guxw1p9V/images/68a117de9b5c05af938844d8b9cd6bf2d289367a.jpeg","featured":false,"title":"Main Stairs Camera","description":null,"created":"2025-05-01T10:19:14.486134Z","ordering":13},{"url":"https://cdn.modrinth.com/data/guxw1p9V/images/561b822b92d70fd0a5536b4acf3623d4668234ef_350.webp","raw_url":"https://cdn.modrinth.com/data/guxw1p9V/images/561b822b92d70fd0a5536b4acf3623d4668234ef.jpeg","featured":false,"title":"Master Bedroom","description":null,"created":"2025-05-01T10:18:06.313345Z","ordering":14},{"url":"https://cdn.modrinth.com/data/guxw1p9V/images/1f6731b1172f1c73b4f63b0fd33c9ffd4563fd90_350.webp","raw_url":"https://cdn.modrinth.com/data/guxw1p9V/images/1f6731b1172f1c73b4f63b0fd33c9ffd4563fd90.jpeg","featured":false,"title":"Upstairs Game Room","description":null,"created":"2025-05-01T10:31:35.776837Z","ordering":15},{"url":"https://cdn.modrinth.com/data/guxw1p9V/images/4e29641ca41f41ed4a1a3578e5c53e53b0d9ec0d_350.webp","raw_url":"https://cdn.modrinth.com/data/guxw1p9V/images/4e29641ca41f41ed4a1a3578e5c53e53b0d9ec0d.jpeg","featured":false,"title":"Basement Laundry","description":null,"created":"2025-05-01T10:38:32.710297Z","ordering":16},{"url":"https://cdn.modrinth.com/data/guxw1p9V/images/9aa9f41d730749d23ab13b496fe8df3e95ba5887_350.webp","raw_url":"https://cdn.modrinth.com/data/guxw1p9V/images/9aa9f41d730749d23ab13b496fe8df3e95ba5887.jpeg","featured":false,"title":"Basement Freezer Hallway","description":null,"created":"2025-05-01T10:23:41.185210Z","ordering":17},{"url":"https://cdn.modrinth.com/data/guxw1p9V/images/5dd2a9abbc7096c467a301e748c860df871fc57f_350.webp","raw_url":"https://cdn.modrinth.com/data/guxw1p9V/images/5dd2a9abbc7096c467a301e748c860df871fc57f.jpeg","featured":false,"title":"GUI & Sidebar","description":null,"created":"2025-05-01T10:25:19.766092Z","ordering":18}],"color":2894892,"thread_id":"2mFp7aro","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.18.2","1.19.2","1.20","1.20.1","1.21","1.21.1"],"environment":["client_and_server"],"id":"rqIsPf9F","slug":"automobility","project_type":"mod","team":"gmOINGBj","organization":null,"title":"Automobility","description":"Vehicle mod adding customizable and functional cars","body":"![Automobility](https://github.com/FoundationGames/Automobility/raw/1.18.2/md/banner.png)\\n\\n### A Minecraft mod adding customizable vehicles.\\n**Automobility is currently in BETA!** <br/>\\nThe mod isn\'t feature-complete, and any feature requests would be greatly appreciated. Discuss features on the mod\'s GitHub Discussions page, or in the [Discord](https://discord.gg/7Aw3y4RtY9).\\n\\n## Available for Fabric and NeoForge\\n- Requires **[Fabric API](https://modrinth.com/mod/fabric-api)** (Fabric)\\n- No additional mods required for NeoForge\\n\\n**Currently in alpha for Minecraft 1.21.1, older versions are retired.**\\n\\n### Supports Data Packs and Resource Packs\\n- Add your own custom vehicle types with data packs and resource packs! \\n- Here is an [example](https://github.com/FoundationGames/City-Vehicles-Example-Addon) that you can use as a template.\\n\\n## Getting Started\\n- **Recipes:** Crafting table recipes can be viewed using [**EMI**](https://www.curseforge.com/minecraft/mc-mods/emi) or [**JEI**](https://www.curseforge.com/minecraft/mc-mods/jei). Automobile part recipes are viewed in the Auto Mechanic Table\'s GUI.\\n- **Automobile Parts:** Craft an Auto Mechanic Table. Use the GUI to craft the frame, engine, and wheels for your automobile. You can optionally craft an attachment.\\n- **Building your Automobile:** Craft an Automobile Assembler, as well as a Crowbar. Place parts on the assembler until the vehicle is complete. Use a crowbar to destroy the vehicle.\\n- **Enhancing your Automobile:** Use your Auto Mechanic Table to craft attachments, which can be placed on your Automobile to add exciting functionality or utility.\\n- **Building:** You can use Slopes, Dash Panels, Off-Road tiles and more to build roads, racetracks, or obstacle courses.\\n\\n![Automobile Construction](https://github.com/FoundationGames/Automobility/raw/1.18.2/md/construction.png)\\n![Automobile Types](https://github.com/FoundationGames/Automobility/raw/1.18.2/md/parking.png)\\n\\n## Driving\\n- W - Accelerate\\n- S - Brake/Reverse/Burnout\\n- A/D - Steer left/right\\n- Space - Drift\\n- Control - Honk Horn\\n\\n![Driving](https://github.com/FoundationGames/Automobility/raw/1.18.2/md/driving.png)","body_url":null,"published":"2022-08-11T00:27:07.803766Z","updated":"2025-04-24T20:09:19.143657Z","approved":null,"queued":null,"status":"approved","requested_status":null,"moderator_message":null,"license":{"id":"MIT","name":"MIT License","url":null},"downloads":5603457,"followers":1050,"categories":["equipment","technology","transportation"],"additional_categories":[],"loaders":["fabric","forge","neoforge","quilt"],"versions":["MviQ0J5x","Rw73lEq3","OeEoNGfX","AYSLOdYB","MlJfRaGI","oqe8dMIv","y1QMkRsR","CuwHiFWA","1ti5f1HJ","hYx6Ecdn","G4rPgXtN","vq2EgPYi","46g3IiWw","G97BY8OB","aPZ5M4XA","LFSvs1OB","RACoEepT","ETEPNWlt","A3iqH32h","Px4IK0hD","KjBmrTyE","lG7Ehci7","ucu8ghG5","ZOOLgRSD","vvzu2A6h","PHugwn1A"],"icon_url":"https://cdn.modrinth.com/data/rqIsPf9F/b4b8f4b4d1f012b8eb1011eb18041d5023dfbed9_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/rqIsPf9F/icon.png","issues_url":"https://github.com/FoundationGames/Automobility/issues","source_url":"https://github.com/FoundationGames/Automobility","wiki_url":null,"discord_url":"https://discord.gg/7Aw3y4RtY9","donation_urls":[],"gallery":[],"color":5126696,"thread_id":"rqIsPf9F","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["26.2"],"environment":["client_and_server"],"id":"yFoUqscS","slug":"voidweavermod","project_type":"mod","team":"TK2FSDYM","organization":null,"title":"VoidWeaverMod","description":"Help a forgotten goddess regain her power by descending into a prison enveloped in shadows.","body":"![VOIDWEAVER MOD LOGO](https://imgur.com/J88NXbD.png)\\n\\n_Some of the mod\'s visuals may not look correctly when playing with shaders._\\n\\n**For more detailed information on all of the mod\'s added content\\nPlease visit the [wiki](https://trello.com/b/Cobvdnzo/void-weaver-info)**\\n\\n![VOID WEAVER GIF](https://imgur.com/bwY1Dsr.gif)\\n\\nHelp a goddess forgotten to time regain her power\\n\\nShe was vanquished and her children sealed beneath the bedrock\\n\\nWith only a fragment of her former power she asks for you to aid her\\n\\nwill you?\\n\\n![VOID WEAVER GIF](https://imgur.com/5hLAoL9.gif)\\n\\nThe void beneath the bedrock, a prison made for her children\\n\\nThey\'ve been consumed by it, no longer answering her call\\n\\nUncover what lurks in the darkness and restore her power.\\n\\n![TEAMBK LOGO](https://imgur.com/32oE3jv.png)","body_url":null,"published":"2026-09-01T13:39:02.648225Z","updated":"2026-10-05T21:38:47.526291Z","approved":"2026-09-25T22:04:13.367464Z","queued":"2026-09-01T13:58:20.379788Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"MIT","name":"MIT License","url":null},"downloads":89,"followers":13,"categories":["magic","mobs","worldgen"],"additional_categories":["adventure","equipment"],"loaders":["neoforge"],"versions":["91UynNcF","safj85Ko","QIY1NREz"],"icon_url":"https://cdn.modrinth.com/data/yFoUqscS/c69329ef51529cd6ef6380a01a75559a29c558a8.gif","raw_icon_url":"https://cdn.modrinth.com/data/yFoUqscS/c69329ef51529cd6ef6380a01a75559a29c558a8.gif","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/yFoUqscS/images/736dd16a0dce24449c58919b8e073c5b7f7db61f.gif","raw_url":"https://cdn.modrinth.com/data/yFoUqscS/images/736dd16a0dce24449c58919b8e073c5b7f7db61f.gif","featured":false,"title":"Void Reaver","description":null,"created":"2026-09-01T13:52:49.371300Z","ordering":0},{"url":"https://cdn.modrinth.com/data/yFoUqscS/images/4a5eed83b2e8415ac861c6ff950d275684d56634.gif","raw_url":"https://cdn.modrinth.com/data/yFoUqscS/images/4a5eed83b2e8415ac861c6ff950d275684d56634.gif","featured":false,"title":"Void Stalker","description":null,"created":"2026-09-01T13:53:01.061099Z","ordering":0},{"url":"https://cdn.modrinth.com/data/yFoUqscS/images/1d8fae511d20b79acc16d7f075381746a12a5474.gif","raw_url":"https://cdn.modrinth.com/data/yFoUqscS/images/1d8fae511d20b79acc16d7f075381746a12a5474.gif","featured":false,"title":"Void Scythe","description":null,"created":"2026-09-01T13:53:21.377860Z","ordering":0},{"url":"https://cdn.modrinth.com/data/yFoUqscS/images/e3532873923e0a912b5341effe11f5529b0761e5.gif","raw_url":"https://cdn.modrinth.com/data/yFoUqscS/images/e3532873923e0a912b5341effe11f5529b0761e5.gif","featured":false,"title":"Void Hexer","description":null,"created":"2026-09-01T13:53:32.676631Z","ordering":0},{"url":"https://cdn.modrinth.com/data/yFoUqscS/images/97d0f42a0a420322c2aa426a8119dd7df4c9db29.gif","raw_url":"https://cdn.modrinth.com/data/yFoUqscS/images/97d0f42a0a420322c2aa426a8119dd7df4c9db29.gif","featured":false,"title":"Void Needle","description":null,"created":"2026-09-01T13:53:53.738864Z","ordering":0}],"color":2360324,"thread_id":"ciyLrNk2","monetization_status":"monetized"},{"client_side":"optional","server_side":"required","game_versions":["1.21.10","1.21.11","1.21.6","1.21.7","1.21.8","1.21.9","26.1","26.1.1","26.1.2","26.2","26.3"],"environment":["server_only_client_optional","unknown"],"id":"xM22oIAv","slug":"fabled-roots","project_type":"mod","team":"AQfqShpI","organization":"MRUpEFhN","title":"Fabled Roots","description":"Fabled Roots adds 10 unique races and 10 powerful classes to Minecraft, along with new weapons, items, spells and structures to explore.","body":"## 📖 Description\\n**Fabled Roots** is an RPG-lite data pack that adds **10 unique races** and **10 diverse classes**, along with new weapons, items, spells and structures. When you first join a world or server, you choose a race and a class to shape your playstyle. Changed your mind? You can reset your choices later from the pause menu. Everything is designed to enhance the classic Minecraft gameplay loop, giving your adventure a fresh twist without getting in the way.\\n\\n<br>\\n\\n## 🔎 Content Overview (Wiki)\\nWant to know what each race can do, which class fits you best or where to find the new weapons? It\'s all in our **[Wiki](https://wiki.explorerseden.eu/en/fabled_roots/home)**:\\n- 🧙‍♂️ **Races & Classes**: perks, drawbacks, home turfs and abilities of all 10 races, plus the perks of all 10 classes\\n- 🗡️ **Weapons & Items**: race weapons, armor and other new gear\\n- 📜 **Spells**: how to craft and enchant Spell Scrolls and what every spell does\\n- 🏚️ **Structures & Descendants**: race Shelters and Outposts, their NPCs and the journals hidden inside\\n\\n<br>\\n\\n## 🛠️ Technical Gibberish\\nAdmins/OPs can configure several aspects in game with `/function fabled_roots`.\\n\\nThis data pack also works as the **required** resource pack. Just put the same file into your `resourcepacks` folder and enable it in game so the textures show up properly.\\n\\n_(Not needed for the auto-converted mod versions in Single-Player.)_\\n\\n**PaperMC users:** set the `paper.maxChatCommandInputSize` property to a value between 512 and 1024 (see the [PaperMC Docs](https://docs.papermc.io/paper/reference/system-properties/#papermaxchatcommandinputsize)) and enable `allow-non-player-entities-on-scoreboards` in your Paper config.\\n\\n<br>\\n\\n## 📝 Translations\\nWant to play in your own language? Help us out by contributing on our **[Website](https://explorerseden.eu/translate/)**!\\n\\n<br>\\n\\n## ✍️ Feedback, Questions & Suggestions\\nWe\'re here to help! If you have questions or suggestions, or you\'ve run into a bug, hop on our Discord server and ask in the **Data Pack Section**. **[Click to join the server](https://discord.gg/f2pMggfgVv)**\\n\\n<br>\\n\\n## 🎮 Explorer\'s Eden SMP\\nJoin **[A Realm Recrafted](https://modrinth.com/server/a-realm-recrafted)**, our Minecraft SMP! Enjoy a world featuring all of our actively maintained data packs, plus some exclusive ones. It\'s completely free, with no microtransactions. Come build, explore and craft with us today!\\n\\n<a href=\\"https://modrinth.com/server/a-realm-recrafted\\" target=\\"_blank\\"><img src=\\"https://explorerseden.eu/images/ee_banner_new.png\\" alt=\\"Explorer\'s Eden\\" style=\\"width:100%;height:100%;\\"></a>\\n","body_url":null,"published":"2025-08-24T18:03:33.344653Z","updated":"2026-11-04T11:02:29.790774Z","approved":"2025-08-24T21:38:53.906048Z","queued":"2025-08-24T20:07:44.345885Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"GPL-3.0-or-later","name":"GNU General Public License v3.0 or later","url":null},"downloads":18970,"followers":77,"categories":["adventure","equipment","game-mechanics"],"additional_categories":[],"loaders":["datapack","fabric","forge","neoforge","quilt"],"versions":["AnD7gqG4","ck2kT8A1","oemzRayG","4OLSKLI9","RgFxtQxM","ltRH8iai","8cbvUfxt","RiO5dsL7","MMBcCj85","Ja93VHfs","EyzkhPRk","PSsW4tbG","6MHI2YHX","GUCSB46c","OUgcpAOq","aP7H7riO","pShfai0O","5gToGmkA","yhsCNSWM","NH1PiCg8","Bv0ZZ3iQ","8J6pNXEm","YfNGF9o7","trtwxW7b","zwQpGNNH","NiGVIKD7","hesnDVF5","7ZiB9rH0","npipbO5O","tK4guInj","4rhlWxB2","BIqQWENf","mfKOZQTH","fTaf6uTP","DkyKSVCo","UWwX6sW8","20A81Wp2","NjMCw7e5","DVzZjE5x","PHhBBtWW","EoxfqjTp","fI0P1cwg","ahgGzEbz","RgXLIvKu","yD9Q7d8I","4Ld3fZyY","U5HmuuZJ","I1DZisqn","ih8OeRjY","EVVAZne4","ovV71yVg","ukzwrc5P","HZ5NEsaI","cNNQNiF6","IEhOedin","ctF4mvOW","qpVBy2V5","wlpG4kDL"],"icon_url":"https://cdn.modrinth.com/data/xM22oIAv/2aa074adede3972a8cf444836554291f0884e641_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/xM22oIAv/2aa074adede3972a8cf444836554291f0884e641.png","issues_url":null,"source_url":"https://github.com/Explorers-Eden/Fabled-Roots","wiki_url":null,"discord_url":"https://discord.gg/f2pMggfgVv","donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/cf73b8d34a34ec05bc3cf567635886c596749a1f_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/cf73b8d34a34ec05bc3cf567635886c596749a1f.png","featured":false,"title":"Added Items","description":"An brief Overview of all items added","created":"2025-08-24T18:08:21.734360Z","ordering":0},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/f6ae0258a6ca99268849f9767a9e73caf011f5d8_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/f6ae0258a6ca99268849f9767a9e73caf011f5d8.jpeg","featured":false,"title":"Pause Menu","description":"How the Pause Menu looks like","created":"2025-08-24T19:57:24.424037Z","ordering":1},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/1930789a99eb1fb5a64fc8fbe023fc836287c472_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/1930789a99eb1fb5a64fc8fbe023fc836287c472.jpeg","featured":false,"title":"Wiki","description":"How the Wiki Menu looks like","created":"2025-08-24T19:57:42.119058Z","ordering":2},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/e75370b115e132bd58beeac997c95ddfc71f470e_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/e75370b115e132bd58beeac997c95ddfc71f470e.jpeg","featured":false,"title":"Class Selection","description":"How the Class selection looks like","created":"2025-08-24T19:58:11.053763Z","ordering":3},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/9e7e3e55b4669a6772d3561ded4bf91ab50ba007_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/9e7e3e55b4669a6772d3561ded4bf91ab50ba007.jpeg","featured":false,"title":"Race Selection","description":"How the Race selection looks like","created":"2025-08-24T19:58:30.009249Z","ordering":4},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/69e42d31c5cf75718c76601029b6b38115aa886a_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/69e42d31c5cf75718c76601029b6b38115aa886a.jpeg","featured":false,"title":"Structure Example","description":"Structure Example","created":"2025-08-24T20:56:07.595459Z","ordering":5},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/abfe338a7edb13c7fc75df863a32be4ad412c601_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/abfe338a7edb13c7fc75df863a32be4ad412c601.jpeg","featured":false,"title":"Structure Example","description":"Structure Example","created":"2025-08-24T20:56:17.649084Z","ordering":6},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/edefa5e6dd34800a1365cd154be203d84c17fe11_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/edefa5e6dd34800a1365cd154be203d84c17fe11.jpeg","featured":false,"title":"Structure Example","description":"Structure Example","created":"2025-08-24T20:56:29.191078Z","ordering":7},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/2ab8884895671f444193bbc4b95e7a1688990d3d_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/2ab8884895671f444193bbc4b95e7a1688990d3d.jpeg","featured":false,"title":"Structure Example","description":"Structure Example","created":"2025-08-24T20:56:40.240749Z","ordering":8},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/e677457f48e58cd9c54772b90a2a6bfd4dbcb96f_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/e677457f48e58cd9c54772b90a2a6bfd4dbcb96f.jpeg","featured":false,"title":"Structure Example","description":"Structure Example","created":"2025-08-24T20:56:52.053214Z","ordering":9},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/202bffc2630523b1b5a3a86bc9eed917f11d7cb5_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/202bffc2630523b1b5a3a86bc9eed917f11d7cb5.jpeg","featured":false,"title":"Structure Example","description":"Structure Example","created":"2025-08-24T20:57:01.379205Z","ordering":10},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/95060c365d20ded0a1066aff4173bb257150eecb_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/95060c365d20ded0a1066aff4173bb257150eecb.jpeg","featured":false,"title":"Structure Example","description":"Structure Example","created":"2025-08-24T20:57:09.388449Z","ordering":11},{"url":"https://cdn.modrinth.com/data/xM22oIAv/images/f8c2193704352223fd4a7338739368bdb24f0989_350.webp","raw_url":"https://cdn.modrinth.com/data/xM22oIAv/images/f8c2193704352223fd4a7338739368bdb24f0989.jpeg","featured":true,"title":"Title Card","description":"Title Card","created":"2025-08-24T21:00:47.763171Z","ordering":12}],"color":14592307,"thread_id":"SBZ7cT8Y","monetization_status":"monetized"},{"client_side":"required","server_side":"unsupported","game_versions":["26.2"],"environment":["client_only"],"id":"LhdiC19i","slug":"scaley","project_type":"mod","team":"6DoeurEI","organization":null,"title":"Scaley","description":"Scaley is a Minecraft Fabric mod for stretched resolution, custom FOV, and view-model tweaks. It lets you run aspect ratios like 4:3, bypass vanilla FOV limits, and customize held item positions and rotations for both hands directly in-game.","body":"**Scaley** is a client-side Fabric mod for Minecraft 26.2 that gives you full control over your display resolution, field of view, and first-person hand & view-model positions.\\n\\n---\\n\\n## Features\\n\\n**🖥️ Stretched & Custom Display Resolution**\\n- **Aspect Presets**: Easily switch between **4:3**, **5:4**, **16:10**, **16:9**, **1:1**.\\n- **Window Modes**: Seamlessly toggle between **Windowed**, **Borderless Windowed**, and **Fullscreen**.\\n- **Stretched Resolution**: Render at stretched aspect ratios (like 4:3) with proper UI scaling and accurate mouse click alignment.\\n\\n**👁️ FOV Overrides**\\n- **Uncapped FOV Slider**: Set your world FOV anywhere from **1° to 180°**, bypassing vanilla\'s 30–110 limits.\\n- **Dynamic FOV Toggle**: Keep or disable sprint, speed, and slowness FOV zoom effects.\\n\\n**⚔️ View-Model & Hand Customization**\\n- **3D Position & Rotation**: Adjust X, Y, and Z offsets and rotation angles for your held items and hands.\\n- **Independent Off-Hand Controls**:\\n  - **Mirror Mode (Default)**: Automatically flips your main-hand offsets across the Y-axis so your off-hand stays balanced.\\n  - **Independent Mode**: Customize Off-Hand scale, position, and rotation with dedicated sliders.\\n- **View-Model FOV**: Control your hand/held item FOV independently from your world FOV.\\n- **Action Offsets**: Set custom X, Y, and Z position offsets specifically while **eating/drinking** or **blocking** so food and shields don\'t block your crosshair during PvP.\\n- **Hand Visibility Toggles**: Hide your main hand, off-hand, or empty hands in first-person for a minimalist HUD or screen recording.\\n\\n---\\n\\n## Requirements\\n\\nScaley is a **client-side only** mod and works on all multiplayer servers.\\n- **Minecraft**: `26.2`\\n- **Mod Loader**: `Fabric Loader` (>= 0.19.3)\\n- **Dependencies**:\\n  - [Fabric API](https://modrinth.com/mod/fabric-api)\\n  - [Cloth Config](https://modrinth.com/mod/cloth-config)\\n\\n---\\n\\n## Controls & Usage\\n\\nPress the **Scaley keybind** (or open the ModMenu in-game) and navigate to **Scaley** to adjust all settings live.","body_url":null,"published":"2026-07-20T10:33:56.531570Z","updated":"2026-07-20T14:08:29.543682Z","approved":"2026-07-31T20:19:40.891311Z","queued":"2026-07-27T02:33:50.278741Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"MIT","name":"MIT License","url":null},"downloads":1487,"followers":4,"categories":["utility"],"additional_categories":["game-mechanics"],"loaders":["fabric"],"versions":["NeqFT9rt"],"icon_url":"https://cdn.modrinth.com/data/LhdiC19i/3a363e142383aa600f81d9707fba6476181cd190_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/LhdiC19i/3a363e142383aa600f81d9707fba6476181cd190.png","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/LhdiC19i/images/e6093f018f0d47e24ba688f8c53a5c37356f7487_350.webp","raw_url":"https://cdn.modrinth.com/data/LhdiC19i/images/e6093f018f0d47e24ba688f8c53a5c37356f7487.png","featured":false,"title":"4:3 Villager","description":null,"created":"2026-07-20T14:32:47.658527Z","ordering":0},{"url":"https://cdn.modrinth.com/data/LhdiC19i/images/0ca942bdece76ca7342a98a1103f7056ff906b9e_350.webp","raw_url":"https://cdn.modrinth.com/data/LhdiC19i/images/0ca942bdece76ca7342a98a1103f7056ff906b9e.png","featured":false,"title":"5:4 Villager","description":null,"created":"2026-07-20T14:32:59.648034Z","ordering":0},{"url":"https://cdn.modrinth.com/data/LhdiC19i/images/abb636b067d318e1e71218e849dcfc0206e65196_350.webp","raw_url":"https://cdn.modrinth.com/data/LhdiC19i/images/abb636b067d318e1e71218e849dcfc0206e65196.png","featured":false,"title":"1:1 Villager","description":null,"created":"2026-07-20T14:33:07.943361Z","ordering":0},{"url":"https://cdn.modrinth.com/data/LhdiC19i/images/4eb8f5f949f4bca8d473ee2ff8b51d034ebfefdb_350.webp","raw_url":"https://cdn.modrinth.com/data/LhdiC19i/images/4eb8f5f949f4bca8d473ee2ff8b51d034ebfefdb.png","featured":false,"title":"16:10 Villager","description":null,"created":"2026-07-20T14:33:19.533476Z","ordering":0},{"url":"https://cdn.modrinth.com/data/LhdiC19i/images/2b8d3b38d0a1867a95a5050676533c057358a493_350.webp","raw_url":"https://cdn.modrinth.com/data/LhdiC19i/images/2b8d3b38d0a1867a95a5050676533c057358a493.png","featured":false,"title":"Display Tab","description":null,"created":"2026-07-20T14:33:27.690692Z","ordering":0},{"url":"https://cdn.modrinth.com/data/LhdiC19i/images/0a7e802d2a86f5dabf7614b7c6b6f1b8e00db90d_350.webp","raw_url":"https://cdn.modrinth.com/data/LhdiC19i/images/0a7e802d2a86f5dabf7614b7c6b6f1b8e00db90d.png","featured":false,"title":"Fov Tab","description":null,"created":"2026-07-20T14:33:35.695771Z","ordering":0},{"url":"https://cdn.modrinth.com/data/LhdiC19i/images/c8ac80b7cf51451697a13387e4bfe63a1c423762_350.webp","raw_url":"https://cdn.modrinth.com/data/LhdiC19i/images/c8ac80b7cf51451697a13387e4bfe63a1c423762.png","featured":false,"title":"Main Hand Tab","description":null,"created":"2026-07-20T14:33:44.417060Z","ordering":0},{"url":"https://cdn.modrinth.com/data/LhdiC19i/images/fed908f17fa7d418bacd3e0d1b00de7175c4286c_350.webp","raw_url":"https://cdn.modrinth.com/data/LhdiC19i/images/fed908f17fa7d418bacd3e0d1b00de7175c4286c.png","featured":false,"title":"Off Hand Tab","description":null,"created":"2026-07-20T14:33:52.606886Z","ordering":0},{"url":"https://cdn.modrinth.com/data/LhdiC19i/images/38d772483c5307b1c7fc566db8ca6f3c3f1ceecb_350.webp","raw_url":"https://cdn.modrinth.com/data/LhdiC19i/images/38d772483c5307b1c7fc566db8ca6f3c3f1ceecb.png","featured":false,"title":"Actions Tab","description":null,"created":"2026-07-20T14:34:01.082289Z","ordering":0},{"url":"https://cdn.modrinth.com/data/LhdiC19i/images/9f88b7112490f849589bc36b291a33dca09b002c_350.webp","raw_url":"https://cdn.modrinth.com/data/LhdiC19i/images/9f88b7112490f849589bc36b291a33dca09b002c.png","featured":true,"title":"Feelin Cute! 😘","description":null,"created":"2026-07-20T14:39:54.693230Z","ordering":0}],"color":3553323,"thread_id":"b9L5wEGJ","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.21","1.21.1"],"environment":["client_and_server"],"id":"wLd3PXzz","slug":"psittacine","project_type":"mod","team":"riOk0ulq","organization":null,"title":"Psittacine","description":"Breedable parrots, 35 new parrot skins, colorful feather blocks, transport cages, and functionality tweaks.","body":"An overhaul mod for Minecraft\'s most neglected tameable mob.\\n\\n# BREEDING \\nAt last, you can help to replenish the population of these endangered tropical birds. Very ecologically-minded of you.\\n\\nTo start, you\'ll need to craft one of each of the vanilla seed types together to make a seed cake. Then craft another one, and feed them to two tamed parrots.<br>\\n![A seed cake.](https://cdn.modrinth.com/data/cached_images/19ab4024705c906116a8bf190d78940526d0e5f1.png)\\n![A toasted seed cake.](https://cdn.modrinth.com/data/cached_images/329e204be3108c228b9872426367512917185dcd.png)\\n<br>\\n(Seed cakes can also be toasted, and eaten by the player as a healthy snack.)\\n\\nWhen bred, parrots, like sniffers, will drop a single egg that needs to be placed by the player.<br>\\n![A parrot egg.](https://cdn.modrinth.com/data/cached_images/fe27f976ee446167cdad4f70764f571c869b7dd0.png)<br>\\nParrot eggs will only hatch if placed on top of a log, leaf, or parrot feather block, and jungle logs, leaves, and feather blocks will make them hatch twice as fast. Be careful though: like turtle eggs, parrot eggs are fragile and might break if walked or landed on.\\n\\nParrot eggs, and the babies they hatch into, will randomly inherit the skin of one of their parents. While in item form, eggs created by breeding will display the parrot type they\'ll hatch into as a tool tip. Be ready with some seeds: baby parrots will hatch as wild birds and need taming.\\n\\n# NEW SKINS AND BIOMES\\nPsittacine adds 35 new biome-dependent parrot skins based on real-world species. They will now also spawn in savannas, wooded badlands, mangrove swamps, and a few modded biomes as well.<br> \\n![A few new parrots, standing in a row.](https://cdn.modrinth.com/data/cached_images/c6c954edeef8dcfbb6270ad0ab832698a0ec4ec5.png)<br>\\nFinding yourself a unique little feathered friend has never been easier.\\n\\n# PARROT FEATHERS, FEATHER BLOCKS, AND CARPETS\\nParrots will now periodically shed one of ten colorful feathers. Which set of feathers each parrot sheds will depend on its skin.<br>\\n![All ten colors of parrot feather.](https://cdn.modrinth.com/data/cached_images/9b36aa025f358d954258f100775f0597f35a3dfb.png)<br>\\nFeathers can be crafted into blocks and fluffy carpets, which dampen sounds just like wool does.\\nFeather blocks additionally negate all fall damage and are an excellent spot to hatch a parrot egg.\\n![Parrot feather blocks in various colors.](https://cdn.modrinth.com/data/cached_images/138a223cd6a252e1daeefbce4adbe40f52504afc.png)\\nParrot feathers (and vanilla feathers, as a treat) can also be placed into flower pots for a bit of old-timey literary decor.\\n\\n# CAGES\\nWant to transport your parrot without exposing it to the many dangers of travel? Craft some bird cages out of an iron trapdoor and two iron bars and tuck your little pal safely into your inventory.<br>\\n![An empty bird cage.](https://cdn.modrinth.com/data/cached_images/2d72804395520917c261d29cc16a9bfb8329ee25_0.webp)\\n![A caged parrot.](https://cdn.modrinth.com/data/cached_images/4261db75ad1061c64eb446f1717209ddede15df4_0.webp)\\n\\n# ADDITIONAL TWEAKS\\nParrots will now only imitate hostile mob sounds when the mob in question is nearby, restoring their usefulness as portable security alarms.\\n\\nAccidentally clicking on a parrot with a cookie will no longer do the unforgivable, so enjoy your sweet snacks with your favorite little squawker nearby without fear.","body_url":null,"published":"2024-10-16T17:12:56.861175Z","updated":"2024-10-16T17:16:20.469087Z","approved":"2024-10-17T23:52:08.640389Z","queued":"2024-10-16T23:25:57.456729Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"CC-BY-NC-SA-4.0","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","url":null},"downloads":21475,"followers":137,"categories":["decoration","game-mechanics","mobs"],"additional_categories":["food","utility","worldgen"],"loaders":["fabric"],"versions":["fF5ecBgz"],"icon_url":"https://cdn.modrinth.com/data/wLd3PXzz/40171e31bd4fb50627b38bcf178ee3850ee76bb0_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/wLd3PXzz/40171e31bd4fb50627b38bcf178ee3850ee76bb0.png","issues_url":"https://github.com/MisterHyacinth/Psittacine/issues","source_url":"https://github.com/MisterHyacinth/Psittacine","wiki_url":"https://github.com/MisterHyacinth/Psittacine/wiki","discord_url":"https://discord.gg/GMHhXxnK","donation_urls":[{"id":"ko-fi","platform":"Ko-fi","url":"https://ko-fi.com/misterhyacinth"},{"id":"patreon","platform":"Patreon","url":"https://patreon.com/MisterHyacinth"}],"gallery":[{"url":"https://cdn.modrinth.com/data/wLd3PXzz/images/bf26d0186cc6023217bc6056c29f637aedd7a528_350.webp","raw_url":"https://cdn.modrinth.com/data/wLd3PXzz/images/bf26d0186cc6023217bc6056c29f637aedd7a528.png","featured":false,"title":"All parrot skins","description":"All parrot skins added by the mod. Vanilla skins (slightly tweaked) are highlighted in white. Parrots with a lighter green background spawn in bamboo jungles, and parrots with a red background spawn in arid biomes.","created":"2024-10-16T19:01:30.226908Z","ordering":0}],"color":9724431,"thread_id":"rC10BaDK","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.20.1","1.21.1","1.21.11","26.1.1","26.1.2","26.2","26.3"],"environment":["client_and_server"],"id":"LQpzAdIk","slug":"maples-rabbits-seasonal-variants","project_type":"mod","team":"NKlJrn0Y","organization":null,"title":"Maple\'s Rabbits | Seasonal Variants","description":"Seasonal rabbit variants with custom textures that change with the seasons! 🐰 New and Classic.","body":"<p style=\\"text-align: center;\\"><span style=\\"font-size: 36px;\\">✨Bring Some Bunny Bliss to Your Minecraft World 🐰</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\"><em>Custom designed rabbit textures to bring a little something extra to your gameplay.<br /></em></span><br /><span style=\\"font-size: 18px;\\">The textures change automatically with the seasons! (can be turned off)</span><br /><br /></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 20px;\\"><a href=\\"https://modrinth.com/mod/sapling\\" rel=\\"nofollow\\">🌱 The Sapling mod needs to be installed in order for this mod to work&nbsp;🌱</a></span></p><p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\"><br /><span style=\\"font-size: 24px;\\"><strong>✨The super new 26.1 (and beyond) model is available! ✨</strong></span></span></p>\\n<p>&nbsp;<img src=\\"https://media.forgecdn.net/attachments/1632/974/rabbit-front-banner-new-13-png.png\\" /></p>\\n<p>&nbsp;<br /><img src=\\"https://media.forgecdn.net/attachments/1613/575/26.png\\" /></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\"><em><br /></em><span style=\\"font-size: 24px;\\"><strong>✨Ofcourse we can\'t forget about the Classic model!✨<br /></strong><span style=\\"font-size: 18px;\\"><em>Available for Minecraft 1.20.1, 1.21.1 and 1.21.11</em></span><strong><br /><img src=\\"https://media.forgecdn.net/attachments/1632/975/classic-rabbit-banners-16-png.png\\" /></strong></span></span></p>\\n<p style=\\"text-align: center;\\">&nbsp;</p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\"><span style=\\"font-size: 24px;\\"><strong><img src=\\"https://media.forgecdn.net/attachments/1632/976/classic-rabbit-banners-17-png.png\\" /></strong></span></span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\"><br />-------------------------------------------------------------------------------------------------------------------<br />\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">The rabbit variations spawn randomly across the world.&nbsp;</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">The rabbits stay in their own skin when re-opening a world, collect \'m all!&nbsp;🤗</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">🌸☀️🍂❄️</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">The textures will automatically change per season. There will also still be regular rabbits.</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">&nbsp;</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">The season dates: day - month</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">🌸Spring:&nbsp; 01-03 / 31-05&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;☀️Summer: 01-06 / 31-08&nbsp;</span><br /><span style=\\"font-size: 18px;\\">🍂Autumn:&nbsp; 01-09 / 30-11&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ❄️Winter: &nbsp;01-12 / 28-02 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">&nbsp;</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">There is also an added command for which hemisphere you prefer! Northern or Southern 😊</span><br /><span style=\\"font-size: 18px;\\">(Northern is selected automatically)</span></p>\\n<p style=\\"text-align: center;\\"><br /><span style=\\"font-size: 18px;\\">‼️🏷️If you want to keep a certain rabbit texture on a specific rabbit for the whole year make sure to give</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">them a name tag before the new season starts! Otherwise, they will change.&nbsp;‼️🏷️</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">&nbsp;</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\"><strong>Commands<br /></strong><em>⚙️</em><em>To customize your experience.</em></span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 18px;\\">&nbsp;</span></p>\\n<p><span style=\\"font-size: 18px;\\"><u>Admin Tools</u></span><br /><span style=\\"font-size: 18px;\\">/maplemods rabbit adminTools flipSeasonDatesToOtherHemisphere&nbsp;&nbsp; | To change the hemisphere</span><br /><span style=\\"font-size: 18px;\\">/maplemods rabbit adminTools resetAllLoadedEntityTextures&nbsp;&nbsp; |&nbsp; To reset the rabbits that are already loaded in the game</span><br /><span style=\\"font-size: 18px;\\">/maplemods rabbit adminTools reloadConfigFile&nbsp; | To reload changes in the Config</span></p>\\n<p><span style=\\"font-size: 18px;\\">&nbsp;</span></p>\\n<p><span style=\\"font-size: 18px;\\"><u>Config Values</u></span><br /><span style=\\"font-size: 18px;\\">/maplemods rabbit setConfigValues showCurrentValues</span><br /><span style=\\"font-size: 18px;\\">/maplemods rabbit setConfigValues disableSeasonsDuringHoliday (false/true)&nbsp; | Option to disable the mixture of the holidays and the seasonal textures.</span><br /><span style=\\"font-size: 18px;\\">/maplemods rabbit setConfigValues nameTagPreventsTexture (false/true)&nbsp; | Option to save the texture with the name tag or to disable it.</span><br /><span style=\\"font-size: 18px;\\">/maplemods rabbit setConfigValues replaceSeasonalTextures &nbsp;| To reload the textures after making a change.</span></p>\\n<p><span style=\\"font-size: 18px;\\">&nbsp;</span></p>\\n<p><span style=\\"font-size: 18px;\\"><u>Update Category Settings</u></span><br /><span style=\\"font-size: 18px;\\">/maplemods rabbit updateCategorySettings _default&nbsp;&nbsp; | Disable or enable the original rabbit texture</span><br /><span style=\\"font-size: 18px;\\">/maplemods rabbit updateCategorySettings&nbsp;<em>&lt;category&gt;</em>&nbsp;(disable/enable/setDate)&nbsp; | Customize the seasons</span></p>\\n<p><span style=\\"font-size: 18px;\\">&nbsp;</span></p>\\n<p><span style=\\"font-size: 18px;\\"><u>Update Texture Settings</u></span><br /><span style=\\"font-size: 18px;\\">/maplemods rabbit updateTextureSettings&nbsp;<em>&lt;texture&gt;</em>&nbsp;(disable/enable) | To specifically choose which textures to enable or disable</span></p>\\n<p><span style=\\"font-size: 18px;\\">&nbsp;</span></p>\\n<p>&nbsp;</p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 24px;\\">Very excited to finally design and launch my custom rabbits.</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 24px;\\">✨ Hope you enjoy seeing them hop around as much as I enjoyed creating them ✨</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 24px;\\">The seasonal textures are also available with:</span></p>\\n<h5 style=\\"text-align: center;\\">&nbsp;</h5>\\n<h4 style=\\"text-align: center;\\"><span style=\\"font-size: 24px;\\"><a href=\\"https://modrinth.com/mod/maples-bee-collection\\" target=\\"_blank\\" rel=\\"nofollow noopener noreferrer\\">The Bees! 🐝</a></span></h4>\\n<h4 style=\\"text-align: center;\\"><span style=\\"font-size: 24px;\\"><a href=\\"https://modrinth.com/mod/maples-chicken-collection\\" rel=\\"nofollow\\">The Chickens! 🐥</a></span></h4>\\n<h4 style=\\"text-align: center;\\"><span style=\\"font-size: 24px;\\"><a href=\\"https://modrinth.com/mod/maples-creeper-collection\\" target=\\"_blank\\" rel=\\"nofollow noopener noreferrer\\">The Creepers!💚</a></span></h4>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 24px;\\">&nbsp;</span></p>\\n<p style=\\"text-align: center;\\"><span style=\\"font-size: 24px;\\">More mobs coming soon!</span></p>","body_url":null,"published":"2026-04-04T09:42:12.849137Z","updated":"2026-10-24T17:14:43.610967Z","approved":"2026-04-24T03:11:57.471471Z","queued":"2026-04-04T10:02:53.021156Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":3632,"followers":14,"categories":["decoration","mobs","worldgen"],"additional_categories":["adventure"],"loaders":["fabric","forge","neoforge","quilt"],"versions":["Y2qX901a","2pT6iaUI","a6O4CzLC","XdlpP33Z","7HS0GNdB","q2O6rVio","fIxV91rC","drgLx3e6","9arDBloQ","Vo4LjwTk","Q9XQNph6","nWDhfsXx","uguNsPpT","K698ABWt","iSqcZq2Z","fcnDb678","XQhCkQFf","Fj7qDRGB","IRJHxVqz","wudihfK0","Q8FlWsq9","rRgX82yX","OQwhtCd0","XTYkQhkb","CDEwFMRU","eufKapPJ","HHnPimM9","FcXLwsqn","Jf57qSVG","O6xZhISi","KK7GtT6M","71dkxY6y","4v6eOsuu","vs9iCMh2","gtOAmSRR","wWnv7DJg","Dasrv6aP"],"icon_url":"https://cdn.modrinth.com/data/LQpzAdIk/6fafc37699938f2ed955d7ce6c0b501c2872754a_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/LQpzAdIk/6fafc37699938f2ed955d7ce6c0b501c2872754a.png","issues_url":"https://github.com/MapleMods/Maples-Rabbits-Seasonal-Variants/issues","source_url":"https://github.com/MapleMods/Maples-Rabbits-Seasonal-Variants","wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[],"color":14203025,"thread_id":"PjQz5fhg","monetization_status":"monetized"},{"client_side":"required","server_side":"unsupported","game_versions":["1.17","1.17.1","1.18","1.18.1","1.18.2","1.19","1.19.1","1.19.2","1.19.3","1.19.4","1.20","1.20.1","1.20.2","1.20.2-pre1","1.20.3","1.20.4","1.20.5","1.20.5-pre1","1.20.5-pre2","1.20.5-pre3","1.20.6","1.21","1.21-pre1","1.21-pre2","1.21-pre3","1.21-pre4","1.21-rc1","1.21.1","1.21.1-rc1","1.21.10","1.21.11","1.21.2","1.21.2-pre1","1.21.2-pre2","1.21.2-pre3","1.21.2-pre4","1.21.2-pre5","1.21.2-rc1","1.21.2-rc2","1.21.3","1.21.4","1.21.4-pre1","1.21.5","1.21.6","1.21.7","1.21.8","1.21.9","22w42a","22w43a","22w44a","23w14a","23w16a","23w31a","23w32a","23w33a","23w35a","23w42a","23w43a","23w43b","23w44a","23w45a","23w46a","24w03a","24w03b","24w04a","24w05a","24w05b","24w06a","24w07a","24w09a","24w10a","24w11a","24w12a","24w13a","24w14a","24w14potato","24w18a","24w19a","24w19b","24w20a","24w21a","24w21b","24w33a","24w34a","24w35a","24w36a","24w37a","24w38a","24w39a","24w40a","24w44a","24w45a","24w46a","25w02a","25w03a","25w04a","25w05a","25w06a","25w07a","25w08a","25w09a","25w09b","25w10a","25w14craftmine","25w15a","25w16a","25w17a","25w18a","25w19a","25w20a","25w21a","25w31a","25w32a","25w33a","25w34a","25w34b","25w35a","25w36a","25w36b","25w37a","25w41a","25w42a","25w43a","25w44a","25w45a","25w46a","26.1","26.1.1","26.1.2","26.2","26.3","26.3-pre-1","26.3-pre-2","26.3-pre-3","26.3-rc-1","26.3-rc-2","26.3-rc-3","26.3-snapshot-1","26.3-snapshot-10","26.3-snapshot-2","26.3-snapshot-3","26.3-snapshot-4","26.3-snapshot-5","26.3-snapshot-6","26.3-snapshot-7","26.3-snapshot-8","26.3-snapshot-9"],"environment":[],"id":"CCxCashH","slug":"cute-realism-bee","project_type":"resourcepack","team":"bCVopdto","organization":null,"title":"Cute & Realism Bee","description":"A Minecraft bee redesign that makes them a bit more like real life bees but cute!","body":"Minecraft bees are sooo cute! This resource pack offers you a new design of minecraft bees with more shapes and a slightly less saturated color palette.\\n\\n\\n# Screenshots\\nFor Tiny Takeover updates: one adult bee with two baby bees\\n![One adult bee with two baby bees](https://cdn.modrinth.com/data/cached_images/c123faed1d97125708264768d59d5d483d0f939e.jpeg)\\nBees\\n![Bee flying across a cherry blossom tree.](https://cdn.modrinth.com/data/cached_images/47870fc68fbcf863e76b3136845b66f7dd297f1e_0.webp)\\n![Bee looking at you](https://cdn.modrinth.com/data/cached_images/81b095b745d63166ff25791a98f80d26b86d2747_0.webp)\\n![Bee flying in the sky](https://cdn.modrinth.com/data/cached_images/a30a4097f04f16e26f7ae3c8004a09da8e3b3a22_0.webp)\\n\\n\\n# Requirements\\nThis pack requires\\n\\n[Optifine](https://optifine.net/downloads)\\n\\n\\\\- or -\\n\\n[ETF](https://modrinth.com/mod/entitytexturefeatures)\\nand\\n[EMF](https://modrinth.com/mod/entity-model-features)\\n\\n\\n# Compatibility\\nThis pack is compatible with [Xaero\'s Minimap](https://modrinth.com/mod/xaeros-minimap) with a custom minimap icon for the bees.","body_url":null,"published":"2026-01-05T04:38:52.470458Z","updated":"2026-04-18T16:43:28.018914Z","approved":"2026-01-05T06:04:55.977675Z","queued":"2026-01-05T05:54:58.421173Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":2181,"followers":13,"categories":["entities","models","simplistic"],"additional_categories":["32x"],"loaders":["minecraft"],"versions":["zHwv0Jxu","OGihu0Fx"],"icon_url":"https://cdn.modrinth.com/data/CCxCashH/b3ff5de62389da007ddad5cfd0a51c53c3393d0c_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/CCxCashH/b3ff5de62389da007ddad5cfd0a51c53c3393d0c.png","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/CCxCashH/images/47870fc68fbcf863e76b3136845b66f7dd297f1e_350.webp","raw_url":"https://cdn.modrinth.com/data/CCxCashH/images/47870fc68fbcf863e76b3136845b66f7dd297f1e.png","featured":false,"title":"Bee","description":null,"created":"2026-01-05T05:52:57.430672Z","ordering":0},{"url":"https://cdn.modrinth.com/data/CCxCashH/images/a30a4097f04f16e26f7ae3c8004a09da8e3b3a22_350.webp","raw_url":"https://cdn.modrinth.com/data/CCxCashH/images/a30a4097f04f16e26f7ae3c8004a09da8e3b3a22.png","featured":false,"title":"Bee","description":null,"created":"2026-01-05T05:53:03.639801Z","ordering":0},{"url":"https://cdn.modrinth.com/data/CCxCashH/images/81b095b745d63166ff25791a98f80d26b86d2747_350.webp","raw_url":"https://cdn.modrinth.com/data/CCxCashH/images/81b095b745d63166ff25791a98f80d26b86d2747.png","featured":false,"title":"Bee","description":null,"created":"2026-01-05T05:53:09.697707Z","ordering":0},{"url":"https://cdn.modrinth.com/data/CCxCashH/images/c123faed1d97125708264768d59d5d483d0f939e_350.webp","raw_url":"https://cdn.modrinth.com/data/CCxCashH/images/c123faed1d97125708264768d59d5d483d0f939e.jpeg","featured":false,"title":"One adult bee with two babies","description":null,"created":"2026-04-18T16:53:13.575502Z","ordering":0}],"color":2894892,"thread_id":"WxluyjUY","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.12","1.12.1","1.12.2","1.16.4","1.18.2","1.19","1.19.1","1.19.2","1.19.3","1.20","1.20.1","1.20.4","1.21","1.21.11","1.21.8"],"environment":["client_and_server"],"id":"vPS599gG","slug":"player-hopper","project_type":"mod","team":"8lWBRi7d","organization":null,"title":"Player Hopper","description":"A hopper that pulls items from a player\'s inventory","body":"# Player Hopper\\n![logo](https://github.com/MoreThanHidden/PlayerHopper/blob/master/src/main/resources/logo.png?raw=true)\\n\\nA hopper that pulls items from a player\'s inventory.\\n - Sneak click Items to add or remove from the Item Blacklist\\n - Sneak Right click to add or remove the Player from the Whitelist (Adds Placer by Default)\\n - Sneak + Left Click on the hopper with an empty hand to cycle the Inventory mode\\n\\n\\n![Image](https://user-images.githubusercontent.com/1351964/68994398-7ef44400-08bd-11ea-8630-25cf4cd798e7.gif)","body_url":null,"published":"2022-06-28T13:06:18.980936Z","updated":"2026-01-18T09:11:51.123088Z","approved":"2022-06-28T13:06:18.980936Z","queued":null,"status":"approved","requested_status":null,"moderator_message":null,"license":{"id":"LGPL-3.0-only","name":"GNU Lesser General Public License v3.0 only","url":null},"downloads":3416,"followers":17,"categories":["storage"],"additional_categories":[],"loaders":["fabric","forge","neoforge"],"versions":["hWWm8ZGt","3ml3iom1","rX1Kg4fv","vgxUosNw","YuDmHVQx","aLWpviOk","O9dIvmd1","mg4z2Hnb","J73jDy7s","215nrZqK","xuVBg8b5","t9eHGa63","fTTitxvi","fhvyCbhY","vB8WhoLg","d1S53mLb","U6Vj0PJT","61FKp7pY","TvD1NX6u"],"icon_url":"https://cdn.modrinth.com/data/vPS599gG/c2e38d19c3e170c170275bfe7d7cdd0efae8c887_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/vPS599gG/icon.png","issues_url":"https://github.com/MoreThanHidden/PlayerHopper/issues","source_url":"https://github.com/MoreThanHidden/PlayerHopper","wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[],"color":7960953,"thread_id":"vPS599gG","monetization_status":"monetized"},{"client_side":"required","server_side":"unsupported","game_versions":["1.16.5","1.17","1.17.1","1.18","1.18.1","1.18.2","1.19","1.19.1","1.19.2","1.19.3","1.19.4","1.20","1.20.1","1.20.2","1.20.3","1.20.4","1.20.5","1.20.6","1.21","1.21.1","1.21.2","1.21.3","1.21.4","1.21.5","1.21.6","1.21.7","1.21.8"],"environment":[],"id":"Dk77yddt","slug":"sweet-sweet-hud","project_type":"resourcepack","team":"kCTAzDjv","organization":null,"title":"Sweet sweet HUD!!","description":"A delicate overhaul of your HUD – hearts, hunger, XP, and hotbar turned into a seamless, elegant experience","body":"![logo](https://cdn.modrinth.com/data/cached_images/774c5d55debea0ff2045cf3e9c8d21ec3550578b.png)\\n***\\n### **Features:** <br>\\nHealth: Pastel-pink hearts, like cherry petals <br>\\nXP Bar: A flowing pastel rainbow <br>\\nHunger: Glimmering crystal stars in purple and green colors <br>\\nMount Health: A budding amethyst hearts <br>\\nHotbar & Menu Buttons: Subtle parchment backgrounds adorned with delicate amethyst accents.<br>\\nArmor: Iron chestplate with purple glow <br>\\n｡ ₊°༺❤︎༻°₊ ｡\\n***\\n### **How about full GUI? Try my extensions of this project:**\\n✦-๑┆ ![logo](https://cdn.modrinth.com/data/cached_images/bfc2191a03e40fe2b271a3da44c69b3277070cc2.png) [**LilacSweet GUI**](https://modrinth.com/resourcepack/lilacsweet-gui) ┆✦ʚ♡ɞ✦┆ ![logo](https://cdn.modrinth.com/data/cached_images/cd5d91f991a9421c71d9e0655902b262ec3f73e7.png) [**PinkSweet GUI**](https://modrinth.com/resourcepack/pinksweet-gui) ┆๑-✦‏\\n***\\n### **Support & Contact:**\\nLove this pack? Support me on [Boosty](https://boosty.to/reterica)!\\n<br>For any questions or suggestions, reach me out via my [Discord server](https://discord.gg/QsezmMbPQF)\\n","body_url":null,"published":"2025-08-30T18:23:45.755514Z","updated":"2025-10-25T13:43:43.241278Z","approved":"2025-08-30T23:36:47.808997Z","queued":"2025-08-30T19:23:16.651650Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":11918,"followers":74,"categories":[],"additional_categories":[],"loaders":["minecraft"],"versions":["rdGE6EjU","4qEX1CFA","m5Qxvg0j"],"icon_url":"https://cdn.modrinth.com/data/Dk77yddt/20f346e3b5927fc49b0bd05e70cc185b89106b16.png","raw_icon_url":"https://cdn.modrinth.com/data/Dk77yddt/20f346e3b5927fc49b0bd05e70cc185b89106b16.png","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/Dk77yddt/images/a888e9ce6952a0f1fa1e30e7af20ba95d7ac1819.png","raw_url":"https://cdn.modrinth.com/data/Dk77yddt/images/a888e9ce6952a0f1fa1e30e7af20ba95d7ac1819.png","featured":false,"title":"Menu","description":null,"created":"2025-08-30T19:21:21.612463Z","ordering":0},{"url":"https://cdn.modrinth.com/data/Dk77yddt/images/ada515be6ec79a6871a1e529d94eb8edb8ac0b7c_350.webp","raw_url":"https://cdn.modrinth.com/data/Dk77yddt/images/ada515be6ec79a6871a1e529d94eb8edb8ac0b7c.png","featured":true,"title":"All changes","description":"Every effect on health or hunger (+armor and hotbar)","created":"2025-08-30T19:22:19.230177Z","ordering":0}],"color":11110846,"thread_id":"oxgFqCPX","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.21","1.21.1"],"environment":["client_and_server"],"id":"hpvfbjys","slug":"cyra","project_type":"mod","team":"lrfkdGfk","organization":null,"title":"Cyra","description":"A Minecraft mod that reveals the secrets of the ocean!","body":"# BIG REWORK\\nThis mod is beeing reworked at the moment, updates will have a big delay until the next version will release!!\\n\\nCyra!\\nIn this mod, you are required to explore the depths of the ocean and discover its secrets!\\n## WARNING :\\n  This mod for now is not compatible with shaders and it will crash if you try!\\n  This mod is still in ALPHA, please report any bugs or crashes to the issue area!\\n  \\n\\n<iframe width=\\"560\\" height=\\"315\\" src=\\"https://www.youtube-nocookie.com/embed/FcK8WqkevgQ\\" title=\\"YouTube video player\\" frameborder=\\"0\\" allow=\\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\\" allowfullscreen></iframe>\\n\\n# **GETING STARTED**\\nTo enter this dimension you will need a new kind of portal made out of the Core of The Sea and surround it by certain blocks in a circle manner!\\n\\n### RECOMENDED MOD TO PLAY WITH\\n  JEI - for recipes\\n\\n\\nExample:\\n![Portal](https://cdn.modrinth.com/data/cached_images/81812c60d386cbf403643b2cddc952a298543dfd.png)\\n\\nBut the portal is very flexible with its choice of blocks!\\nThe list of every block you can use (and even in combinations)!\\n![Blocks for portal](https://cdn.modrinth.com/data/cached_images/6d5582a39f6b103b86a4786561c9bfd18b663ee0.png)\\n\\nThis dimension requires a gadget to enter and explore called a Depth Charm that has 3 tiers!\\n\\nIn this mod you have access to a big arsenal of weapons (Melee, Throwing and Magic) and armour!\\n![Armour](https://cdn.modrinth.com/data/cached_images/8b166ab075b8b8446f65c8ab1052c3ead3dfd1d1.png)\\n\\n\\n![Weapons And Gadgets](https://cdn.modrinth.com/data/cached_images/bf0579fc75a60935cadbc7df6b811a819e4c4169.png)\\n\\n### Credits for Sounds And Music In-Game\\nD low open string.wav\\nby Kyster -- https://freesound.org/s/117675/ -- License: Attribution 4.0\\n\\nkey.organ5_D3_plug.wav\\nby Freezeman -- https://freesound.org/s/150860/ -- License: Attribution 3.0\\n\\ndischrge.wav\\nby Sergenious -- https://freesound.org/s/55823/ -- License: Attribution 4.0\\n\\nPlasmaBlaster.wav\\nby BigDino1995 -- https://freesound.org/s/569901/ -- License: Creative Commons 0\\n\\nUnderwater Alarm.wav\\nby The_Runner_01 -- https://freesound.org/s/577745/ -- License: Creative Commons 0\\n\\nMONSTER SOUND.wav\\nby F1L1H -- https://freesound.org/s/550257/ -- License: Creative Commons 0\\n\\nSoundflakes - Horizon of the Unknown.mp3\\nby SoundFlakes -- https://freesound.org/s/592086/ -- License: Attribution 4.0\\n\\nHardcore boom 2.mp3 by\\njobro -- https://freesound.org/s/41165/ -- License: Attribution 3.0\\n\\nrpgPowerup.wav by\\ncolorsCrimsonTears -- https://freesound.org/s/577965/ -- License: Creative Commons 0\\n\\n<details>\\n<summary>Spoiler</summary>\\n\\n### CHEAT SHEAT AREA \\n  So if you\'re here it means that you\'re stuck in progression, well that\'s why this part exists\\n\\n  Charms:\\n-     Tier 1: 300 - 200 y level (Where you find Sea Crystal)\\n-     Tier 2: 200 - 100 y level (Where you find Normal Pyrite)\\n-     Tier 3: 100 - 0   y level and Void Biome exploration (Where you find more pyrite and ancient Pyrite only in the void)\\n\\n    Void: Be careful of the monsters that live down there and when mining void blocks try to\\n    be alert for a specific sound that has a random chance to occur. When you hear that don\'t \\n    mine any blocks for 4-5 seconds!\\n\\n    Void exploration guide :\\n-       Full Sea Crystal Armour for infinite Dolphins grace !\\n-       Sea Lantern for vision (Night vision doesn\'t work down there hehe)!\\n-       Buff Flask And Healing flask!\\n\\n  Skeleton Leader attacks:\\n  - He makes a sound and spawns particles where he will teleport and shoot an arrow from\\n \\n   \\n  Old Lord :\\n  - Combo attack can be parried by Swords, Axes, and Scythes (Hoe) made of Pyrite!\\n  - Fist levitation attack can be dodged with Pyrite Bulwark  \\n\\n    \\n\\n    \\n\\n</details>\\n\\n\\n","body_url":null,"published":"2025-01-28T22:02:41.319358Z","updated":"2025-07-31T22:06:41.685507Z","approved":"2025-01-31T05:35:18.363450Z","queued":"2025-01-29T10:21:23.025635Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"MIT","name":"MIT License","url":null},"downloads":3697,"followers":84,"categories":["adventure","equipment","magic"],"additional_categories":["game-mechanics","mobs","worldgen"],"loaders":["fabric"],"versions":["Tee6zmd8","b2KA6lbZ","Szq3FJZh","Xmu0Wn5I","U6EZmvEk","ZQTAVvM0","MvPC8AWG","vvlhFrbp","aajeexiX","H2HUXogy","daTrZFF9","qHwBCuLF","BdH0X2bR","3UvKzX2A"],"icon_url":"https://cdn.modrinth.com/data/hpvfbjys/32823edc36c82d9a730041e8d8f407648025825a_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/hpvfbjys/32823edc36c82d9a730041e8d8f407648025825a.png","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/hpvfbjys/images/8bfde5493938bfb92977652bb6f80fcfcbe87899_350.webp","raw_url":"https://cdn.modrinth.com/data/hpvfbjys/images/8bfde5493938bfb92977652bb6f80fcfcbe87899.png","featured":false,"title":"Dazed Waters","description":"Dazed Waters","created":"2025-01-29T10:09:57.706133Z","ordering":0},{"url":"https://cdn.modrinth.com/data/hpvfbjys/images/ffd7cf581db421030b2f71cf6cb943d8ab94955b_350.webp","raw_url":"https://cdn.modrinth.com/data/hpvfbjys/images/ffd7cf581db421030b2f71cf6cb943d8ab94955b.png","featured":false,"title":"Forgery","description":"Forgery","created":"2025-01-29T10:11:21.354037Z","ordering":0},{"url":"https://cdn.modrinth.com/data/hpvfbjys/images/1ddd69ef5b87825c17f2f1dd2f5064f01a287ef0_350.webp","raw_url":"https://cdn.modrinth.com/data/hpvfbjys/images/1ddd69ef5b87825c17f2f1dd2f5064f01a287ef0.png","featured":false,"title":"Old Lord Arena","description":"Old Lord Arena","created":"2025-01-29T10:12:46.478405Z","ordering":0},{"url":"https://cdn.modrinth.com/data/hpvfbjys/images/bd8e1ac20b16059232db3e4502ff92b753faee50_350.webp","raw_url":"https://cdn.modrinth.com/data/hpvfbjys/images/bd8e1ac20b16059232db3e4502ff92b753faee50.png","featured":true,"title":"Void with lantern","description":"void","created":"2025-01-29T10:14:06.438094Z","ordering":0}],"color":16316601,"thread_id":"pNSmhhLx","monetization_status":"monetized"},{"client_side":"required","server_side":"unsupported","game_versions":["26.1","26.1-pre-1","26.1-pre-2","26.1-pre-3","26.1-rc-1","26.1-rc-2","26.1-rc-3","26.1-snapshot-10","26.1-snapshot-11","26.1-snapshot-2","26.1-snapshot-3","26.1-snapshot-4","26.1-snapshot-5","26.1-snapshot-6","26.1-snapshot-7","26.1-snapshot-8","26.1-snapshot-9","26.1.1","26.1.1-rc-1","26.1.2","26.1.2-rc-1","26.2-pre-1","26.2-pre-2","26.2-pre-3","26.2-pre-4","26.2-pre-5","26.2-pre-6","26.2-rc-1","26.2-snapshot-1","26.2-snapshot-2","26.2-snapshot-3","26.2-snapshot-4","26.2-snapshot-5","26.2-snapshot-6","26.2-snapshot-7","26.2-snapshot-8","26w14a"],"environment":[],"id":"8Vz2SD37","slug":"fey-flower-netherite","project_type":"resourcepack","team":"FlCCig30","organization":null,"title":"🌺 Fey Flower Netherite Tools 🌺","description":"A resoucepack that changes netherite tools to be visually belonging to a forest nymph.","body":"# Netherite Tools -> 🌺 Fey Flower Tools 🌺\\n\\nA Minecraft resourcepack to make your netherite tools look like they came right from the fey wilds!\\n\\nFor all your cottage-core forest-nymph dreams!\\n\\n### Description;\\n\\nA resourcepack that changes netherite tools to be visually belonging to a forest nymph\\n![Textures](https://cdn.modrinth.com/data/cached_images/bb0727eb4be020ee4ae3b4e2a87469687eb26f45.png)\\n\\n\\n### Information;\\n\\n**Dependencies**-\\n\\nNo hard mod requirements.\\n\\nNo soft mod requirements.\\n\\n\\n**Version**-\\n\\nRevision 0 - Minecraft 26.1+\\n\\nMy packs are default released for latest version of Minecraft- if you want it ported to a newer or older version let me know. _(*Done at my discretion. Some things may be too difficult to port.)_\\n\\n[Click me for an installation guide.](https://docs.google.com/document/d/1hr4GxSt715MKrzwaX2nKfXQi1lZKpyVeqiPu7Cff1gY/edit?tab=t.vir32f1uv16f)\\n\\n[Click me for frequently asked questions and answers.](https://docs.google.com/document/d/1hr4GxSt715MKrzwaX2nKfXQi1lZKpyVeqiPu7Cff1gY/edit?tab=t.ad4b98rdtpo2)\\n\\n\\n### Licensing\\n\\nTLDR:\\nPersonal use, yes!\\nFree modpacks, go for it!\\nMonetized videos/streams where this work is being used recreationally, perfectly cool!\\nOutright resale or redistrubtion, no!\\n\\n[For detailed legalities information, please click me.](https://docs.google.com/document/d/1hr4GxSt715MKrzwaX2nKfXQi1lZKpyVeqiPu7Cff1gY/edit?tab=t.0)\\n\\nAnywhere this work is shown it would be greatly appreciated to credit me by slapping the following line anywhere visibile.\\n\\n```\\nFeaturing assets by https://linktr.ee/pastelpetalpaints\\n```\\nThe more reach I have, the more time I have to make fun, silly and cute stuff. 🩷\\n\\n### Credits;\\n\\nMe 🩷\\nhttps://linktr.ee/pastelpetalpaints\\n\\n![Logo](https://cdn.modrinth.com/data/cached_images/149acfe8ea82a2bce39e253e7312a9d0760ab519.png)","body_url":null,"published":"2026-06-11T17:08:45.497262Z","updated":"2026-06-11T17:13:43.899636Z","approved":"2026-06-14T23:31:04.000101Z","queued":"2026-06-11T17:23:03.967794Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":326,"followers":9,"categories":["themed","tweaks","vanilla-like"],"additional_categories":["16x","equipment","items","simplistic"],"loaders":["minecraft"],"versions":["VAfzZKfO"],"icon_url":"https://cdn.modrinth.com/data/8Vz2SD37/3e9816e666006c7f5125c6c28b9ae629631506c2.png","raw_icon_url":"https://cdn.modrinth.com/data/8Vz2SD37/3e9816e666006c7f5125c6c28b9ae629631506c2.png","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[{"id":"ko-fi","platform":"Ko-fi","url":"https://ko-fi.com/pastelpetalpaints"}],"gallery":[{"url":"https://cdn.modrinth.com/data/8Vz2SD37/images/bb0727eb4be020ee4ae3b4e2a87469687eb26f45_350.webp","raw_url":"https://cdn.modrinth.com/data/8Vz2SD37/images/bb0727eb4be020ee4ae3b4e2a87469687eb26f45.png","featured":true,"title":"All tools","description":null,"created":"2026-06-11T17:19:47.087009Z","ordering":0},{"url":"https://cdn.modrinth.com/data/8Vz2SD37/images/b2fea39ca61ca792d331039962cba7af0ece6345.png","raw_url":"https://cdn.modrinth.com/data/8Vz2SD37/images/b2fea39ca61ca792d331039962cba7af0ece6345.png","featured":false,"title":"Sword","description":null,"created":"2026-06-11T17:19:59.673141Z","ordering":1},{"url":"https://cdn.modrinth.com/data/8Vz2SD37/images/9feca00bcdf79710d3e7357509a509a5110eb586.png","raw_url":"https://cdn.modrinth.com/data/8Vz2SD37/images/9feca00bcdf79710d3e7357509a509a5110eb586.png","featured":false,"title":"Spear","description":null,"created":"2026-06-11T17:20:09.098171Z","ordering":2},{"url":"https://cdn.modrinth.com/data/8Vz2SD37/images/6d5ab47e368d6afd9a859cb72408d0adff4951c6.png","raw_url":"https://cdn.modrinth.com/data/8Vz2SD37/images/6d5ab47e368d6afd9a859cb72408d0adff4951c6.png","featured":false,"title":"Pickaxe","description":null,"created":"2026-06-11T17:20:17.847856Z","ordering":3},{"url":"https://cdn.modrinth.com/data/8Vz2SD37/images/a71bdf667cce3919a340f89077d5e28663aa47ea.png","raw_url":"https://cdn.modrinth.com/data/8Vz2SD37/images/a71bdf667cce3919a340f89077d5e28663aa47ea.png","featured":false,"title":"Axe","description":null,"created":"2026-06-11T17:21:09.878052Z","ordering":4},{"url":"https://cdn.modrinth.com/data/8Vz2SD37/images/751e40d2bdbdbd5c88814df976d6ed5ca580980f.png","raw_url":"https://cdn.modrinth.com/data/8Vz2SD37/images/751e40d2bdbdbd5c88814df976d6ed5ca580980f.png","featured":false,"title":"Shovel","description":null,"created":"2026-06-11T17:21:17.756497Z","ordering":5},{"url":"https://cdn.modrinth.com/data/8Vz2SD37/images/cb409fe472428a477b620c83b7526b0f9f1f5b7a.png","raw_url":"https://cdn.modrinth.com/data/8Vz2SD37/images/cb409fe472428a477b620c83b7526b0f9f1f5b7a.png","featured":false,"title":"Hoe","description":null,"created":"2026-06-11T17:21:27.410124Z","ordering":6}],"color":593160,"thread_id":"lxvZfhTo","monetization_status":"monetized"},{"client_side":"required","server_side":"unsupported","game_versions":["1.15","1.15.1","1.15.2","1.16","1.16.1","1.16.2","1.16.3","1.16.4","1.16.5","1.17","1.17.1","1.18","1.18.1","1.18.2","1.19","1.19.1","1.19.2","1.19.3","1.19.4","1.20","1.20.1","1.20.2","1.20.2-pre1","1.20.3","1.20.4","1.20.5","1.20.5-pre1","1.20.5-pre2","1.20.5-pre3","1.20.6","1.21","1.21.1","1.21.10","1.21.11","1.21.2","1.21.2-pre1","1.21.2-pre2","1.21.3","1.21.4","1.21.5","1.21.6","1.21.7","1.21.8","1.21.9","20w14infinite","22w13oneblockatatime","22w42a","22w43a","22w44a","23w13a_or_b","23w14a","23w16a","23w31a","23w32a","23w33a","23w35a","23w42a","23w43a","23w43b","23w44a","23w45a","23w46a","24w03a","24w03b","24w04a","24w05a","24w05b","24w06a","24w07a","24w09a","24w10a","24w11a","24w12a","24w13a","24w14a","24w14potato","24w18a","24w19a","24w19b","24w20a","24w33a","24w34a","24w35a","24w36a","24w37a","24w38a","24w39a","24w40a","24w44a","24w45a","24w46a","25w14craftmine","26.1"],"environment":[],"id":"VoPLAAlB","slug":"everybody-loves-bees","project_type":"resourcepack","team":"6a53EOCQ","organization":"NGq4CQCR","title":"Everybody Loves: Bees","description":"Because everybody loves, and everybody loves bees!","body":"![A series of Minecraft bees carrying pride flags while looking to the right.](https://cdn.modrinth.com/data/VoPLAAlB/images/3477b4b032a9a331c51c70a91557816b107888d4.png)\\n\\n# Everybody Loves: Bees\\nThis Pride Month, we wanted to contribute to the growing pool of pride-themed packs, but we wanted to put our own spin on things.  \\nSure, changing bee stripes is a natural way to incorporate pride into these flying insects\' designs, but we wanted something that could easily translate into being used with other resource packs as well.  So instead, your buzzing besties are carrying around various flags determined by entity name!\\n\\n## Everybody Loves  \\nIf you\'re missing out on colorful homes for your flag-carrying bees, check out the companion project [Everybody Loves: Hives](https://modrinth.com/resourcepack/everybody-loves-hives), and keep your eye on the [Everybody Loves collection](https://modrinth.com/collection/zi1cybwo)!\\n\\n## How it works\\nThanks to the power of [EMF](https://modrinth.com/mod/entity-model-features), we\'re able to add on to the Bee\'s model in a way that won\'t affect normal gameplay, vanilla users, or other resource packs!   \\n\\nThis pack is easy to modify, add on to, or integrate with other resource packs, like we\'ve done with Modern Mizuno\'s.  \\nYou\'re more than welcome to make an addon or integrate this with your own resource pack, just be sure to provide credit in your project\'s Description.\\n\\n<center>\\n\\n![A series of pride flag carrying bees from the resource packs Ashen, Bare Bones, and Modern Mizuno\'s](https://cdn.modrinth.com/data/VoPLAAlB/images/054dad217d60adf2d542da00f5dff8690652cc86.png)  \\n*Pride flag carrying bees from [Ashen](https://modrinth.com/resourcepack/ashen), [Bare Bones](https://modrinth.com/resourcepack/bare-bones), and [Modern Mizuno\'s](https://modrinth.com/resourcepack/modern-mizunos)*\\n\\n</center>\\n\\n\\n\\nTo add a flag to a bee, simply rename it with a name including one of these phrases:\\n\\n<details>\\n<summary>Names</summary>\\n\\n- ace\\n- agender\\n- aro\\n- bisexual\\n- demi\\n- gay\\n- genderfluid\\n- genderqueer\\n- intersex\\n- lesbian\\n- nonbinary\\n- pan\\n- poly\\n- pride\\n- progress\\n- trans\\n\\n</details>\\n\\n\\n\\n## Support your community\\nMinecraft is **everybody\'s game**, and this community has been a meaningful and accepting place for us and many others. If you love our content or any of the other amazing creations this scene has produced, then know that it would not be here if it were not for those who work hard to make it an accepting and loving place.  \\n\\nIf you\'re reading this while it\'s still the month of June and are looking for a way to help make a difference, we encourage you to join us and the broader Minecraft community by supporting queer individuals in need. Optionally, through the Modrinth fundraiser at **https://modrinth.com/pride**.\\n\\n<center>\\n\\n[![modrinth](https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3/assets/cozy-minimal/available/modrinth_vector.svg)](https://modrinth.com/user/coolbot100s)\\n[![curseforge](https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3/assets/cozy-minimal/available/curseforge_vector.svg)](https://www.curseforge.com/members/coolbot100s/projects)\\n[![Planet Minecraft](https://github.com/coolbot100s/Bouncy-Leaves/assets/76798835/0b2c0293-c2ab-4956-9055-70bc7d7141c5)](https://www.planetminecraft.com/collection/146032/all-garden-gals-content/)\\n[![discord](https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3/assets/cozy-minimal/social/discord-singular_vector.svg)](https://discord.gg/qxRVkGDjdJ) \\n[![github](https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3/assets/cozy-minimal/available/github_vector.svg)](https://github.com/coolbot100s) \\n[![Support us](https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3/assets/cozy-minimal/donate/generic-singular_vector.svg)](https://github.com/sponsors/coolbot100s)\\n\\n\\n</center>\\n\\n![A series of Minecraft bees carrying pride flags while looking to the left.](https://cdn.modrinth.com/data/VoPLAAlB/images/ed0416ea745d56577c6ed231f3803bf16875dafd.png)\\n\\n","body_url":null,"published":"2025-06-07T00:46:04.814309Z","updated":"2026-03-26T00:02:31.183329Z","approved":"2025-06-23T01:03:33.648971Z","queued":"2025-06-23T00:23:31.114631Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"CC-BY-4.0","name":"Creative Commons Attribution 4.0 International","url":null},"downloads":1355,"followers":35,"categories":["decoration","entities","models"],"additional_categories":["16x","themed","tweaks","vanilla-like"],"loaders":["minecraft"],"versions":["QvdgxdA4","66gwyDsk"],"icon_url":"https://cdn.modrinth.com/data/VoPLAAlB/cecd77e1dfea578fdd7399721a4772aa4be39e53.gif","raw_icon_url":"https://cdn.modrinth.com/data/VoPLAAlB/cecd77e1dfea578fdd7399721a4772aa4be39e53.gif","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":"https://discord.gg/qxRVkGDjdJ","donation_urls":[{"id":"github","platform":"Github","url":"https://github.com/sponsors/coolbot100s"}],"gallery":[{"url":"https://cdn.modrinth.com/data/VoPLAAlB/images/e262351f25853a189c41996fb6ef8a79f5c379ca.gif","raw_url":"https://cdn.modrinth.com/data/VoPLAAlB/images/e262351f25853a189c41996fb6ef8a79f5c379ca.gif","featured":false,"title":"Every Body Loves: Bees Icon","description":"A gif showing bees cycling through various pride flags.","created":"2025-06-22T23:59:14.777032Z","ordering":-1},{"url":"https://cdn.modrinth.com/data/VoPLAAlB/images/054dad217d60adf2d542da00f5dff8690652cc86.png","raw_url":"https://cdn.modrinth.com/data/VoPLAAlB/images/054dad217d60adf2d542da00f5dff8690652cc86.png","featured":false,"title":"Resource pack compatibility","description":"A series of pride flag carrying bees from the resource packs Ashen, Bare Bones, and Modern Mizuno\'s","created":"2025-06-22T23:59:00.473629Z","ordering":0},{"url":"https://cdn.modrinth.com/data/VoPLAAlB/images/3477b4b032a9a331c51c70a91557816b107888d4.png","raw_url":"https://cdn.modrinth.com/data/VoPLAAlB/images/3477b4b032a9a331c51c70a91557816b107888d4.png","featured":true,"title":"Bees goin\' right","description":"A series of Minecraft bees carrying pride flags while looking to the right.","created":"2025-06-22T23:27:10.138601Z","ordering":1},{"url":"https://cdn.modrinth.com/data/VoPLAAlB/images/ed0416ea745d56577c6ed231f3803bf16875dafd.png","raw_url":"https://cdn.modrinth.com/data/VoPLAAlB/images/ed0416ea745d56577c6ed231f3803bf16875dafd.png","featured":false,"title":"Bees goin\' left","description":"A series of Minecraft bees carrying pride flags while looking to the left.","created":"2025-06-22T23:27:19.874230Z","ordering":2}],"color":3683620,"thread_id":"S0hjCXSI","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.20.1"],"environment":["client_and_server"],"id":"c9JOBXgR","slug":"alter-ego","project_type":"mod","team":"L5gk9zSd","organization":null,"title":"Alter Ego","description":"Alter Ego is a mod that lets you set separate profiles in Minecraft, each with its own inventory, gamemode, skin, cape, nickname, and spawn point, with Trinkets and Origins support.","body":"# Alter Ego\\n\\n**Alter Ego allows you to have separate inventories, gamemodes, advancements, skins, capes, server nicknames, set your spawn, With Profiles!** Make any item including modded ones invisible for roleplay to keep immersion, teleport to any dimension at anytime instantly with coordinates and adding lootable gravestones to the [Gravestones Mod by Pneumono](https://modrinth.com/mod/pneumono_gravestones), This mod is for **Roleplay** but you can use it simply for the skins and capes feature.\\n\\n---\\n\\n## Disclaimer :\\n\\nThis mod requires **Styled Nicknames by Patbox** for the nicknames functionality.\\n\\n- Skins and Capes are done locally, so you\'ll need to add your own skins and capes in the `aeskins` folder. It\'s in your main Minecraft version/Modrinth profile folder.\\n- Capes must be in the correct **64x32** otherwise the mod won\'t accept it.\\n- Skins must be **64x64 or 64x32**.\\n- This mod supports **Trinkets** and **Origins**, so you can carry trinkets and assign different origins to each profile you make.\\n\\n---\\n\\n## Profiles :\\n\\nMore on profiles themselves: you start with a default profile, which would be your normal Minecraft Game Profile. I suggest making a new profile instead of using the default one.\\n\\nAll profiles are editable and can be changed at anytime in anyway. Profile Names are case sensitive, so be careful when making a new profile `[ /inv profile name ]`\\n\\nYou can see your current profiles and what profile you\'re on by using `/inv` \\n\\nMore information in-game under the mods tab!","body_url":null,"published":"2026-06-06T15:39:24.614952Z","updated":"2026-06-23T20:27:48.555177Z","approved":"2026-06-09T06:30:12.676600Z","queued":"2026-06-06T19:04:20.835135Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-ARR","name":"","url":"https://pastebin.com/jgugsRvY"},"downloads":415,"followers":6,"categories":["management","social","utility"],"additional_categories":[],"loaders":["fabric"],"versions":["tN83BbfM","BMb6auKo","XOV2al16","n78R7fsO","LYU96WIC","hbH3gDzE","dwYYp0aS","IPrkuvWE","mpsOER3N"],"icon_url":"https://cdn.modrinth.com/data/c9JOBXgR/9907158c6af95e72398d341e003da99507b8010f_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/c9JOBXgR/9907158c6af95e72398d341e003da99507b8010f.png","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[{"id":"other","platform":"Other","url":"https://skiier.co/pages/donate"}],"gallery":[{"url":"https://cdn.modrinth.com/data/c9JOBXgR/images/cce25ca7edc9e847af5abced081ffc4d43d0e2c3_350.webp","raw_url":"https://cdn.modrinth.com/data/c9JOBXgR/images/cce25ca7edc9e847af5abced081ffc4d43d0e2c3.png","featured":true,"title":"Main Alter Ego Showcase","description":null,"created":"2026-06-06T18:30:54.399577Z","ordering":0},{"url":"https://cdn.modrinth.com/data/c9JOBXgR/images/32afc8b4a725c30b560e220d9845011160688a65.gif","raw_url":"https://cdn.modrinth.com/data/c9JOBXgR/images/32afc8b4a725c30b560e220d9845011160688a65.gif","featured":false,"title":"Live Showcase","description":null,"created":"2026-06-06T18:55:57.557848Z","ordering":0},{"url":"https://cdn.modrinth.com/data/c9JOBXgR/images/f88d58cc396982ec79282f7393abd5f98e005aa4.png","raw_url":"https://cdn.modrinth.com/data/c9JOBXgR/images/f88d58cc396982ec79282f7393abd5f98e005aa4.png","featured":false,"title":"Thanks to Styled Nicknames by Patbox","description":null,"created":"2026-06-06T19:04:07.580292Z","ordering":0}],"color":4606801,"thread_id":"WF2eV7Hn","monetization_status":"monetized"},{"client_side":"unsupported","server_side":"required","game_versions":["1.15.1","1.15.2","1.16.5","1.17.1","1.18.2","1.19.4","1.20.1","1.20.6","1.21","1.21.1","1.21.10","1.21.11","1.21.5","1.21.9","26.1","26.1.2","26.2","26.3"],"environment":[],"id":"G81C0iBX","slug":"egghunt-and-geocaching","project_type":"mod","team":"vp9at3cC","organization":null,"title":"Halloween & Geocaching","description":"An interactive Halloween, EggHunt, Christmas & Geocaching all-in-one plugin that brings exciting treasure hunting to your server. Easily switch between Easter, Halloween, and Christmas themes to match the season!","body":"# 🎃 Halloween, Christmas, EggHunt & MCGeocaching 🗺️\\n\\nBring an immersive and interactive treasure-hunting experience to your Minecraft server! This plugin combines a highly customizable **Seasonal EggHunt/Treasure Hunt** with a realistic **Geocaching** system. \\n\\nWhether you want players hunting for Easter Eggs, **Halloween Pumpkins**, or Christmas Presents, or navigating the wilderness with a metal-detector-like compass to find hidden Geocaches, this plugin has it all!\\n\\n**Plugin folder:** `McGeocaching` (inside your server\'s `plugins` directory).\\n\\n**Main command:** `/egghunt` (universal for halloween, christmas and easter) and `/geocaching` for geocaching.\\n\\n---\\n\\n## Showcase\\n> Modrinth does not allow gifs over 5MB or WebM format, so here are some links:\\n\\n#### [Showcase1](https://i.xap3y.eu/Z0PFW5VF) | [Showcase2](https://i.xap3y.eu/S52Q5MVZ) | [Showcase3](https://i.xap3y.eu/CE4M284B) | [Showcase4](https://i.xap3y.eu/E6WFT1Z7) | [Showcase5](https://i.xap3y.eu/MB0W0KLD)\\n\\nDont forget to check [Gallery page](https://modrinth.com/plugin/egghunt-and-geocaching/gallery) as well!\\n\\n---\\n\\n## 🥚 The EggHunt System (Seasonal Treasure Hunts)\\nThe EggHunt feature is the core of the plugin, designed to keep your players engaged all year round. It is fully adaptable to different seasons: **Easter, Halloween, and Christmas**.\\n\\n### ✨ Features\\n*   **Categories & Rarity:** You can group hidden items (eggs, gifts, pumpkins) into custom categories using `storage.yml`. Each category can have its own distinct set of textures, specific rewards, and animations. This allows you to create common, rare, and legendary treasures!\\n*   **185 Halloween Effects:** The plugin includes 185 unique Halloween particle effects and animations, from spooky wisps and pumpkin spirals to spectacular supernatural rituals. Seasonal animations are also available for Easter and Christmas.\\n*   **Random Spawns (Drop Events):** Enable random spawns to periodically drop a treasure somewhere in the world (e.g., every hour). The plugin announces the hunt in chat and can even provide a direct **BlueMap** link pointing to the general area where the treasure is hidden!\\n*   **Stats & GUI:** Players can track their progress through a beautiful, customizable GUI to see how many treasures they\'ve found in different regions/worlds.\\n*   **Completion Rewards:** Grant special global or random rewards to players who manage to find *every single* hidden item on the server.\\n\\n---\\n\\n## 🗺️ MCGeocaching\\nA true-to-life replica of real-world Geocaching, seamlessly integrated into Minecraft.\\n\\n### ✨ Features\\n*   **Interactive Navigation:** Players use a compass that acts like a metal detector—it **beeps faster** and updates a **bossbar** the closer they get to the hidden cache.\\n*   **BlueMap Integration:** Caches can be displayed on your BlueMap with custom real-world Geocaching icons.\\n*   **Logbooks:** Just like real geocaching, players can sign a virtual logbook when they discover a cache.\\n*   **Customizable Difficulty:** Want a harder challenge? You can hide caches completely from the map, disable the compass tracking, or turn off the proximity beep!\\n\\n---\\n\\n## ⌨️ Commands\\n\\n### 🥚 EggHunt Commands\\n```text\\n/egghunt gui                       - Opens the interactive GUI.\\n/egghunt stats                     - View your personal hunting stats.\\n/egghunt locadder                  - Tool for adding random spawn locations.\\n/egghunt reload                    - Reloads the plugin configuration.\\n/egghunt texture-browse [search]   - Open texture browser (HeadDB plugin required).\\n```\\n\\n### 🗺️ Geocaching Commands\\n```text\\n/geocaching                          - Opens the main Geocaches GUI.\\n\\n/geocaching create <name> [options]  - Creates a new geocache.\\n  Options:\\n    -p, --preset      Create cache based on a preset from config.\\n    --hidden          Hides the cache completely.\\n    --no-compass      Disables compass tracking for this cache.\\n    --no-bossbar      Disables the proximity bossbar.\\n    --no-beep         Disables the proximity sound effect.\\n    --no-map          Hides the cache from BlueMap.\\n    --no-logbook      Disables the logbook feature.\\n\\n/geocaching modify <name> [options]  - Edits an existing geocache.\\n  Options:\\n    --location        Updates the cache to your current location.\\n    --beep=true/false\\n    --compass=true/false\\n    --bossbar=true/false\\n    --map=true/false\\n    --delete          Deletes the cache.\\n\\n/geocaching delete <name>            - Deletes a specific geocache.\\n```\\n\\n---\\n\\n## 🛠️ Configuration & Customization\\nThis plugin is built with server owners in mind. **Everything** is configurable:\\n*   **`config.yml`:** Toggle features, set up BlueMap links, configure the random spawn event timers, and adjust the stats GUI.\\n*   **`storage.yml`:** Define your custom treasure categories. Assign specific Base64 textures, commands to run on discovery, and which animation to play. Hundreds of pre-configured Base64 heads are supported out of the box!\\n*   **`locale.yml`:** 100% rich text translation support. Every single prefix, broadcast, and menu name can be customized to fit your server\'s language and style.\\n\\n---\\n\\n### Feature request\\n\\nCreate an issue using the issue tracker link and briefly describe what would you like to add\\n\\n---\\n\\n### Default files\\n\\n<details>\\n  <summary>Locale.yml</summary>\\n  \\n```yaml\\n# EggHunt Localization File\\n\\n# ========== ENGLISH TRANSLATIONS DEFAULT ==========\\nen:\\n  commands:\\n    running_version: \\"&fRunning McGeocaching v&f{version}\\"\\n    reload:\\n      success: \\"&aEggHunt was reloaded\\"\\n      reloading: \\"&fReloading EggHunt...\\"\\n      looper_reloaded: \\"&fLooper reloaded\\"\\n      looper_stop: \\"&fLooper stop\\"\\n      pulsed: \\"&aPulsed &f{count} &alocations.\\"\\n      particles_stopped: \\"&aAll particles were stopped.\\"\\n      particles_started: \\"&aAll particles were started.\\"\\n      egg_added: \\"&aAdded egg to player &f{name} &aat location &f{location}\\"\\n      backup_creating: \\"&7Creating backup...\\"\\n      backup_success: \\"&aBackup was successfully created.\\"\\n      backup_failed: \\"&cBackup failed.\\"\\n      location_adding_mode_disabled: \\"&cLocation adding mode disabled.\\"\\n      statistics_disabled: \\"&cStatistics are disabled.\\"\\n      player_not_found: \\"&cPlayer not found.\\"\\n\\n    general:\\n      adding_mode_enabled: \\"&aLocation adding mode enabled. Place a block where you want to add a spawn location for egg/gift/pumpkin.\\"\\n      only_players: \\"&cOnly players can use this command.\\"\\n      only_players_location_flag: \\"&cOnly players can use the &f--location &cflag.\\"\\n\\n    geocaching:\\n      reload:\\n        success: \\"&aGeocaching was reloaded\\"\\n        reloading: \\"&fReloading Geocaching...\\"\\n      create:\\n        success: \\"&aGeocaching with name &f{name} &awas created\\"\\n        error: \\"&cError creating cache &f{error}\\"\\n        usage: \\"&cWrong usage! &7/geocaching create <name>\\"\\n      delete:\\n        success: \\"&aGeocaching &f{name} &awas deleted\\"\\n        error: \\"&cError deleting cache &f{error}\\"\\n        usage: \\"&cWrong usage! &7/geocaching delete <name>\\"\\n      modify:\\n        success: \\"&aChanges were saved &f{name}\\"\\n        error: \\"&cError saving changes &f{error}\\"\\n        usage: \\"&cWrong usage! &7/geocaching modify <name> <flags>\\"\\n      not_exists: \\"&cGeocaching with this name does not exist\\"\\n      preset_not_found: \\"&cPreset &e{preset} &cnot found!\\"\\n\\n  block_interactions:\\n    egg_set: \\"&aEgg set! &7(&f{count}&7)\\"\\n    egg_removed: \\"&aEgg removed! &7(&f{count}&7)\\"\\n    egg_removed_success: \\"&aSuccessfully removed the location from random spawns!\\"\\n    egg_added_success: \\"&aSuccessfully added the location to random spawns!\\"\\n    cache_location_set: \\"&aSuccessfully set the location for the cache! &7(&f{cache_name}&7)\\"\\n    cache_not_exists: \\"&cSomething went wrong, this cache does not exist!\\"\\n    error_occurred: \\"&cSomething went wrong! &f{error}\\"\\n    hold_shift_to_remove_cache: \\"&cHold shift to remove the cache!\\"\\n    hold_shift_to_remove_egg: \\"&cHold shift to remove the egg!\\"\\n    hold_shift_to_set_egg: \\"&cHold shift to set the egg!\\"\\n    egg_not_exists: \\"&cThis egg does not exist!\\"\\n    egg_removed_with_count: \\"&cEgg removed!\\"\\n\\n  player_interactions:\\n    egg_found: \\"&aEgg found\\"\\n    christmas_gift_found: \\"&aChristmas gift found!\\"\\n    pumpkin_found: \\"&aPumpkin found!\\"\\n    item_found: \\"&aItem found!\\"\\n    generic_error: \\"&cSomething went wrong!\\"\\n    gui_disabled: \\"&c{gui_name} &cis disabled!\\"\\n    click_to_view_progress: \\"&eClick to view progress\\"\\n    already_found_christmas: \\"&cYou already found this Christmas gift!\\"\\n    already_found_pumpkin: \\"&cYou already found this pumpkin!\\"\\n    already_found_egg: \\"&cYou already found this egg!\\"\\n    already_found_item: \\"&cYou already found this item!\\"\\n\\n  gui:\\n    buttons:\\n      close: \\"&cClose\\"\\n      back: \\"&cBack\\"\\n      reload: \\"&c&lReload\\"\\n      remove_all: \\"&cRemove All\\"\\n      next_page: \\"&6Next Page\\"\\n      previous_page: \\"&6Previous Page\\"\\n    \\n    titles:\\n      placed_eggs: \\"&3&lPlaced Eggs\\"\\n      geocaching: \\"&bGeocaching\\"\\n      treasure_library: \\"&9Treasure Library\\"\\n      main: \\"&a&lMcGeocaching\\"\\n      main_geocaching: \\"&bGeocaching\\"\\n      missing_eggs: \\"&6Missing Eggs\\"\\n      geocaching_textures: \\"&6&lGeocaching - Textures\\"\\n      egg_view: \\"&e&lEgg View\\"\\n      cache_description: \\"&6&lCache Description\\"\\n      logbook: \\"&9&lLogBook\\"\\n    \\n    statuses:\\n      enabled: \\"&aEnabled\\"\\n      disabled: \\"&cDisabled\\"\\n      no_textures: \\"&cThis egg has no textures\\"\\n      not_set: \\"&cNot set\\"\\n      egg_hunt_disabled: \\"&cEgg Hunt is disabled\\"\\n      geocaching_enabled: \\"&bGeocaching &fis &aEnabled\\"\\n      geocaching_disabled: \\"&bGeocaching &fis &cDisabled\\"\\n      cannot_display: \\"&cCannot display\\"\\n      total_treasures: \\"&fTotal treasures on server: &e{count}\\"\\n    \\n    hints:\\n      click_to_view: \\"&eClick to view\\"\\n      click_to_toggle: \\"&eClick to toggle\\"\\n      click_to_open: \\"&7Click to open\\"\\n      click_to_remove_egg: \\"&7Click to remove egg\\"\\n      click_to_return: \\"&7Click to return\\"\\n      eggs_to_find: \\"&3➥ &fEggs to find: &e{count}\\"\\n      cache_name: \\"&3➥ &fCache name: &e{name}\\"\\n      description: \\"&3➥ &fDescription: &e{description}\\"\\n      random_reward: \\"&3➥ &fRandom reward: &e{status}\\"\\n      place_cache_on_ground: \\"&ePlace cache on ground\\"\\n      place_egg_on_ground: \\"&ePlace egg on ground\\"\\n      left_click_teleport: \\"&aLeft-Click to teleport to the treasure\\"\\n      left_click_teleport_egg: \\"&aLeft-Click to teleport to the egg\\"\\n      shift_left_click_found: \\"&9Shift + Left-Click to mark as found\\"\\n      shift_left_click_delete: \\"&cShift + Left-Click to delete\\"\\n      middle_click_teleport: \\"&eMiddle-Click to teleport\\"\\n      cache_created: \\"&3➥ &fCreated: &e{date}\\"\\n      cache_finds: \\"&3➥ &fFinds: &e{count}\\"\\n      cache_found_by_players: \\"&fThis cache was found by &e{count} &fplayers\\"\\n      click_to_select_texture: \\"&aClick to select texture\\"\\n      click_for_details: \\"&eClick for more details\\"\\n      world: \\"&3➥ &fWorld: &e{world}\\"\\n      location_x: \\"&3➥ &fX: &e{x}\\"\\n      location_y: \\"&3➥ &fY: &e{y}\\"\\n      location_z: \\"&3➥ &fZ: &e{z}\\"\\n      shift_left_click_instruction: \\"&4Shift + Left click\\"\\n      all_eggs_removed: \\"&cAll eggs have been removed\\"\\n      egg_added_to_player: \\"&aYou added a found egg to player {player}\\"\\n      selected_cache_texture: \\"&aYou successfully selected cache texture!\\"\\n      found_label: \\"&fFound:\\"\\n      other_worlds: \\"&eOther worlds\\"\\n      other_regions: \\"&eOther regions\\"\\n      season_label: \\"&fSeason:\\"\\n      is_label: \\"&fis\\"\\n      cache_logbook_title: \\"&6&lCache Logbook\\"\\n      placed_caches_title: \\"&3Placed Caches\\"\\n      cache_no_location: \\"&c&nThis cache has no location\\"\\n      click_to_set_location: \\"&eClick to set location\\"\\n      left_click_more_info: \\"&aLeft-Click for more info\\"\\n      right_click_edit: \\"&9Right-Click to edit cache\\"\\n      shift_left_click_delete_cache: \\"&cShift + Left-Click to delete cache\\"\\n      click_to_obtain: \\"&eClick to obtain\\"\\n      left_click_change: \\"&eLeft-Click to change &b✎\\"\\n      right_click_next: \\"&7Right-Click go to next &c⬇\\"\\n      shift_right_click_previous: \\"&7Shift + Right-Click go to previous &a⬆\\"\\n      shift_left_click_save: \\"&2Shift + Left-Click to save\\"\\n      world_label: \\"&3➥ &fWorld: &e{world}\\"\\n      xyz_label: \\"&3➥ &fX/Y/Z: &e{x}&f/&e{y}&f/&e{z}\\"\\n      bluemap_label: \\"&3➥ &fBlueMap: &r{status}\\"\\n      compass_label: \\"&3➥ &fCompass: &r{status}\\"\\n      bossbar_label: \\"&3➥ &fBossBar: &r{status}\\"\\n      beeps_label: \\"&3➥ &fBeeps: &r{status}\\"\\n      logbook