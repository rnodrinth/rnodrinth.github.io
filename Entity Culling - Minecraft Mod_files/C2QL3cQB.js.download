":29},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/bfcb69e9036364e7e99eeb52543e72ccbf54c212_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/bfcb69e9036364e7e99eeb52543e72ccbf54c212.png","featured":false,"title":"Silverfish Talisman","description":"Gain +50% mining speed","created":"2025-07-01T15:36:39.452542Z","ordering":30},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/e1a425c1da482b217a5f31f1006594af598cbc85_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/e1a425c1da482b217a5f31f1006594af598cbc85.png","featured":false,"title":"Skeleton Talisman","description":"Teleports you to your last death location","created":"2025-07-01T15:36:44.751945Z","ordering":31},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/d963420120abb0b01b2162f8e3889c902e2b383d_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/d963420120abb0b01b2162f8e3889c902e2b383d.png","featured":false,"title":"Spider Talisman","description":"Climb on walls just like spiders","created":"2025-07-01T15:36:50.098720Z","ordering":32},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/54bf104145bf73b68189ce0c8d44001eddd2a12e_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/54bf104145bf73b68189ce0c8d44001eddd2a12e.png","featured":false,"title":"Squid Talisman","description":"Every player gains 10 seconds of Blindness when hit","created":"2025-07-01T15:37:17.950101Z","ordering":33},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/8670c3af7e5ad9e83b564a299199a7e662d61c46_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/8670c3af7e5ad9e83b564a299199a7e662d61c46.png","featured":false,"title":"Strider Talisman","description":"Gain the ability to walk on lava","created":"2025-07-01T15:37:25.323526Z","ordering":34},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/fedb0c4e94e29c54bb8fc3f0ce1b927e844735a9_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/fedb0c4e94e29c54bb8fc3f0ce1b927e844735a9.png","featured":false,"title":"Tadpole","description":"Gain -50% scale","created":"2025-07-01T15:37:31.706172Z","ordering":35},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/7dd8a1aafc423cae171900b9ce3926b19d2ebc57_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/7dd8a1aafc423cae171900b9ce3926b19d2ebc57.png","featured":false,"title":"Turtle Talisman","description":"Gain Resistance I","created":"2025-07-01T15:37:36.936599Z","ordering":36},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/749283b23541ec09deba44d7a1dfe42e43500948_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/749283b23541ec09deba44d7a1dfe42e43500948.png","featured":false,"title":"Villager Talisman","description":"Every mob now drops 1-2 emeralds","created":"2025-07-01T15:37:41.254709Z","ordering":37},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/c2481b66e28160a3159d8fdba751fcb60c4388fa_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/c2481b66e28160a3159d8fdba751fcb60c4388fa.png","featured":false,"title":"Warden Talisman","description":"Gain +10 hearts","created":"2025-07-01T15:37:46.497217Z","ordering":38},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/f62ac376c931f196272bb5acc41e7ba80a5c2c14_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/f62ac376c931f196272bb5acc41e7ba80a5c2c14.png","featured":false,"title":"Witch Talisman","description":"When at or below 3 hearts gain a full heal","created":"2025-07-01T15:37:51.282982Z","ordering":39},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/a23de83474ba3f7781659c27687b9f60454a77fe_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/a23de83474ba3f7781659c27687b9f60454a77fe.png","featured":false,"title":"Wither Talisman","description":"Get a completely random item","created":"2025-07-01T15:37:56.234864Z","ordering":40},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/4ac6f06a9f844acdf8af9f478d7828b12c02ebbf_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/4ac6f06a9f844acdf8af9f478d7828b12c02ebbf.png","featured":false,"title":"Wither Skeleton Talisman","description":"Gain a 40% increased chance that a wither skeleton skull is dropped","created":"2025-07-30T15:18:11.831160Z","ordering":40},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/79eb5c0c0ed93df14cd3a7acc6bc0c8887b2ac29_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/79eb5c0c0ed93df14cd3a7acc6bc0c8887b2ac29.png","featured":true,"title":"Zombie Talisman","description":"Gain +100% XP","created":"2025-07-01T15:38:01.752647Z","ordering":41},{"url":"https://cdn.modrinth.com/data/vjel2moU/images/f3a5c284f2493f401b294a91601365caf8d1f7b8_350.webp","raw_url":"https://cdn.modrinth.com/data/vjel2moU/images/f3a5c284f2493f401b294a91601365caf8d1f7b8.png","featured":false,"title":"Zombie Villager Talisman","description":"Gain a 40% discount from villagers","created":"2025-07-15T17:41:26.586656Z","ordering":42}],"color":14280015,"thread_id":"tokulEwH","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["26.1.2"],"environment":["client_and_server"],"id":"5DxI88oJ","slug":"animalistic-ale96","project_type":"mod","team":"IQkatwjn","organization":null,"title":"Animalistic","description":"The mod adds new pets that you can summon into your world using the summoning table (after summoning them, you must right-click to claim them).\\nYou need to obtain the materials to craft the gems corresponding to each of the animals.","body":"![Replace this with a description](https://cdn.modrinth.com/data/cached_images/ec544d45e20dd98b1da98197798c076e8ba2dc55_0.webp)\\n## ANIMALISTIC MOD\\nNew animals, tamable, mountable and summonable\\n\\n \\n\\nThe mod adds new pets that you can summon in your world, via the summoning table (after summoning, you need to right click to tame).\\n\\nYou must get the materials to make the gems that belong to each of the animals\\nRECIPES\\n\\n<details>\\n<summary>Spoiler</summary>\\n\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/d5d51752b306c708b016302351a4ec2ef8ecf718.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/0d334eb1b0ebe10872e4ecd23542030f53b98237_0.webp)\\n\\n</details>\\n\\nTo summon them you must craft the \\"Summoning table\\", In it you must place a gem, a mount and a soul bottle, then press the \\"Generate\\" button\\n\\nThey defend their owner and can attack while being ridden by pressing the \\"Y\\" key (you can change the key in the settings).\\n\\n<details>\\n<summary>Spoiler</summary>\\n\\n**Red Panda:** It can be mounted, it can jump with the \\"Space\\" key, it defends you from enemies, it feeds on bamboo and sugar cane\\n\\n**Tiger:** It can be mounted, it can jump with the \\"Space\\" key, it defends you from enemies, When mounted you can attack with the \\"G\\" key, it feeds on all kinds of meat\\n\\n**Blue bird**: It can be mounted, it can fly with the \\"Space\\" key, it defends you from enemies, It is fed with carrots, potatoes or beets.\\n\\n**Duck:** It will follow you everywhere, it carries a chest with extra inventory, it cannot be ridden, it feeds on all kinds of seeds.\\n\\n**Alpha Bat:** It can be mounted, it can fly with the \\"Space\\" key, it defends you from enemies, it feeds on spider eyes, with the \\"G\\" key it gives you night vision.\\n\\n**Mystic owl:** can be mounted, can jump very high with the \\"Space\\" key and glides by pressing the \\"Space\\" key twice, defends you from enemies, feeds on all kinds of uncooked meat.\\n\\n**Wolf:** It can be mounted, jumps with the space key, shoots with the \\"V\\" key, feeds on all kinds of meat, bone and iron, defends its owner\\n\\n**Nymph bird:** can be mounted, flies, feeds on seeds and defends its owner\\n\\n**Secretary bird:** it can be mounted, it does not fly, but it runs very fast, it feeds on seeds and defends its owner.\\n\\n**Ferret:** It can be mounted, jumps with the space bar, attacks with the \\"V\\" key, eats chicken and rabbit, defends its owner\\n\\n**Shark:** It can be mounted in and out of the water, it feeds on any type of meat, when mounted in the water it will give you the effect of breathing underwater\\n\\n</details>\\n\\n\\n<details>\\n<summary>Spoiler</summary>\\n\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/5a5560df268a66c00b29875acb9430d235d6e788.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/30e095a219e013d07496a3ed0886cd815fc8d739.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/7af4c367c04842c8cd71d5ae5edaf6df9d6a4091.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/b6f9df81de3727b5adaa2df14ec3ebf7ac4c59cc_0.webp)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/37ae9411d88d547f7d7e261b66e17bb4f6a43d31.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/fae4269efc856294818fa7327da1bd6d27b8e46f.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/398c112e3f7a8fb95a231c253b7c9a5d91c32b4a.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/a7cf367891e183718dcb98450b7d701062181ed6.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/878d8b6d1088d22aae146cfee074b322a12eaa0f.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/8a0d588f32e5016905cde519a50a1c71d67cf425.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/b404c472484341a436dbee15f91d6ccb102358b1.png)\\n![Replace this with a description](https://cdn.modrinth.com/data/cached_images/e3400777eeff1f4369afe2fc1ff4092e5a5a7d5c.png)\\n\\n</details>\\n\\n\\n","body_url":null,"published":"2026-09-15T19:30:54.518885Z","updated":"2026-09-15T19:42:46.134947Z","approved":"2026-10-23T20:00:18.960613Z","queued":"2026-09-15T19:50:01.949411Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":51,"followers":3,"categories":["magic","mobs","transportation"],"additional_categories":["storage"],"loaders":["neoforge"],"versions":["n1CHAS0q"],"icon_url":"https://cdn.modrinth.com/data/5DxI88oJ/728de2babbc910a889d703e6fd309fc4366df7a2_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/5DxI88oJ/728de2babbc910a889d703e6fd309fc4366df7a2.jpeg","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/5DxI88oJ/images/56c3d4be37145d5b12e94641fe305530c5763a97_350.webp","raw_url":"https://cdn.modrinth.com/data/5DxI88oJ/images/56c3d4be37145d5b12e94641fe305530c5763a97.jpeg","featured":true,"title":null,"description":null,"created":"2026-09-15T19:49:11.174387Z","ordering":0}],"color":9327165,"thread_id":"LKgtS7rV","monetization_status":"monetized"},{"client_side":"required","server_side":"unsupported","game_versions":["26.1.2","26.2"],"environment":[],"id":"2JdLN20q","slug":"chunk-loading-wobble","project_type":"resourcepack","team":"DoOiaxxB","organization":null,"title":"Chunk Loading Wobble","description":"This resource pack makes the chunk loading animation wobbly","body":"# Chunk Loading Wobble\\nMakes chunk loading animation wobbly.\\n\\n![The animation showcase](https://cdn.modrinth.com/data/cached_images/7432c4a09b3b42d3c2ffb48a421fcf5691008fa5.gif)\\n## How does it work?\\nThis resource pack uses **core shaders** to change the position of the vertices in **terrain.vsh** vertex shader depending on **ChunkVisibility** parameter.","body_url":null,"published":"2026-04-23T12:38:19.659517Z","updated":"2026-04-23T12:41:57.712320Z","approved":"2026-04-24T01:54:01.335327Z","queued":"2026-04-23T12:58:33.801922Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"MIT","name":"MIT License","url":null},"downloads":730,"followers":17,"categories":["core-shaders","environment","vanilla-like"],"additional_categories":["simplistic"],"loaders":["minecraft"],"versions":["FK1Dj9vz"],"icon_url":"https://cdn.modrinth.com/data/2JdLN20q/93f667de135911d906aecabd2449fda4222b5f99_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/2JdLN20q/93f667de135911d906aecabd2449fda4222b5f99.png","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/2JdLN20q/images/c4f0b0ff3b0d2bb43903befca24909f1bbd49b34.gif","raw_url":"https://cdn.modrinth.com/data/2JdLN20q/images/c4f0b0ff3b0d2bb43903befca24909f1bbd49b34.gif","featured":true,"title":"Wobble Animation","description":"Chunk loading animation wobble showcase","created":"2026-04-23T12:56:46.750075Z","ordering":0}],"color":5335604,"thread_id":"5Rwq063N","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.21.1"],"environment":["client_and_server"],"id":"P26k79kP","slug":"create-aeroworks","project_type":"mod","team":"yYlDDGLY","organization":null,"title":"Create: Aeroworks","description":"A collection of addons for Create Aeronautics with blocks such as the gyroscope, joystick, and more!","body":"# Create: Aeroworks\\n\\n[![Discord logo](https://img.shields.io/badge/Discord-5865F2?style=for-the-badge&logo=discord&logoColor=white)](https://discord.gg/8rdTRdY6cY)\\n\\nAn addon for [Create: Aeronautics](https://www.curseforge.com/minecraft/mc-mods/create-aeronautics) that adds a suite of various blocks for your airships.\\n\\nAvailable blocks:\\n\\n*   Gyroscope\\n*   Joystick\\n\\nPlanned blocks:\\n\\n*   Advanced Gyroscope (allows arbitrary target orientation)\\n*   Mini Gyroscope\\n*   Joystick + Keyboard Input\\n*   Handheld Joystick\\n*   Modular Controller\\n\\n## Keep Your Ship Level\\n\\nThe **Gyroscope** is a spinning flywheel that stabilizes your ship upwards. Mount one anywhere on your contraption and supply it with rotational energy. The gyroscope stabilization scales with input RPM. Multiple gyroscopes can be used to stabilize larger ships!\\n\\n![Gyroscope stabilizing a ship with off-center CoM](https://cdn.modrinth.com/data/cached_images/b9b3412e6172e1061d39f946c8f3f2bc3a3460df.png)\\n\\nA tooltip is provided to provide insight to the gyroscopic stabilization.\\n![Gyroscope with tooltip](https://cdn.modrinth.com/data/cached_images/ee22cc8c507f4284a48a50f5f3238ba00f114c65.png)\\n\\nExplanation of Gyroscope status:\\n- Off -> Self explanatory. The gyroscope is off.\\n- Unstable -> The gyroscope is unable to stabilize your ship with the input RPM or number of gyroscope\\n- Steady -> Your ship can be stabilized with the current gyroscope(s) configuration. However, more power or gyroscopes is necessary to make your ship perfectly level.\\n- Level -> Your ship is level (< 2°) with respect to the world with the current gyroscope(s) configuration.\\n\\n### Configurable axis \\"stiffness\\":\\nApplying an analog redstone signal to the side of a gyroscope reduces the corrective forces applied by the gyroscope along that axis. The axis is fully unlocked at max redstone strength:\\n![Gyroscope analog signal](https://cdn.modrinth.com/data/cached_images/1b637c8e321582e437ba8663d9e6b4cfa73a1559_0.webp)\\n\\nThe tooltip is updated to reflect the current corrective force as \\"stiffness\\":\\n![Gyroscope stiffness tooltip](https://cdn.modrinth.com/data/cached_images/b3e254ed86b40941b86e31bafb0be43860bdbd73_0.webp)\\n\\nThis allows you to roll and pitch your ship but then bring the ship back to level when you\'re done maneuvering.\\n\\n## Joystick\\n\\nThe Joystick allows you to control your ship along 2 axes. A redstone signal (0-15) is output per direction the stick is tilted towards. For simplicity, the joystick outputs the redstone signal on configurable redstone link frequencies. An extra button is provided for extra controllability.\\n\\n![Joystick](https://cdn.modrinth.com/data/cached_images/c8bc019d84bdf5dab5952864669d26a50c24f5dc.png)\\n\\nA redstone input can be provided to lock the orientation of the joystick:\\n![Joystick Locked](https://cdn.modrinth.com/data/cached_images/5fd125a876eafc8c471df33f78a5d1534f2b7a41.png)\\n\\nAn on-screen HUD displays the current Joystick output when being controlled:\\n![Joystick HUD](https://cdn.modrinth.com/data/cached_images/8212dd986f2a53f06cd5e0138f5fbc6663796d83.png)\\n\\nA configurable UI is provided for configuring the redstone link frequencies:\\n![Joystick UI](https://cdn.modrinth.com/data/cached_images/249195189bf6b5e52822865925066ce1598ccbfc.png)\\n\\nKeyboard mode is also available with a toggleable snapback mode:\\n![Joystick UI keyboard](https://cdn.modrinth.com/data/cached_images/f6730f8ac23372c2c9aba32810ebcecd0dc96b06.png)\\n\\n## Modular Controls\\n\\n![Modular control console](https://cdn.modrinth.com/data/cached_images/3d3cc55019367d36ce99994ddbf833859373c6eb.png)\\n\\nThe console desk allows you to mix and match control modules to create the perfect cockpit or helm for your ship.\\n\\nCurrent supported control modules:\\n\\n* Lever\\n* Joystick\\n* Button\\n* Steering Wheel\\n* Yoke\\n* Throttle Quadrant\\n\\n## Dependencies\\n\\n*   NeoForge 21.1.225+\\n*   Create 6.0.0+\\n*   Create: Aeronautics 1.0.3+\\n\\n***","body_url":null,"published":"2026-04-24T17:17:00.885870Z","updated":"2026-08-27T00:05:18.607121Z","approved":"2026-05-01T03:52:14.537611Z","queued":"2026-04-30T03:26:40.896378Z","status":"approved","requested_status":"private","moderator_message":null,"license":{"id":"LicenseRef-Create-Aeroworks-License","name":"","url":"https://github.com/aeroworks-hangar/aeroworks-license/blob/main/LICENSE.md"},"downloads":753862,"followers":166,"categories":["game-mechanics","technology"],"additional_categories":[],"loaders":["neoforge"],"versions":["RJwP14xZ","RioiGWmn","vqNz2nHV","ern7qOZC","LKsY0cFi","mAzLZ8VO","vsT0uzkn","EYVmBa7H","y0R5bgR0","H2PGtFQ5","tQ0dgIjI","6kk7ruR3"],"icon_url":"https://cdn.modrinth.com/data/P26k79kP/2ca24db2d19baa1569bcb7050a6c4b1376c37682_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/P26k79kP/2ca24db2d19baa1569bcb7050a6c4b1376c37682.png","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":"https://discord.gg/8rdTRdY6cY","donation_urls":[],"gallery":[],"color":4666414,"thread_id":"sXbuzUOI","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.21.1","26.1.2"],"environment":["client_and_server"],"id":"VXjF2ICr","slug":"laputa-skybound","project_type":"mod","team":"j8YMqr3j","organization":null,"title":"Laputa: Skybound","description":"Laputa brings a new ancient sky civilization to the game with new Lore, Structures, Weapons, Armor and a lot more!","body":"![](https://media.forgecdn.net/attachments/description/1654425/description_0fbf39ab-c49f-43e9-8296-98701f81dc43.png)\\n\\n***\\n\\n<p style=\\"text-align: center;\\">_<span style=\\"color: #f1c40f;\\"><br></span>_**Minecraft’s sky has always felt a bit empty Laputa: Skybound is here to change that. Inspired by Jonathan Swift’s _Gulliver’s Travels_ and its legendary flying island, this mod brings a true ancient civilization to the clouds. Uncover forgotten lore, explore skybound structures, find Aerium technology, and much more !!!  \\n  \\nThe mod is currently for Neoforge 26.1.2 !  \\nYou\'ll need __Geckolib__ to run it well!  \\n  \\n_<span style=\\"color: #f1c40f;\\">Made for the 2026 Modjam: Echoes of the Past!</span>_  \\n  \\n**</p>\\n\\n***\\n\\n<p style=\\"text-align: center;\\">  \\n__**Old Remnants:  \\n  \\n**__After some exploration in your freshly generated new world you\'ll maybe encounter some old strange ruins..  \\nThere are six of them:</p>\\n\\n<div class=\\"spoiler\\"><p><img src=\\"https://media.forgecdn.net/attachments/description/1654425/description_cc1d921f-eee4-46e9-8dbd-52a027c73642.png\\" alt=\\"\\" width=\\"850\\" height=\\"447\\"><img style=\\"font-weight: 400; color: #999;\\" src=\\"https://media.forgecdn.net/attachments/description/1654425/description_153c1a35-ff8c-4f4f-9946-4d48f7187806.png\\"><img src=\\"https://media.forgecdn.net/attachments/description/1654425/description_acafafa6-3290-4f79-8290-36a6eabd8f03.png\\"><img src=\\"https://media.forgecdn.net/attachments/description/1654425/description_dd717654-28fa-4210-9bf9-096d0575258c.png\\"><img src=\\"https://media.forgecdn.net/attachments/description/1654425/description_00142727-cc3d-4de3-9485-23694b634d88.png\\"><img src=\\"https://media.forgecdn.net/attachments/description/1654425/description_dc3910d0-5345-48ac-8ba1-2c8093bceb1d.png\\"></p></div>\\n\\n <p style=\\"text-align: center;\\">These ancient structures are a kind of experiment and attempt to reach the flying island by land.  \\nBut there is more a **rare structure** of someone who achieve in finding that perticular city:  \\n  \\n</p>\\n\\n***\\n\\n<p style=\\"text-align: center;\\">__**  \\nThe Observatory:  \\n  \\n**![](https://media.forgecdn.net/attachments/description/1654425/description_1dc9019e-2e49-4865-9835-7f047bdb6a0a.png)  \\n  \\n__This structure can be found in the mountains fairly rarely, but it is undoubtedly the most important thing you need to find.</p><p style=\\"text-align: center;\\">Inside you\'ll find **Gull-Iver** a **special Villager** passionated about **Laputa**:</p><p style=\\"text-align: center;\\">![](https://media.forgecdn.net/attachments/description/1654425/description_ae9b08b9-3f22-4d15-8e7d-d916297e9dfc.png)</p><p style=\\"text-align: center;\\">![](https://media.forgecdn.net/attachments/description/1654425/description_720b0450-9883-4040-b928-cdaeae0c84d5.png)</p><p style=\\"text-align: center;\\">As is pretty standard, all you have to do is **trade with him** to get a few special items. Once you reach the **maximum level**, he\'ll finally trade you the **Old Parchment** that takes you to Laputa!  \\n  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_6f1980eb-4aa0-478b-bf85-4ea9bf29a48c.png)  \\n  \\nYou\'ll probably have to walk a few blocks but its worth it!  \\n  \\n</p>\\n\\n***\\n\\n<p style=\\"text-align: center;\\">  \\n__**Laputa:  \\n  \\n**__![](https://media.forgecdn.net/attachments/description/1654425/description_2c01f5e1-238c-4b18-a984-07d9cf6db309.png)  \\n  \\nYou\'ve finally reached the island and can now find everything you\'re looking for. Be careful, though, of these peculiar inhabitants: **the Harpies:  \\n**  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_9e9ed81a-b38a-4a32-96ba-ba8dfbbf2265.png)  \\n  \\n**Harpies** are ancient creatures native to Laputa. They are aggressive toward the player unless the player is wearing **Aerium Armor**. They attack fiercely and knock you into the air. When they die, they drop **feathers and crystals**.  \\n  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_234df593-904b-4cee-b18a-274e1cdc604b.png)  \\n  \\nWith those crafting materials you\'ll be able to craft Arrows, Levitation Potions and two new items : The **Harpy\'s Palm** and the **Storm Rocket**:  \\n  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_5280ee29-154b-4c41-89d7-d79322b1a96d.png)  \\n  \\nThe Harpy\'s Palm is a melee tool capable of doing air attacks and the Storm Rocket is a durable Firework with more velocity!  \\n  \\nOh and careful they are protected by a golem too:  \\n  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_20e251b4-f30a-4339-ad58-9cb56ff027fd.png)  \\n  \\nThis chunky guy is very strong and isn\'t agressive unless you hit him. He will attack every mobs and launch them into the air.  \\nHe can sometime drop a **Fist of Heavens**:  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_2218e57f-810d-4442-b36c-0b1b837a164e.png)  \\n  \\nAn artifact enchanted with Aerium\'s power, will act like the Golem and lauch in a radius all entities around you into the sky!  \\n  \\nThey can be spawn with Aerium Block + Carved Pumpkin.  \\n  \\n  \\nThere are also some special blocks such as **Gale Grass Block, Gale Grass and Gale Oak** :  \\n  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_0479671e-eb8b-4018-8703-13321e92985c.png)</p><p style=\\"text-align: center;\\">__**The Wand of Wind:  \\n  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_7a07d95b-21fb-4b8e-a1d3-24fe97e82f01.png)  \\n  \\n**__The **Wand of Wind** if a new craftable tool that allows you to place the block from your off-hand in front of you, allowing you to build at a distance or on platforms in the air without needing a block to start with.</p>\\n\\n***\\n\\n<p style=\\"text-align: center;\\">  \\n__**Aerium:  \\n  \\n**__  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_c9478a92-1854-4677-8a7c-411c1e4296f9.png)  \\n  \\nIn Harpies\'s chests, you\'ll be able to discover an ancient Ore called: the **Aerium.  \\n**Many crafts use it as a material and the full armor set power is between **Diamond** and **Netherite** with its own advantages such as fall damage negation.  \\n  \\nTools are useful too and have a chance to deal a special hit inflicting more damage lauching the target in the sky like Harpies.  \\n  \\nYou can also craft some **Brick** **Blocks** with it:  \\n  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_80d9b426-2fea-4627-a7a2-aa917417fdc1.png)  \\n  \\n__**The Aerium Launcher:  \\n  \\n![](https://media.forgecdn.net/attachments/description/1654425/description_28d573eb-96d9-4927-b521-173b395f887a.png)  \\n  \\n**__And finally, in my opinion, the most interesting block is still the **Aerium Launcher** a redstone block that, when powered, will launch you very high into the air (without negating fall damage) when you step on it!  \\nThe more power the block have the higher it will send you.  \\n  \\nThere is also a \\"side\\" version called the **Aerium Propeller**, exact same function but on North, West, East, South sides!  \\n  \\n</p>\\n\\n***\\n\\n<p style=\\"text-align: center;\\">  \\nMade with <span style=\\"color: #2dc26b;\\">Mcreator</span> !  \\n  \\n</p><p style=\\"text-align: center;\\">Feel free to use that mod in your Modpack, but don\'t <span style=\\"color: #e03e2d;\\"><strong>redistribute it without my permission</strong>!</span></p><p style=\\"text-align: center;\\">**You <span style=\\"color: #e03e2d;\\">cant&nbsp;reuse the 3d models, animations, texture of that mod</span>**, if you want, you can ask me on [my discord server](https://discord.gg/m9W9r772XB) directly!   \\n  \\nTHANKS YOUU</p>","body_url":null,"published":"2026-09-04T13:29:50.136549Z","updated":"2026-09-04T13:32:25.279935Z","approved":"2026-10-05T21:37:57.228708Z","queued":"2026-09-04T13:36:25.167122Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":190,"followers":9,"categories":["adventure","equipment","worldgen"],"additional_categories":["mobs"],"loaders":["neoforge"],"versions":["W01GHxaX","WOTQe4ko"],"icon_url":"https://cdn.modrinth.com/data/VXjF2ICr/f311a29e31a7c1f619177559de32ce3e569b4076_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/VXjF2ICr/f311a29e31a7c1f619177559de32ce3e569b4076.png","issues_url":null,"source_url":"https://github.com/Choupiclou/Laputa-Skybound-Mod","wiki_url":null,"discord_url":null,"donation_urls":[{"id":"ko-fi","platform":"Ko-fi","url":"https://ko-fi.com/choupiclou"}],"gallery":[],"color":3235710,"thread_id":"loCYf0Xx","monetization_status":"monetized"},{"client_side":"optional","server_side":"required","game_versions":["1.21.10","1.21.5","1.21.6","1.21.7","1.21.8","1.21.9"],"environment":["server_only_client_optional"],"id":"L1FTYcBH","slug":"valleys","project_type":"mod","team":"7eRBLZyf","organization":"idDP24We","title":"Valley","description":"A world-gen river and valley mod","body":"![Example World-Gen with Valley + Other Mods](https://cdn.modrinth.com/data/cached_images/6e36bd8c717918e7cb9ec67d071ec4161c6bb455.jpeg)\\n\\n# Valley\\n\\nValley is a world-gen mod that replaces vanilla rivers with ones that start inland and meander their way to the ocean.\\n\\nThis mod influences the terrain to generate in a more cohesive and natural-looking way creating beautiful rivers, valleys, ridgelines, and mountain chains. _(And now that the rivers actually go somewhere, it makes possible a fun new form of navigation and exploration!)._\\n\\n## Compatability\\n\\nValley is designed as a \\"drop-in\\" mod to use alongside other world-gen/biome mods and datapacks (eg Biomes\'O\'Plenty, Terralith, etc). Mods that entirely overhaul the world-generation or specifically change rivers or continents will probably not work with Valley.\\n\\nSee the [gallery](/mod/valleys/gallery) for some examples.\\n\\n## Server Setup\\n\\nValley can be installed on a modded server.  \\nClients do not need to have Valley installed in order to connect to the server.\\n\\nServer setup steps:\\n1. Make sure the server is not running!\\n2. Install the Valley mod to your server\'s \\"mods\\" folder.\\n3. If present, backup and remove the server\'s existing world.\\n4. Launch the server allowing it to create a new world.\\n5. Done!\\n\\n## Roadmap\\n\\nThis mod is in the early stages of development.  \\nOur plans for future iterations include:\\n\\n- General refining of the default river/continent settings\\n- Expose settings to make rivers and continents more easily configurable\\n- Make it possible to distribute \'presets\' that can override Valley\'s defaults\\n- Provide GUI enhancements to allow user to preview changes before creating world\\n\\n## Permissions\\n\\nYou are of course free to use this mod in modpacks and to create content/media with it.  \\nWe only ask that you do not rehost the jar file.  \\nPlease reach out if you\'d like us to host on other popular mod-hosting platforms.","body_url":null,"published":"2025-11-06T20:18:50.718717Z","updated":"2025-11-12T12:30:49.699685Z","approved":"2025-11-12T19:53:52.399752Z","queued":"2025-11-12T12:37:40.879126Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":4050,"followers":250,"categories":["adventure","worldgen"],"additional_categories":[],"loaders":["fabric","forge","neoforge"],"versions":["kQnxGBhY","dIqtbHRr","Qgj5wRzZ"],"icon_url":"https://cdn.modrinth.com/data/L1FTYcBH/2cb2169f6c500e6ffd9cfac598bf62a38da11bb8_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/L1FTYcBH/2cb2169f6c500e6ffd9cfac598bf62a38da11bb8.png","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[{"id":"ko-fi","platform":"Ko-fi","url":"https://ko-fi.com/dagsu"}],"gallery":[{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/9be64509318ec39166b70c41fe638623454764e7_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/9be64509318ec39166b70c41fe638623454764e7.jpeg","featured":false,"title":"Two Rivers","description":"Mods Used: VALLEY, ChoiceTheorem\'s Overhauled-Village, Geophilic, Repurposed-Structures, Terrestria, Towns-&-Towers, William-Wythers\' Overhauled-Overworld","created":"2025-11-09T16:20:19.303705Z","ordering":0},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/79af1ad89e47b8c538551ea50a3f8b72e5e66d54_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/79af1ad89e47b8c538551ea50a3f8b72e5e66d54.jpeg","featured":false,"title":"River","description":"Mods Used: VALLEY, ChoiceTheorem\'s Overhauled-Village, Geophilic, Repurposed-Structures, Terrestria, Towns-&-Towers, William-Wythers\' Overhauled-Overworld","created":"2025-11-09T16:20:49.108473Z","ordering":1},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/7489b2e1c8060d88012b7f0c6f4acb88f4fdfeef_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/7489b2e1c8060d88012b7f0c6f4acb88f4fdfeef.jpeg","featured":false,"title":"River","description":"Mods Used: VALLEY, ChoiceTheorem\'s Overhauled-Village, Geophilic, Repurposed-Structures, Terrestria, Towns-&-Towers, William-Wythers\' Overhauled-Overworld","created":"2025-11-09T16:21:21.990759Z","ordering":2},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/ca9aff1cbfe6edb8ae6bb54357b285349bdcfa41_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/ca9aff1cbfe6edb8ae6bb54357b285349bdcfa41.jpeg","featured":false,"title":"Valley","description":"Mods Used: VALLEY, ChoiceTheorem\'s Overhauled-Village, Geophilic, Repurposed-Structures, Terrestria, Towns-&-Towers, William-Wythers\' Overhauled-Overworld","created":"2025-11-09T16:22:32.671130Z","ordering":3},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/a0234f16d5f15a4923aa0c4bd01454c56c2c82ce_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/a0234f16d5f15a4923aa0c4bd01454c56c2c82ce.jpeg","featured":false,"title":"Valley","description":"Mods Used: VALLEY, ChoiceTheorem\'s Overhauled-Village, Geophilic, Repurposed-Structures, Terrestria, Towns-&-Towers, William-Wythers\' Overhauled-Overworld","created":"2025-11-09T16:23:01.231574Z","ordering":4},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/b6914964bbc9d9e6cd2ce70501b1f0ce90ab48fb_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/b6914964bbc9d9e6cd2ce70501b1f0ce90ab48fb.jpeg","featured":false,"title":"Aerial","description":"Mods Used: VALLEY, ChoiceTheorem\'s Overhauled-Village, Geophilic, Repurposed-Structures, Terrestria, Towns-&-Towers, William-Wythers\' Overhauled-Overworld","created":"2025-11-09T16:23:40.118794Z","ordering":5},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/e64a62b62234218145ec17e0d39556a9452b9a95_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/e64a62b62234218145ec17e0d39556a9452b9a95.jpeg","featured":false,"title":"River Fork","description":"Mods Used: VALLEY, ChoiceTheorem\'s Overhauled-Village, Geophilic, Repurposed-Structures, Terrestria, Towns-&-Towers, William-Wythers\' Overhauled-Overworld","created":"2025-11-09T16:24:37.334237Z","ordering":6},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/7301f634a37ae3ae0b934989e6fca3d5ea0d4d6c_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/7301f634a37ae3ae0b934989e6fca3d5ea0d4d6c.jpeg","featured":false,"title":"Valley","description":"Mods Used: VALLEY","created":"2025-11-09T16:11:26.930492Z","ordering":10},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/5cfa0cc4b2182f43cbc081c38a79a82a033279e0_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/5cfa0cc4b2182f43cbc081c38a79a82a033279e0.jpeg","featured":false,"title":"Continent Map","description":"Mods: VALLEY, Biomes-O-Plenty, Dungeons-&-Taverns, Geophilic, William-Wythers-Overhauled-Overworld, Xaeros-World-Map","created":"2025-11-12T12:13:37.638877Z","ordering":10},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/cb40103ef98304b35ed81cde7a4bdd13780b1a3d_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/cb40103ef98304b35ed81cde7a4bdd13780b1a3d.jpeg","featured":false,"title":"River","description":"Mods Used: VALLEY","created":"2025-11-09T16:13:43.458326Z","ordering":11},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/923c1974f3795205c8536ffb74634d1607f3dedb_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/923c1974f3795205c8536ffb74634d1607f3dedb.jpeg","featured":false,"title":"River Fork","description":"Mods Used: VALLEY","created":"2025-11-09T16:14:32.474314Z","ordering":12},{"url":"https://cdn.modrinth.com/data/L1FTYcBH/images/1a09b768b75a56e5e86cc96609c1d2a45423da9c_350.webp","raw_url":"https://cdn.modrinth.com/data/L1FTYcBH/images/1a09b768b75a56e5e86cc96609c1d2a45423da9c.jpeg","featured":false,"title":"River Fork","description":"Mods Used: VALLEY","created":"2025-11-09T16:12:30.761226Z","ordering":13}],"color":8492266,"thread_id":"VfUVH123","monetization_status":"monetized"},{"client_side":"required","server_side":"unsupported","game_versions":["1.20.1","1.20.2","1.20.3","1.20.4","1.20.5","1.20.6","1.21.1","26.1.2"],"environment":["client_only"],"id":"t3wlJuW5","slug":"easy-building","project_type":"mod","team":"waqk2YCy","organization":null,"title":"Easy Building","description":"Quickly build walls and floors without mistakes, completely Clientside.","body":"Choose a vertical or horizontal plane, then you can click and drag to quickly and neatly place blocks on that plane. Use this to easily extend walls, floors, bridges or roofs.\\n\\n![Clicking and dragging to quickly make a wall](https://cdn.modrinth.com/data/cached_images/18da90cc64adc0a3e1839e05ea24da7b993021a3.gif)\\n\\n### Instructions\\nPress Left Alt (can be rebound to any key) to toggle Easy Building Mode. The building plane gets set to whatever face you were looking when you pressed the button, so if you want to extend a wall, look at that wall and press the button. If you want to extend a bridge, look at the floor and press the button. Same for a roof, railing, scaffolding, anything.\\n\\n### Slabs and Stairs\\nWhen you press the Easy Building Mode key while looking at a slab or stair block, it will try to match that block when placing others. This means that if you start Easy Building Mode while looking at a top slab, you will place top slabs. If you were looking at a bottom slab, you will place bottom slabs.\\n\\n### Server usage\\n**This is a clientside mod, meaning you can use it even if its not installed in the server. This mod might not be allowed on multiplayer servers and could result in a ban. Please consult with server authorities before using in multiplayer.**\\n\\n### Impossible blocks\\nThis mod doesn\'t allow you to place blocks in impossible positions. It requires a neighbor to place the block against. This means that you cant place a floating top slab by placing a slab above a lone block, and you cant place blocks in the air. That said, you can place blocks you couldn\'t normally place (i.e. extending a bridge without peeking past the edge).\\n\\n### Open source\\nI welcome any fixes, improvements or ports. [The source is available in github](https://github.com/marianolarre/easy-building-minecraft-mod).\\n\\n### Showcase\\n<iframe width=\\"560\\" height=\\"315\\" src=\\"https://www.youtube-nocookie.com/embed/jtbILROmY7U\\" title=\\"YouTube video player\\" frameborder=\\"0\\" allow=\\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\\" allowfullscreen></iframe>","body_url":null,"published":"2026-06-10T19:48:40.897559Z","updated":"2026-07-03T14:47:07.532614Z","approved":"2026-06-14T00:09:31.102554Z","queued":"2026-06-10T20:18:04.586229Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"MIT","name":"MIT License","url":null},"downloads":31958,"followers":226,"categories":["game-mechanics","utility"],"additional_categories":[],"loaders":["fabric","neoforge"],"versions":["REO6zRXs","iNDv60Sp","itz3436f","id5i37GF","UPaEu1Cw","HxkdqSKS","OOnj8RkU","f8HMMfV6"],"icon_url":"https://cdn.modrinth.com/data/t3wlJuW5/d0cf09aba88ad2ac7c5bb3fae709aae9b7f8a0fc.png","raw_icon_url":"https://cdn.modrinth.com/data/t3wlJuW5/d0cf09aba88ad2ac7c5bb3fae709aae9b7f8a0fc.png","issues_url":null,"source_url":"https://github.com/marianolarre/easy-building-minecraft-mod","wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/t3wlJuW5/images/c2c6fb646cd0ff18d033c7db6a435e39815a4133_350.webp","raw_url":"https://cdn.modrinth.com/data/t3wlJuW5/images/c2c6fb646cd0ff18d033c7db6a435e39815a4133.png","featured":false,"title":"Building a bridge","description":null,"created":"2026-06-10T20:11:17.850362Z","ordering":0},{"url":"https://cdn.modrinth.com/data/t3wlJuW5/images/d85f61f43d5201d0dd2a093e5275ab1c6e270334_350.webp","raw_url":"https://cdn.modrinth.com/data/t3wlJuW5/images/d85f61f43d5201d0dd2a093e5275ab1c6e270334.png","featured":true,"title":"Building a wall","description":null,"created":"2026-06-10T20:11:31.553700Z","ordering":0},{"url":"https://cdn.modrinth.com/data/t3wlJuW5/images/06b7be64876e6e0f0944475e2d2ea7002050766a_350.webp","raw_url":"https://cdn.modrinth.com/data/t3wlJuW5/images/06b7be64876e6e0f0944475e2d2ea7002050766a.png","featured":false,"title":"Building a roof","description":null,"created":"2026-06-10T20:11:41.908771Z","ordering":0},{"url":"https://cdn.modrinth.com/data/t3wlJuW5/images/c1968eb3b5e808f9f1c86123090a74f2cc8c9e65_350.webp","raw_url":"https://cdn.modrinth.com/data/t3wlJuW5/images/c1968eb3b5e808f9f1c86123090a74f2cc8c9e65.png","featured":false,"title":"Building a wall","description":null,"created":"2026-06-13T18:23:32.508591Z","ordering":0},{"url":"https://cdn.modrinth.com/data/t3wlJuW5/images/d0dbb81d8f8022a206b1f554fe4a211e13b3fefb_350.webp","raw_url":"https://cdn.modrinth.com/data/t3wlJuW5/images/d0dbb81d8f8022a206b1f554fe4a211e13b3fefb.png","featured":false,"title":"Building a bridge","description":null,"created":"2026-06-13T18:23:41.313211Z","ordering":0}],"color":8275238,"thread_id":"x8hTZPNL","monetization_status":"monetized"},{"client_side":"optional","server_side":"required","game_versions":["1.21.1","1.21.10","1.21.11","1.21.6","1.21.7","1.21.8","1.21.9","26.1","26.1.1","26.1.2","26.2","26.3","26.3-rc-3"],"environment":["server_only_client_optional"],"id":"b844W4IS","slug":"save-point","project_type":"mod","team":"y2DnsfvJ","organization":null,"title":"Save Point","description":"A partial keep inventory: Spawn points save your current items and restore them upon death","body":"A kind of partial KeepInventory based on spawn points.\\n\\nWhen you set your spawn, your inventory will be saved at that instant. When you die, only the items you had for that save will be restored. All your other items will drop at your death location.\\n\\nFor example, if you set your spawn before looting a structure and then die, you will keep the equipment you had before going into the structure, but the loot you collected while inside will drop.\\n\\n<details>\\n\\n<summary>More Details</summary>\\n\\n- Works with beds and respawn anchors, and should work with *most* modded respawn systems\\n- You may click the respawn point again to save your inventory again\\n- Partial stacks are preserved, so if you save with 10 diamonds, collect 10 more diamonds, and then die, you will keep 10 diamonds and drop 10 diamonds\\n- Contents of bundles & shulker boxes are handled, for example if you save your inventory then put some items inside a bundle then die, you should keep all your items\\n- Items are still restored even if inventory items are moved around, although in a partial restore scenario the order may affect how stacks are split\\n- By default your items are not saved if your respawn block is destroyed or missing. You can change this with the gamerule `savepoint:restore_without_spawnpoint`.\\n- By default, XP is not saved. You can change this with the gamerule `savepoint:restore_experience`.\\n- When comparing items, components in `#savepoint:restore_compare` are checked. By default, this does not include:\\n  - Durability\\n  - Map markers\\n  - Writable book content\\n  \\n  Feel free to open an issue with suggestions for more ignored components\\n  \\n</details>\\n\\n## Notes\\n\\n- Works server-side, so it works with vanilla clients. The only client feature is potential translations for the \\"Inventory Saved\\" message in the future.\\n- Inspired by [Respawn Save Points](https://modrinth.com/mod/respawn-save-points) by [seymourimadeit](https://modrinth.com/user/seymourimadeit) and [CreativelyJake](https://modrinth.com/user/CreativelyJake), check them out!\\n- Compatible with [Revive](https://modrinth.com/mod/revive)\\n- Might be compatible with some gravestone mods\\n- [≤1.21.11] compatible with [Accessories](https://modrinth.com/mod/accessories)\\n- [≥26.1] compatible with [Trinkets Updated](https://modrinth.com/mod/trinkets-updated)\\n- If you\'re in singleplayer and want a mod that resets not only your inventory but the whole world, see [Save State](https://modrinth.com/mod/save-state)\\n- Requires [Fabric API](https://modrinth.com/mod/fabric-api) and [Fabric Language Kotlin](https://modrinth.com/mod/fabric-language-kotlin)\\n- Pairs well with a mod that makes your items not fly everywhere when you die","body_url":null,"published":"2025-06-21T07:52:40.194349Z","updated":"2026-10-07T22:43:27.628646Z","approved":"2025-07-25T03:35:09.323439Z","queued":"2025-07-21T00:12:12.523661Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"MIT","name":"MIT License","url":null},"downloads":3574,"followers":24,"categories":["adventure","game-mechanics","storage"],"additional_categories":[],"loaders":["fabric"],"versions":["NJv4GKxb","sZnwdbGb","T2kvyBzH","tIlx0lGN","uVC0BY7s","JHoHIVFn","1wy1X6XW","ozVR0rmX","WePzHs4v","LYFYjmq6","xH9ewCdv","EyRCb9TT","rrsXcIPh","g18iUDUD","hY9ZT4rq","Lw7JgXBA","UXbIeD1J","Ga0qqQvz","V0A7fJDI"],"icon_url":"https://cdn.modrinth.com/data/b844W4IS/5216aa1f2e3ea8590016856f9ea1bd6a7950fe9b.png","raw_icon_url":"https://cdn.modrinth.com/data/b844W4IS/5216aa1f2e3ea8590016856f9ea1bd6a7950fe9b.png","issues_url":"https://github.com/ThePotatoArchivist/SavePoint/issues","source_url":"https://github.com/ThePotatoArchivist/SavePoint","wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[],"color":4600699,"thread_id":"rWINSGFr","monetization_status":"monetized"},{"client_side":"required","server_side":"unsupported","game_versions":["1.21.10","1.21.11","1.21.5","1.21.6","1.21.7","1.21.8","1.21.9"],"environment":[],"id":"DhQ8Dck4","slug":"ksepsp-cit","project_type":"resourcepack","team":"Iw4gM6L7","organization":null,"title":"KSEPSP [Vanilla CIT]","description":"Over 1700 custom items to vanilla game!","body":"![ksepsp logo description ](https://cdn.modrinth.com/data/cached_images/2b0599e83cff9cd3786053ea35aaf99c77cce7a8.png)\\n\\n![ksepsp mini logo](https://cdn.modrinth.com/data/cached_images/e2dabf7c2ff780ee2b5136525a0222e7445b7019.png) **KSEPSP** is a resourcepack that adds a bunch of new items for decorating your builds, customizing gameplay or role-playing. All items can be obtained by renaming specific items on anvil. List of all items can be found on project\'s [website](https://definitelyawhale.github.io/ksepsp_website/).\\n\\nSome features **require** modifications [![optifine logo](https://cdn.modrinth.com/data/cached_images/01bad20b8007a0ac2acc27d0d4ee4659c08e878f.png) **Optifine**](https://optifine.net/downloads), or [**ETF**](https://modrinth.com/mod/entitytexturefeatures) and [**EMF**](https://modrinth.com/mod/entity-model-features).\\n\\n![emotes](https://cdn.modrinth.com/data/cached_images/991aa2d82827835ba1d7797da4d502f5c06d9762.png) Resourcepack has its own official set of **emotions** for [**Emotecraft**](https://modrinth.com/mod/emotecraft) mod, created by SPEmotes.\\n\\nTo **install** the resource pack you need to copy the downloaded archive to the \\"resourcepacks\\" folder in Minecraft root folder and turn it on in the game settings.\\n\\n![links ksepsp](https://cdn.modrinth.com/data/cached_images/966a679408c118f14009019ee0ec5d74b10db756.png)\\n\\n![ksepsp mini logo](https://cdn.modrinth.com/data/cached_images/e2dabf7c2ff780ee2b5136525a0222e7445b7019.png) [**Project website + Catalog**](https://definitelyawhale.github.io/ksepsp_website/)\\n\\n![telegram ksepsp](https://cdn.modrinth.com/data/cached_images/1ee9d329feaf437aea538083d7f280d5f9b4ca13.png) [**Telegram**](https://t.me/ksepsp_cit)\\n\\n![ksepsp twitter](https://cdn.modrinth.com/data/cached_images/c5931b5d466d8ff90a7bf94ee1d423024e4480fc.png) [**X (Twitter)**](https://x.com/kseprp_eng)\\n\\n![emotes](https://cdn.modrinth.com/data/cached_images/991aa2d82827835ba1d7797da4d502f5c06d9762.png) [**Emotions**](https://spemotes.com/download/)\\n\\n![map logo](https://cdn.modrinth.com/data/cached_images/705cd6573adc6378c872cb3e17d7864984d4033b.png) [**Map with all items _(outdated)_**](https://drive.google.com/file/d/1uIo0HTR-tWtGwg10Hhxvg8nSCicA2RRG/view)\\n","body_url":null,"published":"2026-06-17T07:38:11.108985Z","updated":"2026-06-17T07:43:13.172544Z","approved":"2026-06-20T02:58:01.146398Z","queued":"2026-06-17T09:22:11.518830Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":50511,"followers":69,"categories":["16x","decoration","models"],"additional_categories":["combat","equipment","items","vanilla-like"],"loaders":["minecraft"],"versions":["ysDnFpHc"],"icon_url":"https://cdn.modrinth.com/data/DhQ8Dck4/9260761491ff5baf64babf40b1d22843252efd2b_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/DhQ8Dck4/9260761491ff5baf64babf40b1d22843252efd2b.png","issues_url":null,"source_url":null,"wiki_url":"https://definitelyawhale.github.io/ksepsp_website/","discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/473caa422619181997598f4735d40fe8df3064b6_350.webp","raw_url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/473caa422619181997598f4735d40fe8df3064b6.png","featured":true,"title":null,"description":null,"created":"2026-06-17T09:14:05.341447Z","ordering":0},{"url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/fce52117eac6e1a3926f01890dea2436c71b0798_350.webp","raw_url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/fce52117eac6e1a3926f01890dea2436c71b0798.png","featured":false,"title":null,"description":null,"created":"2026-06-17T09:14:27.036573Z","ordering":1},{"url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/2fbcd4b9a52db8d1f09486c55218e84fd380c94f_350.webp","raw_url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/2fbcd4b9a52db8d1f09486c55218e84fd380c94f.png","featured":false,"title":null,"description":null,"created":"2026-06-17T09:14:39.641499Z","ordering":2},{"url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/2beb49ab590dfd7729e5874786b3d8cd91015983_350.webp","raw_url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/2beb49ab590dfd7729e5874786b3d8cd91015983.png","featured":false,"title":null,"description":null,"created":"2026-06-17T09:14:48.720480Z","ordering":3},{"url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/ede61371f40f68c5e9961f922835632711ddcaf4.webp","raw_url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/ede61371f40f68c5e9961f922835632711ddcaf4.webp","featured":false,"title":null,"description":null,"created":"2026-06-17T09:15:00.941629Z","ordering":4},{"url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/0b8a3ed72b2f336c2a7d0367543a4a5a51bf1b5c.webp","raw_url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/0b8a3ed72b2f336c2a7d0367543a4a5a51bf1b5c.webp","featured":false,"title":null,"description":null,"created":"2026-06-17T09:15:55.766351Z","ordering":5},{"url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/801062d9d5fbd8224d9c1348ac957d98482614dc.webp","raw_url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/801062d9d5fbd8224d9c1348ac957d98482614dc.webp","featured":false,"title":null,"description":null,"created":"2026-06-17T09:15:48.505237Z","ordering":6},{"url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/321a72c80c1bea3739d82a9ea4b6ad253c080add.webp","raw_url":"https://cdn.modrinth.com/data/DhQ8Dck4/images/321a72c80c1bea3739d82a9ea4b6ad253c080add.webp","featured":false,"title":null,"description":null,"created":"2026-06-17T09:16:09.062125Z","ordering":7}],"color":11736084,"thread_id":"hutkPJfa","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.20.1"],"environment":["client_and_server"],"id":"ps36yEsA","slug":"originiumarts","project_type":"mod","team":"kvMY8MfX","organization":null,"title":"OriginiumArts","description":"A mod that draws inspiration from the game Arknights\'s Originium Arts-related settings. It allows players to use arts units to unleash different skills and to modularly customize these units.","body":"**As this project is still in beta, please be sure to back up your work.**\\n\\n\\n**Wiki Page Here : [Wiki（the English version is being prepared）](https://azanenh37.github.io/OriginiumArtsWiki/).**\\n\\n\\n\\n## Introduction\\nOriginiumArts (OGNA) is an adventure and weapons mod inspired by the Originium Arts and related settings from the game Arknights. It allows players to use a diverse range of arts units to unleash various skills within the game and to modularly customize these units.\\n\\n\\n## Mod Features\\n* **Operator Weapons and Skills from *Arknights* the game**\\n* **Skill Casting Mechanisms and Associated Functions Similar to the Original Game**\\n* **Modular Customization** to freely combine, match, and enhance special abilities and mechanisms for your arts units\\n* **Originium Terrain and preliminary processing of Originium Products** (gradually updated)","body_url":null,"published":"2025-08-20T14:46:24.025764Z","updated":"2025-09-09T10:22:03.159289Z","approved":"2025-08-22T04:26:32.740333Z","queued":"2025-08-20T15:10:05.163701Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"AGPL-3.0-only","name":"GNU Affero General Public License v3.0 only","url":null},"downloads":12201,"followers":21,"categories":["adventure","equipment","magic"],"additional_categories":["worldgen"],"loaders":["forge"],"versions":["HANGRY9j","F2GGRQ4d","Cc3Zex8Z","Et3NtGmY"],"icon_url":"https://cdn.modrinth.com/data/ps36yEsA/9b208f16b0ce1479d4246ff1d6d91ec1eaaf0329_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/ps36yEsA/9b208f16b0ce1479d4246ff1d6d91ec1eaaf0329.png","issues_url":"https://github.com/azaneNH37/OriginiumArts/issues","source_url":"https://github.com/azaneNH37/OriginiumArts","wiki_url":"https://azanenh37.github.io/OriginiumArtsWiki/","discord_url":"https://discord.gg/H9P2RTVfYA","donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/ps36yEsA/images/45de5eeff5c0561d5f28c7ad3c9d7801207556dc_350.webp","raw_url":"https://cdn.modrinth.com/data/ps36yEsA/images/45de5eeff5c0561d5f28c7ad3c9d7801207556dc.png","featured":false,"title":"Combat","description":"with Shader BSL","created":"2025-08-20T15:00:47.291978Z","ordering":1},{"url":"https://cdn.modrinth.com/data/ps36yEsA/images/32fd572ef72e88b4b3ecba71871ded27816cdc4c_350.webp","raw_url":"https://cdn.modrinth.com/data/ps36yEsA/images/32fd572ef72e88b4b3ecba71871ded27816cdc4c.png","featured":false,"title":"Craft","description":null,"created":"2025-08-20T15:01:10.111510Z","ordering":2},{"url":"https://cdn.modrinth.com/data/ps36yEsA/images/3c82dde6d64b6ddca6f672d6c3c7c9a351ec99f3_350.webp","raw_url":"https://cdn.modrinth.com/data/ps36yEsA/images/3c82dde6d64b6ddca6f672d6c3c7c9a351ec99f3.png","featured":false,"title":"Modules","description":null,"created":"2025-08-20T15:01:39.726111Z","ordering":3},{"url":"https://cdn.modrinth.com/data/ps36yEsA/images/2915965babcf3073493119449306ee47e77eb314_350.webp","raw_url":"https://cdn.modrinth.com/data/ps36yEsA/images/2915965babcf3073493119449306ee47e77eb314.png","featured":false,"title":"Arts Unit","description":null,"created":"2025-08-20T15:02:10.025890Z","ordering":4},{"url":"https://cdn.modrinth.com/data/ps36yEsA/images/94d1033678f1947204a91d52bddb7adeed48a561_350.webp","raw_url":"https://cdn.modrinth.com/data/ps36yEsA/images/94d1033678f1947204a91d52bddb7adeed48a561.png","featured":false,"title":"Originium","description":"with Shader BSL","created":"2025-09-09T10:37:07.083790Z","ordering":5},{"url":"https://cdn.modrinth.com/data/ps36yEsA/images/b7da8b2ff44dad7f6d7765723d91b5f1d15958b9_350.webp","raw_url":"https://cdn.modrinth.com/data/ps36yEsA/images/b7da8b2ff44dad7f6d7765723d91b5f1d15958b9.png","featured":false,"title":"Crystal","description":"with Shader BSL","created":"2025-09-09T10:37:54.785605Z","ordering":6}],"color":2302243,"thread_id":"Ef32b0d5","monetization_status":"monetized"},{"client_side":"unsupported","server_side":"required","game_versions":["1.21.11","26.1","26.1.1","26.1.2","26.2","26.3"],"environment":[],"id":"gohLXCmq","slug":"dl03-gravity-gun","project_type":"mod","team":"XBnB8M0k","organization":null,"title":"Gravity Gun","description":"A Minecraft plugin that recreates the Gravity Gun tool from Half-Life 2.","body":"# Gravity Gun\\n\\nA Minecraft plugin that recreates the Gravity Gun tool from Half-Life 2. The right mouse button can be used to pick up a creature or block, or to drop it. The left mouse button can be used to push a creature or launch it if the object is captured. \\n\\n| Command       | Permission         | Description                                                    |\\n|---------------|--------------------|----------------------------------------------------------------|\\n| help          |                    | Show this help                                                 |\\n| reload        | gravity-gun.reload | Reload the plugin configuration                                |\\n| give [target] | gravity-gun.give   | Give the gravity gun to yourself or another player             |\\n| fix [target]  | gravity-gun.fix    | Fix gravity and collision player after unlucky player grabs it |\\n\\n## For resource packs\\n\\nFor resource packs, there is the option to attach a model and texture to a crossbow via:\\n```\\n{\\n    \\"model\\": {\\n        \\"type\\": \\"select\\",\\n        \\"property\\": \\"custom_model_data\\",\\n        \\"fallback\\": {\\n            \\"type\\": \\"model\\",\\n            \\"model\\": \\"item/crossbow\\"\\n        },\\n        \\"cases\\": [\\n            {\\n                \\"when\\": \\"gravity-gun\\",\\n                \\"model\\": {\\n                    \\"type\\": \\"model\\",\\n                    \\"model\\": \\"item/gravity_gun\\"\\n                }\\n            },\\n            {\\n                \\"when\\": \\"gravity-gun-blue\\",\\n                \\"model\\": {\\n                    \\"type\\": \\"model\\",\\n                    \\"model\\": \\"item/gravity_gun_firework\\"\\n                }\\n            }\\n        ]\\n    }\\n}\\n```\\n\\n![bStats Servers](https://bstats.org/signatures/bukkit/GravityGun.svg)","body_url":null,"published":"2026-03-26T21:56:50.140187Z","updated":"2026-06-27T16:52:58.847485Z","approved":"2026-03-27T02:17:56.999650Z","queued":"2026-03-26T22:40:42.805851Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"GPL-3.0-or-later","name":"GNU General Public License v3.0 or later","url":null},"downloads":696,"followers":1,"categories":["equipment","game-mechanics","technology"],"additional_categories":["minigame"],"loaders":["paper","purpur"],"versions":["97MtaCPN","iA22Jqac","xrDCq1bK"],"icon_url":"https://cdn.modrinth.com/data/gohLXCmq/854e5f2edb2b275dbf8a4b0d7ee7500a5050377a_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/gohLXCmq/854e5f2edb2b275dbf8a4b0d7ee7500a5050377a.png","issues_url":"https://github.com/DL-03/GravityGun/issues","source_url":"https://github.com/DL-03/GravityGun","wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/gohLXCmq/images/5b9e6f947d2284354e3a0e166a5425d29de7e4ee_350.webp","raw_url":"https://cdn.modrinth.com/data/gohLXCmq/images/5b9e6f947d2284354e3a0e166a5425d29de7e4ee.png","featured":true,"title":"Gravity Gun","description":null,"created":"2026-03-26T22:36:25.449825Z","ordering":0}],"color":4282799,"thread_id":"xs4SMAY0","monetization_status":"monetized"},{"client_side":"optional","server_side":"required","game_versions":["1.21.6","1.21.7","1.21.8"],"environment":[],"id":"wlP98z8B","slug":"powercraft-2","project_type":"mod","team":"Fzk1SBXw","organization":null,"title":"Powercraft 2","description":"An RPG inspired minecraft datapack, Adding 9 new bosses!","body":"<iframe width=\\"560\\" height=\\"315\\" src=\\"https://www.youtube-nocookie.com/embed/wMBw32TSzts\\" title=\\"YouTube video player\\" frameborder=\\"0\\" allow=\\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\\" allowfullscreen></iframe>\\n\\n### **Powercraft 2**\\nA remake of Powercraft. For 1.21.8.\\nThis version includes 9 new bosses, and over 200 items for you to use!\\nAlongside a selection of reimagined and completely new classes!\\nThis pack has something for everyone!\\n\\nThe story sets as a mysterious traveler is spoken to by the cosmic void.\\nWhat adventures awaits? What stories unfold?\\nTime shall tell..","body_url":null,"published":"2025-11-12T14:38:37.638023Z","updated":"2025-11-12T14:54:21.242545Z","approved":"2025-11-13T03:43:29.707947Z","queued":"2025-11-12T15:02:57.700545Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":103,"followers":3,"categories":[],"additional_categories":[],"loaders":["datapack"],"versions":["EPKUgFRE"],"icon_url":"https://cdn.modrinth.com/data/wlP98z8B/d180a0a83a01a703bafc9027d36a86b239e85f2d.png","raw_icon_url":"https://cdn.modrinth.com/data/wlP98z8B/d180a0a83a01a703bafc9027d36a86b239e85f2d.png","issues_url":null,"source_url":null,"wiki_url":null,"discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/wlP98z8B/images/1bd6948d0f93c7d852bf085ef75073183e55de87_350.webp","raw_url":"https://cdn.modrinth.com/data/wlP98z8B/images/1bd6948d0f93c7d852bf085ef75073183e55de87.png","featured":false,"title":"Crafting","description":"What to craft... what to craft...","created":"2025-11-12T14:46:21.754962Z","ordering":0},{"url":"https://cdn.modrinth.com/data/wlP98z8B/images/08f8a2303ca5828385c5cab8e73c73e635f83c14_350.webp","raw_url":"https://cdn.modrinth.com/data/wlP98z8B/images/08f8a2303ca5828385c5cab8e73c73e635f83c14.png","featured":false,"title":"Mysterious Individual","description":"Who might they be?","created":"2025-11-12T14:46:41.837949Z","ordering":0},{"url":"https://cdn.modrinth.com/data/wlP98z8B/images/763c1f78f89e81feca9c2145efea8a3733fdc96f_350.webp","raw_url":"https://cdn.modrinth.com/data/wlP98z8B/images/763c1f78f89e81feca9c2145efea8a3733fdc96f.png","featured":false,"title":"Aftermath Wishing Lanterns","description":"A bunch of wishing lanterns in the aftermath","created":"2025-11-12T14:47:14.715493Z","ordering":0},{"url":"https://cdn.modrinth.com/data/wlP98z8B/images/2e0c33b88367b2a97abe9eab95eb91226b7007bc_350.webp","raw_url":"https://cdn.modrinth.com/data/wlP98z8B/images/2e0c33b88367b2a97abe9eab95eb91226b7007bc.png","featured":false,"title":"Mysterious Ores","description":"These strange ores spawn everywhere, but most commonly in the aftermath...","created":"2025-11-12T14:48:09.884841Z","ordering":0},{"url":"https://cdn.modrinth.com/data/wlP98z8B/images/1507036e19e118b5c00827d174740c202eb481cc_350.webp","raw_url":"https://cdn.modrinth.com/data/wlP98z8B/images/1507036e19e118b5c00827d174740c202eb481cc.png","featured":false,"title":"Battletowers!","description":"Prove your skills in these mighty fortresses found in the aftermath","created":"2025-11-12T14:48:42.978875Z","ordering":0},{"url":"https://cdn.modrinth.com/data/wlP98z8B/images/88d9f2e5c9edc224fb76b3ad3c4a138a3afc13bd_350.webp","raw_url":"https://cdn.modrinth.com/data/wlP98z8B/images/88d9f2e5c9edc224fb76b3ad3c4a138a3afc13bd.png","featured":false,"title":"It\'s dark here...","description":"An ultium geode, the first step into beginning your adventure.","created":"2025-11-12T14:49:19.940688Z","ordering":0}],"color":1854612,"thread_id":"KHccWSzC","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.21.1"],"environment":["client_and_server"],"id":"guxw1p9V","slug":"rainbow-six-siege","project_type":"modpack","team":"Kg3uLK9U","organization":null,"title":"Rainbow Six Siege","description":"Rainbow Six Siege Re-Creation Modpack","body":"## **The playable Rainbow Six Siege Modpack**\\nThis modpack includes the **Beta version** of the Rainbow Six Siege remake in Minecraft. (See features below)\\n\\n<iframe width=\\"560\\" height=\\"315\\" src=\\"https://www.youtube-nocookie.com/embed/PwGyOuY3fKA\\" title=\\"YouTube video player\\" frameborder=\\"0\\" allow=\\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\\" allowfullscreen></iframe>\\n\\n[![Get 25% Bisect Hosting Servers with code ImFunTime](https://www.bisecthosting.com/partners/custom-banners/2d9875d9-1534-4442-82dd-3e3c03f48285.webp)](https://www.imfuntime.com/bisect)\\nUse code \\"ImFunTime\\" at [https://www.bisecthosting.com/ImFunTime](https://www.imfuntime.com/bisect) for 25% off your first month!\\n\\nIt also helps support me & the project ♥️\\n\\n### Credits:\\n- Created by [FunTime](https://www.youtube.com/@ImFunTime)\\n### Features _(so far)_\\nv 1.2.0 of this modpack / world includes the following:\\n- 🗺️ **Maps** - Re-made by hand, currently includes Oregon, Coastline, Chalet & Old House\\n- ♻️ **Round Based Gameplay** - Pick, Prep, Action and Pre-Game Phases!\\n- ⚙️ **Custom Settings** - Including Round Number, Team Swapping, Friendly Fire and more!\\n- 🔊 **Enhanced Audio** - With [Presence Footsteps](https://modrinth.com/mod/presence-footsteps) & [Sound Physics Remastered](https://modrinth.com/mod/sound-physics-remastered)\\n- 🎙️ **Voice Chat** - With [Simple Voice Chat](https://modrinth.com/plugin/simple-voice-chat) & [Enhanced Groups!](https://modrinth.com/mod/enhanced-groups)\\n- 🤝 **Teams** - Attackers and Defenders!\\n- 🔫 **Guns** - From [Point Blank Jelly](https://modrinth.com/mod/pb-jelly)!\\n- 🔧 **Utility** - Working Frag Grenades, Flash Grenades, C4, Cameras, Drones and more!\\n- ⚔️ **Operators** - 19 total, 8 Attack & 11 Defense.\\n- 🧎‍♂️ **Crawling / Proning** - With [FSit](https://modrinth.com/mod/fsit)!\\n- 🩹 **DBNO** -  With [Incapacitated](https://modrinth.com/mod/incapacitated)!\\n- 🚧 **Reinforcements** - Accessible by Defenders, counters soft-breaching utility!\\n- 📌 **Objectives** - Attacker defusing + Multiple Bombsite Locations\\n- 🎮 **Controller Support** - With [Controlify](https://modrinth.com/mod/controlify)!\\n- 👥 **Multiplayer Compatible** - With [Essential](https://modrinth.com/mod/essential)!\\n- ❗ **& more!**\\n\\n\\n<details>\\n<summary>Gameplay Tips</summary>\\n  \\n  ###   How To Play\\n  - **Join the world and type ***/reload*** just to be safe**\\n  - **Type */trigger gm.*** *(if that doesn\'t work type **/scoreboard players enable @s gm** first)*\\n  - **Open world to LAN using e4mc.**\\n  - **Share the link with your friends.**\\n  - **Use the compass to start the game or change its settings.**\\n  - **Notable settings include**\\n     - Number of Rounds\\n     - Rounds Between Roll Swap\\n     - Friendly Fire\\n  - **Use the compass to select your weapons, utility, special utility & spawn locations.**\\n  - **Play the game as you\'d expect to! *(and if you don\'t know how, why are you here?)***\\n  \\n  - *Any other information can likely be found in the video at the top of the page!*\\n  - *Please report any bugs to the discord server, also at the top of the page.*\\n</details>\\n\\n\\n\\n\\n","body_url":null,"published":"2025-04-30T06:07:21.593915Z","updated":"2026-11-05T08:17:55.588026Z","approved":"2025-05-27T00:35:45.243815Z","queued":"2025-05-19T05:00:19.860183Z","status":"approved","requested_status":"unlisted","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":21566,"followers":64,"categories":["combat","multiplayer"],"additional_categories":[],"loaders":["fabric"],"versions":["IatfK8Ie","INJFpsRG","QujXNuNh","yzYM4We9","mkRCpyv0","PQr4RV7A","linGm1Tf","tfCQmiHn","dE4N9IJ2","ULgHLU7c","lxymVJ8U","tSUgitFS","i38BN8SU","kMFSpWaC","qq5rsTLs","hHRouWMp","PTVIunCN","DsNsmm74","HTEeCB3K","v8O0BAId"],"icon_