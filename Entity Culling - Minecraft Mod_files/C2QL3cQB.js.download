    is_label: \\"&fje\\"\\n      cache_logbook_title: \\"&6&lLogbook kešky\\"\\n      placed_caches_title: \\"&3Položené kešky\\"\\n      cache_no_location: \\"&c&nTato keška nemá lokaci\\"\\n      click_to_set_location: \\"&eKlikni pro nastavení lokace\\"\\n      left_click_more_info: \\"&aLeft-Click pro více info\\"\\n      right_click_edit: \\"&9Right-Click pro editaci kešky\\"\\n      shift_left_click_delete_cache: \\"&cShift + Left-Click pro smazání kešky\\"\\n      click_to_obtain: \\"&eKlikni pro získáni\\"\\n      left_click_change: \\"&eLeft-Click pro změnu &b✎\\"\\n      right_click_next: \\"&7Right-Click jít na další &c⬇\\"\\n      shift_right_click_previous: \\"&7Shift + Right-Click jít na další &a⬆\\"\\n      shift_left_click_save: \\"&2Shift + Left-Click pro uložení\\"\\n      world_label: \\"&3➥ &fSvět: &e{world}\\"\\n      xyz_label: \\"&3➥ &fX/Y/Z: &e{x}&f/&e{y}&f/&e{z}\\"\\n      bluemap_label: \\"&3➥ &fBlueMap: &r{status}\\"\\n      compass_label: \\"&3➥ &fKompas: &r{status}\\"\\n      bossbar_label: \\"&3➥ &fBossBar: &r{status}\\"\\n      beeps_label: \\"&3➥ &fBeeps: &r{status}\\"\\n      logbook_label: \\"&3➥ &fLogBook: &r{status}\\"\\n      cache_warning_no_location: \\"&4⚠ &c&nTato keška nemá lokaci &4⚠\\"\\n      found_stats: \\"&fNalezeno: &a{found} &7/ &2{total} &7({percentage}%&7)\\"\\n      page_navigation_next: \\"&6Další strana\\"\\n      page_navigation_previous: \\"&6Předchozí strana\\"\\n\\n  items:\\n    cache_name: \\"&aKeška\\"\\n    cursed_pumpkin: \\"&6Cursed Pumpkin\\"\\n\\n  configuration:\\n    config_reloaded: \\"&aKonfigurace byla znovunačtena\\"\\n    invalid_egg_hunt_type: \\"&4Neplatný typ egg-hunt.type v configu! Nastavuji na EASTER\\"\\n    invalid_egg_type: \\"&4Neplatný typ vejce &f{name} &4v storage.yml! Nastavuji na EASTER\\"\\n\\n  success:\\n    successfully_modified: \\"&aÚspěšně upraveno!\\"\\n\\n  debug:\\n    bluemap_adding_marker_set: \\"&7Přidávám marker-set na mapu &f{map_name}\\"\\n    random_spawn_skipped: \\"&eNáhodný spawn přeskočen. Hráči online: &f{online}&e/&f{min_players}&e.\\"\\n    random_spawn_url: \\"&7URL: &f{url}\\"\\n    random_spawn_no_textures: \\"&cNejsou nakonfigurované žádné textury pro náhodný spawn, přeskakuji spawn.\\"\\n    random_spawn_texture_not_found: \\"&cTextura náhodného spawnu není v úložišti, přeskakuji spawn.\\"\\n    random_spawn_location_not_air: \\"&cLokace náhodného spawnu není vzduch, vyčistěno a znovupoužití spawnu.\\"\\n    random_spawn_location: \\"&fNáhodný spawn: X: &f{x} &fY: &f{y} &fZ: &f{z} &fSvět: &f{world}\\"\\n    player_found_item: \\"&fHráč &e{player} &fnal předmět na &f{world} {x} {y} {z}. Statistika: &f{found}&e/&f{total}\\"\\n    pumpkin_helm_reverting: \\"&7VRÁCENÍ PRO &f{player}\\"\\n    pumpkin_helm_no_lock: \\"&7NÁVRAT BEZ ZÁMKU\\"\\n    pumpkin_helm_original: \\"&7PŮVODNÍ &f{state}\\"\\n    pumpkin_helm_update_1: \\"&7AKTUALIZACE1\\"\\n    pumpkin_helm_update_3: \\"&7AKTUALIZACE3\\"\\n    no_egg_at_location: \\"&cNa lokaci nebyl nalezen žádný dárek\\"\\n    adding_marker_to_queue: \\"&7Přidávám marker do fronty\\"\\n    egg_load_world_not_found: \\"&4Nepodařilo se načíst vejce na lokaci: &f{location} &4- svět neexistuje. Odebráno z konfigurace!\\"\\n    egg_load_invalid_block: \\"&4Nepodařilo se načíst vejce na lokaci: &f{location} &4- blok není PLAYER_HEAD. Odebráno z konfigurace!\\"\\n    texture_debug: \\"&7- &e{texture_name} &7(&f{texture_data}&7)\\"\\n    save_storage_failed: \\"&4Nepodařilo se uložit konfiguraci storage.yml\\"\\n    save_player_storage_failed: \\"&4Nepodařilo se uložit konfiguraci player-storage.yml\\"\\n    random_spawn_save_failed: \\"&4Chyba při ukládání random spawn lokace do random-spawns.yml!\\"\\n    random_spawn_remove_failed: \\"&4Chyba při odstraňování random spawn lokace z random-spawns.yml!\\"\\n    backup_created: \\"&aZáloha byla úspěšně vytvořena ve složce: &f{folder}\\"\\n    backup_failed: \\"&4Nepodařilo se vytvořit zálohu: &f{error}\\"\\n    treasure_loading: \\"&7Načítám lokaci pokladu: &f{location}\\"\\n    treasure_is_null: \\"&cJE NULL!\\"\\n    treasure_load_failed: \\"&4Nepodařilo se načíst poklad na lokaci: &f{location} &4- odebráno z konfigurace!\\"\\n    treasure_adding: \\"&fPřidávám lokaci &f{location}\\"\\n    location_parsed: \\"&7Analyzovaná lokace: 1=&f{loc1} &72=&f{loc2} &73=&f{loc3} &74=&f{loc4} &75=&f{loc5}\\"\\n```\\n        \\n</details>\\n\\n<details>\\n  <summary>config.yml</summary>\\n  \\n```yaml\\nprefix:\\n    geocaching: \\"&7[&bGeocaching&7] &r\\"\\n    easter: \\"&7[&eEggHunt&7] &r\\"\\n    halloween: \\"&7[&6Halloween&7] &r\\"\\n    christmas: \\"&7[&bChristmas&7] &r\\"\\n\\ndebug: false\\n\\ndev:\\n    disable-egghunt: false # If true, egg-hunt is completely disabled\\n    disable-geocaching: false # If true, geocaching is completely disabled\\n\\negghunt:\\n    # If false, it will not be possible to find eggs\\n    enabled: true\\n\\n    type: \\"EASTER\\"\\n\\n    # If true, the player receives a reward for finding all eggs\\n    all_eggs_found_reward: false\\n\\n    # Random reward for finding all eggs\\n    all_eggs_found_random_reward: false\\n\\n    # Rewards for finding all eggs\\n    all_eggs_found_rewards:\\n        - \\"minecraft:me &aPlayer %player% found all eggs!\\"\\n        - \\"give %player% diamond 1\\"\\n\\n    # Message displayed when player finds all eggs\\n    # Set to \\"\\" to disable message\\n    all_eggs_found_message: \\"&aCongratulations! You found all eggs!\\"\\n\\nrandom_spawns:\\n    # If true, eggs will spawn at random locations\\n    enabled: false\\n\\n    icon_set:\\n        green: \\"https://r2.xap3y.eu/media/L5Z2DXK8\\"\\n        yellow: \\"https://images.minecraft-heads.com/render3d/head/8b/8b2d5935dbc88de24fb4685ac254edde.webp\\"\\n\\n    period: 7200 # in seconds (1 hour)\\n\\n    duration: 200 # in seconds (3 minutes)\\n\\n    # BlueMap URL mapping, %x%, %y%, %z% and %zoom% will be replaced with actual values\\n    url_mapping:\\n        \\"spawn\\": \\"https://survival-map.example.com.cz/#pawn:%x%:%y%:%z%:%zoom%:0:0:0:0:perspective\\"\\n        \\"world\\": \\"https://survival-map.example.com/#spawn:%x%:%y%:%z%:%zoom%:0:0:0:0:perspective\\"\\n\\n    bluemap:\\n        label: \\"present\\"\\n\\n    textures:\\n        - \'R:^xmas_.*\' # Configure textures in storage.yml\\n\\n    min_players: 5\\n\\n    animation_pool: \\"CHRISTMAS\\"\\n    random_rewards: [ ]\\n    rewards: [ ]\\n\\n    messages:\\n        prefix: \\"&#EB4444&lV&#F2792D&lá&#F8AE17&ln&#FFE300&lo&#80C20C&lc&#00A018&le &c&l>>&r \\"\\n        noone_found: \\"<color:#ff4d4d>No one found the random gift in time.</color>\\"\\n        found: \\"<color:#00ff00>Player</color> &e&l%player% &a&lfound a random gift!\\"\\n        hunt: \\"<color:#FFE500>A random gift appeared on the map, be the first to find it!</color> &r&l-&r <color:#FFD54F>You can find the gift in</color> %button%\\"\\n        button: \\"<b><color:#ffeb3b>THIS AREA</color></b>\\"\\n        button_tooltip: \\"&#ffeb3bClick to display the area on the map!\\"\\n\\ngeocaching:\\n\\n    icon: \\"http://localhost:8004/geocache.svg\\"\\n\\n    #found: \\"You found treasure %name%!\\"\\n    found: null # to disable message\\n\\n    enabled: true\\n\\n    # If the player is further than N blocks, it will not report treasure\\n    minimum_distance: 120\\n\\n# Statistics GUI:\\nstats_gui:\\n    enabled: true\\n\\n    title: \\"§6§lStats\\"\\n\\n    regions:\\n        worlds:\\n            - mine\\n        allowed:\\n            - \\"mine-swamp\\"\\n\\n    button_text: \\"§7[§e§lPROGRESS§7]\\"\\n\\n    # https://minecraft-heads.com/custom-heads/head/67147-chat-question-mark\\n    unknown_texture: \\"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvZDVkMjAzMzBkYTU5YzIwN2Q3ODM1MjgzOGU5MWE0OGVhMWU0MmI0NWE5ODkzMjI2MTQ0YjI1MWZlOWI5ZDUzNSJ9fX0=\\"\\n\\n    presets:\\n        \\"spawn\\":\\n            display_name: \\"&bSpawn\\"\\n            icon: \\"TALL_GRASS\\"\\n        \\"world\\":\\n            display_name: \\"&aSurvival World\\"\\n            texture: \\"eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvMzQ5YzYzYmM1MDg3MjMzMjhhMTllNTk3ZjQwODYyZDI3YWQ1YzFkNTQ1NjYzYWMyNDQ2NjU4MmY1NjhkOSJ9fX0=\\"\\n\\n```\\n\\n</details>","body_url":null,"published":"2026-03-29T17:36:33.886082Z","updated":"2026-10-23T21:28:29.121014Z","approved":"2026-04-17T20:54:05.254374Z","queued":"2026-04-15T08:40:05.781906Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"MIT","name":"MIT License","url":"https://github.com/xap3y/EggHunt?tab=MIT-1-ov-file"},"downloads":215,"followers":5,"categories":["adventure"],"additional_categories":["decoration","utility"],"loaders":["paper","purpur","spigot"],"versions":["lpPi2zMf","UbsWClJO","47Qfp5Vm","4ruFN8Cv"],"icon_url":"https://cdn.modrinth.com/data/G81C0iBX/089d2aef9f0d0ba79a3b29a5fdd092f2ea25e00e.webp","raw_icon_url":"https://cdn.modrinth.com/data/G81C0iBX/089d2aef9f0d0ba79a3b29a5fdd092f2ea25e00e.webp","issues_url":"https://github.com/xap3y/EggHunt/issues","source_url":null,"wiki_url":"https://plugins.xap3y.eu/egghunt","discord_url":null,"donation_urls":[{"id":"bmac","platform":"Bmac","url":"https://buymeacoffee.com/xap3y"},{"id":"ko-fi","platform":"Ko-fi","url":"https://ko-fi.com/xap3y"}],"gallery":[{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/3889d83ad75fa482fcddff2a43f810212d383b33_350.webp","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/3889d83ad75fa482fcddff2a43f810212d383b33.png","featured":false,"title":null,"description":null,"created":"2026-10-22T21:54:31.624227Z","ordering":-6},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/4df3f6f19e8a8aefb33fad6cf391d15294ad323d.png","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/4df3f6f19e8a8aefb33fad6cf391d15294ad323d.png","featured":false,"title":null,"description":null,"created":"2026-10-22T21:53:40.626931Z","ordering":-5},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/e0e5731da2b87c8859b5f5802b8aa6e60d31cbc4.png","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/e0e5731da2b87c8859b5f5802b8aa6e60d31cbc4.png","featured":false,"title":null,"description":null,"created":"2026-10-22T21:54:04.111140Z","ordering":-4},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/af6a1d7a55938ae939cac4e5bbac7b82822f711f.gif","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/af6a1d7a55938ae939cac4e5bbac7b82822f711f.gif","featured":false,"title":"EggHunt GUI","description":null,"created":"2026-03-29T18:50:43.675445Z","ordering":-3},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/44e9e939fedc3476133945889d9316227c75e7b9_350.webp","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/44e9e939fedc3476133945889d9316227c75e7b9.png","featured":false,"title":null,"description":null,"created":"2026-10-22T21:59:08.295993Z","ordering":-2},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/24f072df5e096e5215a2e61df0eee97bfbea1a35_350.webp","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/24f072df5e096e5215a2e61df0eee97bfbea1a35.png","featured":false,"title":null,"description":null,"created":"2026-10-22T22:00:12.307300Z","ordering":-1},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/1089fd64eba4cb15d5e4cde72a92bc14dd24943c.gif","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/1089fd64eba4cb15d5e4cde72a92bc14dd24943c.gif","featured":true,"title":"Christmas animation","description":null,"created":"2026-03-29T17:44:05.421806Z","ordering":0},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/9d8b884f3cd7174288dda49033afd45d67beb0d5_350.webp","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/9d8b884f3cd7174288dda49033afd45d67beb0d5.png","featured":false,"title":"Placed Egg","description":null,"created":"2026-03-29T18:26:35.512868Z","ordering":0},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/00c57b7fc420449c695662141ba4c597220ca247_350.webp","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/00c57b7fc420449c695662141ba4c597220ca247.png","featured":false,"title":"Egg category view","description":null,"created":"2026-03-29T18:36:44.433594Z","ordering":0},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/fcd3770e13cd963f47c8bf6430cc1a9625b24bad.png","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/fcd3770e13cd963f47c8bf6430cc1a9625b24bad.png","featured":false,"title":"Progression preview","description":null,"created":"2026-03-29T18:37:02.773443Z","ordering":0},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/55e46fa2415b8639be5e14896528da2373bcb871.gif","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/55e46fa2415b8639be5e14896528da2373bcb871.gif","featured":false,"title":"Geocaching GUI","description":null,"created":"2026-03-29T18:55:17.849696Z","ordering":0},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/ea4f50044356ed735fa8357c76dd5ca87a394e80_350.webp","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/ea4f50044356ed735fa8357c76dd5ca87a394e80.png","featured":false,"title":null,"description":null,"created":"2026-10-22T22:00:32.239988Z","ordering":0},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/73680df7f40ad96b7bef9239ca4d74d44d842d14_350.webp","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/73680df7f40ad96b7bef9239ca4d74d44d842d14.png","featured":false,"title":null,"description":null,"created":"2026-10-22T22:01:24.960150Z","ordering":0},{"url":"https://cdn.modrinth.com/data/G81C0iBX/images/749aa0550e2334a573d1f6d88e43241fea6fd33d_350.webp","raw_url":"https://cdn.modrinth.com/data/G81C0iBX/images/749aa0550e2334a573d1f6d88e43241fea6fd33d.png","featured":false,"title":null,"description":null,"created":"2026-10-22T22:01:32.712872Z","ordering":0}],"color":10308868,"thread_id":"NTx9T45b","monetization_status":"monetized"},{"client_side":"optional","server_side":"required","game_versions":["1.21.11","26.1","26.3"],"environment":["server_only","unknown"],"id":"5qD9FMoH","slug":"prisma-craft","project_type":"mod","team":"cFpNG1Q2","organization":null,"title":"Prisma Craft","description":"A massive project that greatly complements the idea of ​​Prismarine and improves the mechanics of fishing. New tools, armor, blocks, mobs, mechanics and structures.","body":"## 💡Main idea\\nPrismarine in the game is a rather interesting material, with a dungeon, several mobs, and even a whole lore. However, crafting a few blocks is all that ends... To improve the functionality of prismarine, this datapack was developed! Now you can craft new tools, armor, blocks, and decorations from prismarine. Fishing mechanics have also been improved, as well as the loot list. Along with this, quite a few new structures and even mechanics have been added.\\n\\n## \\n## 🎞Official video review:\\n<iframe width=\\"560\\" height=\\"315\\" src=\\"https://www.youtube-nocookie.com/embed/nlslcGs5SXY\\" title=\\"YouTube video player\\" frameborder=\\"0\\" allow=\\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\\" allowfullscreen></iframe>\\n\\n## \\n## ✨Main changes and innovations\\n- Items while fishing have been improved.\\n- Added spearfishing mechanics.\\n- Added several interesting mobs.\\n- Added many interesting underwater structures.\\n- Thanks to the Sea Workbench, you can craft Prismarine tools.\\n- Another miniboss has been added to the Monument.\\n\\n## \\n## 📚WIKI\\nYou can get all the information you need from the book that fishermen sell in the villages. Along with this, the project has its own [WIKIpedia](https://bigsty.github.io/PrismaWIKI/index.html) with all the details and without ads. WIKI is only translated into Russian, but you can use Google\'s website translator.\\n\\n## \\n## 🆘Important information\\n- **THE ENTIRE DATAPACK HAS BEEN TRANSLATED INTO 3 LANGUAGES**: English, Ukrainian, Russian. Translation works depending on the selected language in the game. \\n- Project does **NOT NEED Optifine** or other mods.\\n\\n## \\n## 🔗Links\\n- PMC for make a comments.\\n- [![PMC](https://cdn.modrinth.com/data/cached_images/e595800aee90e27a4728047484b8046b4dfc6d88.png)](https://www.planetminecraft.com/data-pack/prisma-craft-2-0/)\\n- Discord page for report bugs.\\n- [![DISCORD](https://cdn.modrinth.com/data/cached_images/9074808b32569f303fb9d4a01a3c7cccff42fe16_0.webp)](https://discord.com/channels/1083437559780216923/1477372058957774879)\\n- Site with all the author\'s main projects.\\n- [![PROJECTS](https://cdn.modrinth.com/data/cached_images/7d1a8a5b787b960baf5cb1eb40a4c625df075c64_0.webp)](https://bigsty.github.io/main_site/)\\n\\n","body_url":null,"published":"2026-01-17T17:33:54.613413Z","updated":"2026-10-17T14:40:25.264360Z","approved":"2026-01-21T05:16:56.637324Z","queued":"2026-01-18T00:19:37.154966Z","status":"approved","requested_status":"private","moderator_message":null,"license":{"id":"LicenseRef-All-Rights-Reserved","name":"","url":null},"downloads":8806,"followers":111,"categories":["adventure","equipment","game-mechanics"],"additional_categories":["decoration","food","mobs","worldgen"],"loaders":["datapack","fabric","forge","neoforge","quilt"],"versions":["g3PK68HA","eMtsjK56","AgcGNUoN","VyNng2Dc","8zVWBvZE","CBUh8fX5"],"icon_url":"https://cdn.modrinth.com/data/5qD9FMoH/a7046ef524c362d98bb966feda02f8f57e92fd2f_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/5qD9FMoH/a7046ef524c362d98bb966feda02f8f57e92fd2f.png","issues_url":"https://discord.com/channels/1083437559780216923/1477372058957774879","source_url":null,"wiki_url":"https://bigsty.github.io/PrismaWIKI/index.html","discord_url":null,"donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/5qD9FMoH/images/97f5db6976ca7776e82d8529ba77b46b9122d9d7_350.webp","raw_url":"https://cdn.modrinth.com/data/5qD9FMoH/images/97f5db6976ca7776e82d8529ba77b46b9122d9d7.png","featured":false,"title":"poster","description":null,"created":"2026-03-11T09:44:05.809251Z","ordering":0},{"url":"https://cdn.modrinth.com/data/5qD9FMoH/images/b79d0df7cab688c0080cb5c9e716ae126dba1c2b_350.webp","raw_url":"https://cdn.modrinth.com/data/5qD9FMoH/images/b79d0df7cab688c0080cb5c9e716ae126dba1c2b.png","featured":false,"title":"Structures","description":null,"created":"2026-03-14T22:52:42.200436Z","ordering":0},{"url":"https://cdn.modrinth.com/data/5qD9FMoH/images/f30da941903ff2c82f0666bb30329191ff0b1769_350.webp","raw_url":"https://cdn.modrinth.com/data/5qD9FMoH/images/f30da941903ff2c82f0666bb30329191ff0b1769.png","featured":false,"title":"New blocks (tools and decorative)","description":null,"created":"2026-03-14T22:54:37.740225Z","ordering":0},{"url":"https://cdn.modrinth.com/data/5qD9FMoH/images/2eb7422717ebda0779d5172093140d1a7cda5669_350.webp","raw_url":"https://cdn.modrinth.com/data/5qD9FMoH/images/2eb7422717ebda0779d5172093140d1a7cda5669.png","featured":true,"title":"Mini boss","description":null,"created":"2026-03-14T22:52:56.489473Z","ordering":1},{"url":"https://cdn.modrinth.com/data/5qD9FMoH/images/523edc171a8e0880b6d00a469739dd410f5f79f6_350.webp","raw_url":"https://cdn.modrinth.com/data/5qD9FMoH/images/523edc171a8e0880b6d00a469739dd410f5f79f6.png","featured":false,"title":"Many items","description":null,"created":"2026-03-14T22:53:08.242124Z","ordering":1},{"url":"https://cdn.modrinth.com/data/5qD9FMoH/images/42ecd14891a476392bc9758904be6670c92e4cd1_350.webp","raw_url":"https://cdn.modrinth.com/data/5qD9FMoH/images/42ecd14891a476392bc9758904be6670c92e4cd1.png","featured":false,"title":"Jellyfish (like ... many)","description":null,"created":"2026-03-14T22:53:49.683948Z","ordering":4},{"url":"https://cdn.modrinth.com/data/5qD9FMoH/images/10bb2163b0341b5e4de5648e3a422cf6978d4894_350.webp","raw_url":"https://cdn.modrinth.com/data/5qD9FMoH/images/10bb2163b0341b5e4de5648e3a422cf6978d4894.png","featured":false,"title":"Crabs...","description":null,"created":"2026-03-14T22:53:21.853926Z","ordering":5},{"url":"https://cdn.modrinth.com/data/5qD9FMoH/images/8bf4e7dc5290b2803c83236595281a35b498c2f0_350.webp","raw_url":"https://cdn.modrinth.com/data/5qD9FMoH/images/8bf4e7dc5290b2803c83236595281a35b498c2f0.png","featured":false,"title":"not one mechanics","description":null,"created":"2026-03-14T22:54:57.508092Z","ordering":6},{"url":"https://cdn.modrinth.com/data/5qD9FMoH/images/0a67b301a8dc6e04c905ed7abbe105cf42adfdad_350.webp","raw_url":"https://cdn.modrinth.com/data/5qD9FMoH/images/0a67b301a8dc6e04c905ed7abbe105cf42adfdad.png","featured":false,"title":"Altar","description":null,"created":"2026-01-18T11:45:45.995426Z","ordering":9}],"color":8303280,"thread_id":"6ro46KCp","monetization_status":"monetized"},{"client_side":"optional","server_side":"required","game_versions":["1.21.10","1.21.11","1.21.9","26.1"],"environment":["client_and_server","unknown"],"id":"RIVSZ9Ee","slug":"spare-no-items","project_type":"mod","team":"L3ORd9dH","organization":null,"title":"Spare No Items","description":"Expands the functionality of single-use vanilla items with fresh new features!","body":"⚠️ IMPORTANT: USAGE GUIDELINES  \\nIf you\'re planning to use this on a server or modpack,  \\nplease refer to:  \\nhttps://gamedash43.github.io/dash-mcl-licenses/#usage\\n\\n\\n![Title Text saying \\"Spare No Items\\"](https://cdn.modrinth.com/data/cached_images/66acd5050b931e4f516da9ddfaff3d4ef00eb66d.png)\\n\\nExpands the functionality of single-use vanilla items with fresh new features.\\n\\nThis addon enhances items that previously had only one use, giving them new purposes while maintaining the vanilla gameplay feel.\\n\\n# Features\\n- Adds additional uses to single-use vanilla items  \\n- Preserves balance and compatibility with the base game  \\n- Integrates with existing mechanics  \\n\\n### Functional Blocks\\n\\n<details>\\n<summary>Diffuser</summary>\\n\\nA utility block that can create lingering potion clouds on demand.  \\nBefore charging it, you must right-click it with any potion, including modded potions.  \\nAfterwards, the blaze rod on top should start glowing.\\n\\nYou can then charge it with Dragon’s Breath items, storing up to 4 charges.  \\nWhen right-clicked or when the bottom is powered with redstone, a small cloud of the placed potion forms above it for 5 minutes, with a 1/3 chance for a Dragon’s Breath to be consumed.\\n\\nPlace a hopper facing into the top to automatically feed Dragon’s Breath into it.\\n\\n![Diffuser Recipe](https://cdn.modrinth.com/data/cached_images/dc366ae2791eab20e49ba0ebad397caa7d10bd81_0.webp)\\n\\n</details>\\n\\n<details>\\n<summary>Shell Nest</summary>\\n\\nA block that can store 1 small mob for transport and safe keeping.  \\nTo store a mob, move it onto the top of the block and right-click the block.\\n\\nTamed mobs can only be stored by their owner.  \\nYou can mine the Shell Nest to pick it up and transport the stored mob.  \\nPlace it back down and right-click to release the stored mob.\\n\\n![Shell Nest Recipe](https://cdn.modrinth.com/data/cached_images/7933794bd098de051d5c983bf680c598a4d77137.png)\\n\\nSupported mobs:\\n- Shulker\\n- Bat\\n- Bee\\n- Cat\\n- Chicken\\n- Cow\\n- Fox\\n- Frog\\n- Mooshroom\\n- Ocelot\\n- Panda\\n- Parrot\\n- Pig\\n- Rabbit\\n- Sheep\\n- Strider\\n- Phantom\\n- Turtle\\n- Wolf\\n- Armadillo\\n- Allay\\n- Squid\\n- Glow Squid\\n- Dolphin\\n- Goat\\n- Nautilus\\n- Zombie Nautilus\\n- Silverfish\\n- Endermite\\n- Guardian\\n\\n\\n</details>\\n<details>\\n<summary>Beamstone</summary>\\n\\nA special block designed for long-distance item transportation.  \\nPlace it facing the direction you want items to travel, then right-click the top with any beacon payment item until a beam activates.  \\n\\nOnce the beam connects with another block, the Beamstone becomes linked to that location.  \\nAny item entity thrown onto the back of the Beamstone will be instantly teleported to the beam’s endpoint.  \\n\\n![Beamstone Recipe](https://cdn.modrinth.com/data/cached_images/afc194c5eca9f70badddf047a5443c430cbf3a62_0.webp)\\n\\n</details>\\n\\n<details>\\n<summary>Glow Torch</summary>\\n\\nA torch that can be placed underwater as well as on land.  \\nWhen an entity stands inside it, it briefly gains the glowing effect.\\n\\n![Glow Torch Recipe](https://cdn.modrinth.com/data/cached_images/3fec626cb529df990753c42acc00a37614c973d9_0.webp)\\n\\n</details>\\n\\n<details>\\n<summary>Warding Anchor</summary>\\n\\nA beacon-like defensive structure that protects an area around it from common explosion griefing.  \\nWithin its radius, it protects against TNT, creepers, ghast fireballs, end crystals, and respawn anchor or bed explosions in the wrong dimension.\\n\\n![Recipe for Warding Anchor](https://cdn.modrinth.com/data/cached_images/2ff52614b46a458e4db62abead79220b99f0e304.png)\\n\\nThere are 4 tiers, like a beacon. Tier 1 is with no gold blocks; see rest below. \\nRadius by tier:\\n- Tier 1: 8 block radius  \\n- Tier 2: 16 block radius  \\n\\n![Warding Anchor Multiblock Tier 1](https://cdn.modrinth.com/data/cached_images/53259c9f78441d011b90ceca1687726e12381bb7.png)\\n\\n- Tier 3: 24 block radius \\n\\n![Warding Anchor Multiblock Tier 2](https://cdn.modrinth.com/data/cached_images/d145608d212f1e9c7714222a8b8823fc3f481e9b.png)\\n\\n- Tier 4: 32 block radius  \\n\\n![Warding Anchor Multiblock Tier 3](https://cdn.modrinth.com/data/cached_images/72630302ba6abeec7e08209b7f591b302abf03eb.png)\\n\\nNote: respawn anchor and bed explosions are not fully foolproof.  \\nIf you intentionally try and break blocks with repeated attempts, you can still break things, but under normal gameplay it is effectively impossible.\\n\\n</details>\\n\\n\\n<details>\\n<summary>Rough Mat</summary>\\n\\nA block that stops motion on first contact.  \\nWhen a player or mob steps onto it for the first time, all motion is removed, but after initial contact they can move normally while on it.  \\nAdditionally, while a player or mob is standing on the Rough Mat they take no knockback.\\n\\n![Normal Rough Mat Recipe](https://cdn.modrinth.com/data/cached_images/cd84f7ad9cdf9d020a4b00b8bcb3bb1b037b6281.png)\\n\\n![Rotten Rough Mat Recipe](https://cdn.modrinth.com/data/cached_images/29c1382010fd12654fc5398ca105be559c8a9275.png)\\n\\n</details>\\n\\n\\n<details>\\n<summary>Phantom Item Frame</summary>\\n\\nWhen an item is placed inside, the frame turns invisible.\\n\\n![Recipe for the Phantom Item Frame](https://cdn.modrinth.com/data/cached_images/6e0d67d921a4e77d200edbe835301cd8b458ff42.png)\\n\\n</details>\\n\\n\\n\\n### Food\\n\\n<details>\\n<summary>Fermented Phantom Membrane</summary>\\n\\nWhen eaten while you have active potion effects (excluding beacon effects), it makes all potion particles completely invisible.  \\nThe item is consumed on use.\\n\\n![Recipe for Fermented Phantom Membrane](https://cdn.modrinth.com/data/cached_images/dd17f8d4ba24079fb4cc0979af9e1e92cd1974c8_0.webp)\\n\\n</details>\\n\\n<details>\\n<summary>Crunchy Ice Salad</summary>\\n\\nFeed this to an adult happy ghast to double its speed for 5 minutes.\\n\\n![Crunchy Ice Salad Recipe](https://cdn.modrinth.com/data/cached_images/1927f5630378fe191a8e5e13357aeca253e24b42.png)\\n\\n</details>\\n\\n\\n<details>\\n<summary>Sticky Stew</summary>\\n\\nWhen fed to a baby mob, it keeps the mob as a baby permanently.\\n\\n![Recipe for Sticky Stew](https://cdn.modrinth.com/data/cached_images/dc2230951a106b876a5742192618a2cbdbe928b9.png)\\n\\n</details>\\n\\n\\n<details>\\n<summary>Shattered Nether Star</summary>\\n\\nWhen used, it is consumed and grants the player all beacon effects at maximum level for 16 seconds.  \\nIt also restores the player\'s health and saturation to full.  \\nThe item has no cooldown between uses.\\n\\n![Shattered Nether Star Recipe](https://cdn.modrinth.com/data/cached_images/c491f963469bb1d9235d69c386ae34974c310ec2.png)\\n\\n</details>\\n\\n<details>\\n<summary>Glistering Salad</summary>\\n\\nAn instant-eat item that restores a portion of the player\'s health.  \\nIt has a one second cooldown between uses.\\n\\n![Glistering Salad Recipe](https://cdn.modrinth.com/data/cached_images/dc63785107607d00d454a607fa6f60e34c9f4b9c.png)\\n\\n</details>\\n\\n<details>\\n<summary>Dried Rotten Flesh</summary>\\n\\nCrafts into leather, requiring four pieces. (Rabbit hide)  \\nCan be eaten for 3 hunger with no saturation, takes 2x as long to eat as typical foods, and does not cause the Hunger effect.\\n\\n![Dried Rotten Flesh Recipe](https://cdn.modrinth.com/data/cached_images/2040688d9359534c9db3c288c43c010a396b8960.png)\\n\\n![Dried Rotten Flesh to Leather](https://cdn.modrinth.com/data/cached_images/bb18610f2a68930ace73ca3d1ab72a23b48ec0f4.png)\\n\\n</details>\\n\\n\\n\\n### Utility Items\\n\\n<details>\\n<summary>Breath Charge</summary>\\n\\nRight-click this onto a block to spawn a small cloud of Dragon’s Breath.  \\nYou cannot use it to collect Dragon’s Breath from the cloud.\\n\\nWhen used in a dispenser, it becomes a powerful projectile that selects a target within 32 blocks and has extremely accurate targeting towards it.  \\nBe careful, as this could include the player that placed it.\\n\\n![Breath Charge Recipe](https://cdn.modrinth.com/data/cached_images/9b5ad6583a1000c4e58b7fc71e48d0aa488ba47d_0.webp)\\n\\n</details>\\n\\n<details>\\n<summary>Radiance Upgrade</summary>\\n\\nAdd this onto any equipment made of a material that can be a beacon base block, such as gold, netherite, and more.  \\nYou can obtain the Smithing Template occasionally when killing Withers, as long as the Wither’s death was caused by a player.  \\nWhen equipped or held, it applies a beacon effect to that related item at the lowest level, constantly, apart from regeneration.\\n\\nHelmet: regeneration  \\nChestplate: resistance  \\nLeggings: speed  \\nBoots: jump boost  \\nWeapons: strength  \\nTools: haste  \\n\\n![Dupe Recipe for Radiance Upgrade](https://cdn.modrinth.com/data/cached_images/9c43a6392561d5f1416213b75dd6567840bd8451_0.webp)\\n\\n![To Use Radiance Upgrade](https://cdn.modrinth.com/data/cached_images/3928b2dbba14c854b9e12532051e6f5d51e07ee2.png)\\n\\n</details>\\n\\n<details>\\n<summary>Sea Compost</summary>\\n\\nA permanent bonemeal-like item for farming.  \\nPlace it on tilled farmland, and crops planted on it get regular boosts to growth for all vanilla crops.\\n\\nIf the crop is already fully grown and it tries to boost it, there is a 10% chance for it to drop the crop’s item without breaking the crop.  \\nBe careful, as it washes away when in rain, so use greenhouse-like structures.\\n\\nThere are two recipe variants, and the one with tropical fish increases yield significantly.  \\nBoth function identically.\\n\\n\\n![Recipe Sea Compost Special](https://cdn.modrinth.com/data/cached_images/ad140888135b376727e32ebe2f8164df5daf04af_0.webp)\\n\\n![Use any Fish Sea Compost](https://cdn.modrinth.com/data/cached_images/5fe0bc448ea94a99a5238f0cfee72b37c5e4cfa4_0.webp)\\n\\n</details>\\n\\n<details>\\n<summary>Undying Upgrade</summary>\\n\\nAdd this to any equipment to make it invulnerable while it is on the ground.  \\nYou can find the Smithing Template rarely when brushing suspicious sand or gravel in cold ocean ruins.  \\nThe item becomes immune to all damage, including lava, cactus, the void, and more, and it no longer despawns.\\n\\nA cloud of bubbles forms around the item when it is on the ground.\\n\\n![Undying Upgrade Dupe](https://cdn.modrinth.com/data/cached_images/0d15c49fde24cf64ef0c6d37928705a1190561bc_0.webp)\\n\\n![Use Undying Upgrade](https://cdn.modrinth.com/data/cached_images/4470c0f0db2b52ce4e2bc233ce721d1ec93d92f7.png)\\n\\n</details>\\n\\n<details>\\n<summary>Resin Coated Shell / Petrified Shell</summary>\\n\\nCraft the Resin Coated Shell and place it on a clay block.  \\nAfter about 3 to 4 in-game days, it will transform into a piece of suspicious sand containing a Petrified Shell.\\n\\nThe Resin Coated Shell can also be placed directly underwater on sand or gravel to create a suspicious sand or gravel block.\\n\\nUse the Petrified Shell on an item to make that item not despawn, invulnerable, and unable to be picked up by players.\\n\\n![Resin Coated Shell Recipe](https://cdn.modrinth.com/data/cached_images/75958fabd03e75fdabfdf002ae40c8545e08a831.png)\\n\\n</details>\\n\\n<details>\\n<summary>Soul Echo Upgrade</summary>\\n\\nFind the Smithing Template in Ancient City chests.  \\nUse it at a smithing table with almost any equipment to apply the \\"Echoed\\" upgrade.  \\nBy default, this upgrade is a one-time use (configurable in `data/dash.sni/function/config.mcfunction`).\\n\\nWhen a player dies with an Echoed item in their inventory, that item remains with them after death.\\n\\n![Soul Echo Upgrade on Diamond Axe](https://cdn.modrinth.com/data/cached_images/d29152b8f9ccb6657bf68037d1b5f9edd35cfb56.png)\\n\\n![Soul Echo Upgrade Smithing Template Recipe](https://cdn.modrinth.com/data/cached_images/d99b283f56c255530e9a7b9f5bb8dd14028ac1d0.png)\\n\\n</details>\\n\\n\\n\\n### Equipment\\n\\n<details>\\n<summary>Amethyst Pick</summary>\\n\\nA throwable block-mining tool.  \\nWhen thrown, it travels a long distance and mines the block that it hits.\\n\\nIf you break a block near you with it, it brings the dropped item to you.  \\nThe item is single use.\\n\\n![Recipe Amethyst Pick](https://cdn.modrinth.com/data/cached_images/b72f6d395b4f91e99d84df6b0d77f266f9be6d1d_0.webp)\\n\\n</details>\\n\\n<details>\\n<summary>Shulker Shield</summary>\\n\\nAn alternative version of the standard shield.  \\nIt blocks all projectiles like a normal shield, but instead of reducing incoming damage, it grants the user 20 armor points and 8 armor toughness while in use.\\n\\nThe Shulker Shield is unbreakable.  \\nWhen used while looking downward and landing, it negates all fall damage and causes nearby entities to experience a brief levitation effect.\\n\\n![Shulker Shield Recipe](https://cdn.modrinth.com/data/cached_images/7075775eb0ecf82e6a634ed77b687dd93212a739.png)\\n\\n</details>\\n","body_url":null,"published":"2025-10-02T23:57:18.511966Z","updated":"2026-03-25T21:18:18.495832Z","approved":"2025-10-11T07:50:32.179397Z","queued":"2025-10-11T00:52:57.816689Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"LicenseRef-Dash-MCL-ND-1.0-License","name":"","url":"https://gamedash43.github.io/dash-mcl-licenses/#nd"},"downloads":3780,"followers":40,"categories":["decoration","game-mechanics","utility"],"additional_categories":[],"loaders":["datapack","fabric","forge","neoforge","quilt"],"versions":["ahI9FOto","mhsLKolV","Nunb2BxO","RAnzWQhQ","sqhQ5OS4","9gv9Qmfk","5XV8wvXI","JTnqGiWg","4NVu6MRa","LAbGvIdM","dDIl4pfv","y8VBWKTC","zv87c8ED","D5XCApKc","gAYEg3Zv","VaSUUtwt","sUlCpAxW","DwuIe6ha"],"icon_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/93bf31c668a4ccf3e41668d0a721ed91bfba13bc_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/93bf31c668a4ccf3e41668d0a721ed91bfba13bc.png","issues_url":"https://github.com/Gamedash43/Gamedash43-Addon-Bug-Tracker/issues","source_url":null,"wiki_url":null,"discord_url":"https://discord.gg/Dfy8HbVZZh","donation_urls":[{"id":"ko-fi","platform":"Ko-fi","url":"https://ko-fi.com/gamedash43"}],"gallery":[{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/2040688d9359534c9db3c288c43c010a396b8960.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/2040688d9359534c9db3c288c43c010a396b8960.png","featured":false,"title":null,"description":null,"created":"2025-10-11T00:41:40.519221Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/dc63785107607d00d454a607fa6f60e34c9f4b9c.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/dc63785107607d00d454a607fa6f60e34c9f4b9c.png","featured":false,"title":null,"description":null,"created":"2025-10-11T00:41:45.757592Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/75958fabd03e75fdabfdf002ae40c8545e08a831.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/75958fabd03e75fdabfdf002ae40c8545e08a831.png","featured":false,"title":null,"description":null,"created":"2025-10-11T00:41:50.897847Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/7075775eb0ecf82e6a634ed77b687dd93212a739.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/7075775eb0ecf82e6a634ed77b687dd93212a739.png","featured":false,"title":null,"description":null,"created":"2025-10-11T00:42:00.466417Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/d99b283f56c255530e9a7b9f5bb8dd14028ac1d0.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/d99b283f56c255530e9a7b9f5bb8dd14028ac1d0.png","featured":false,"title":null,"description":null,"created":"2025-10-11T00:42:06.387589Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/d29152b8f9ccb6657bf68037d1b5f9edd35cfb56.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/d29152b8f9ccb6657bf68037d1b5f9edd35cfb56.png","featured":false,"title":null,"description":null,"created":"2025-10-11T00:42:13.144614Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/05bdfc5d8a94aa6c4de7f91b4f91e43d18c9d764_350.webp","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/05bdfc5d8a94aa6c4de7f91b4f91e43d18c9d764.png","featured":false,"title":null,"description":null,"created":"2025-10-11T00:44:09.484567Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/310d2c390780de22f3515ee1518fd8d4dfdce588_350.webp","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/310d2c390780de22f3515ee1518fd8d4dfdce588.png","featured":true,"title":"Glow Torches ","description":null,"created":"2025-10-18T23:56:08.812693Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/3fec626cb529df990753c42acc00a37614c973d9_350.webp","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/3fec626cb529df990753c42acc00a37614c973d9.png","featured":false,"title":"Glow Torch Recipe","description":null,"created":"2025-10-18T23:58:03.234532Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/1927f5630378fe191a8e5e13357aeca253e24b42.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/1927f5630378fe191a8e5e13357aeca253e24b42.png","featured":false,"title":"Crunchy Ice Salad Recipe","description":null,"created":"2026-01-19T02:48:40.155300Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/bb18610f2a68930ace73ca3d1ab72a23b48ec0f4.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/bb18610f2a68930ace73ca3d1ab72a23b48ec0f4.png","featured":false,"title":"Dried Rotten Flesh to Leather","description":null,"created":"2026-01-19T02:48:52.245747Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/cd84f7ad9cdf9d020a4b00b8bcb3bb1b037b6281.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/cd84f7ad9cdf9d020a4b00b8bcb3bb1b037b6281.png","featured":false,"title":"Rough Mat Recipe","description":null,"created":"2026-01-19T02:49:04.494971Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/c491f963469bb1d9235d69c386ae34974c310ec2.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/c491f963469bb1d9235d69c386ae34974c310ec2.png","featured":false,"title":"Shattered Nether Star Recipe","description":null,"created":"2026-01-19T02:49:17.798399Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/7933794bd098de051d5c983bf680c598a4d77137.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/7933794bd098de051d5c983bf680c598a4d77137.png","featured":false,"title":"Shell Nest Recipe","description":null,"created":"2026-01-25T23:12:36.831600Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/dc2230951a106b876a5742192618a2cbdbe928b9.png","raw_url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/dc2230951a106b876a5742192618a2cbdbe928b9.png","featured":false,"title":"Sticky Stew Recipe","description":null,"created":"2026-01-25T23:12:51.301725Z","ordering":0},{"url":"https://cdn.modrinth.com/data/RIVSZ9Ee/images/2ff52614b46a458e4db6