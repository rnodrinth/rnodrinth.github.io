ate":"2010-06-15T22:00:00Z","major":false},{"version":"c0.30_01c","version_type":"alpha","date":"2009-12-21T22:00:00Z","major":false},{"version":"c0.0.13a","version_type":"alpha","date":"2009-05-30T22:00:00Z","major":false},{"version":"c0.0.13a_03","version_type":"alpha","date":"2009-05-21T22:00:00Z","major":false},{"version":"c0.0.11a","version_type":"alpha","date":"2009-05-16T22:00:00Z","major":false},{"version":"rd-161348","version_type":"alpha","date":"2009-05-16T11:48:00Z","major":false},{"version":"rd-160052","version_type":"alpha","date":"2009-05-15T22:52:00Z","major":false},{"version":"rd-20090515","version_type":"alpha","date":"2009-05-14T22:00:00Z","major":false},{"version":"rd-132328","version_type":"alpha","date":"2009-05-13T21:28:00Z","major":false},{"version":"rd-132211","version_type":"alpha","date":"2009-05-13T20:11:00Z","major":false}]'),J5e=[{short:"patreon",name:"Patreon"},{short:"bmac",name:"Buy Me A Coffee"},{short:"paypal",name:"PayPal"},{short:"github",name:"GitHub Sponsors"},{short:"ko-fi",name:"Ko-fi"},{short:"other",name:"Other"}],Q5e=["spam","copyright","inappropriate","malicious","name-squatting","poor description","invalid metadata","other"],Jxe=JSON.parse('[{"client_side":"optional","server_side":"required","game_versions":["26.1","26.1.1","26.1.2","26.2","26.3"],"environment":["client_and_server"],"id":"JXNbGotZ","slug":"rubble-colony","project_type":"mod","team":"peCBY1WJ","organization":"mvAuKjwK","title":"Rubble Colony","description":"A datapack for Enderscape that adds a Rubblemite variant for every rock in Minecraft","body":"## <center>But what if there were more rubblemites...</center>\\n**Rubble Colony** is an add-on for [**Enderscape**](https://modrinth.com/mod/enderscape) that adds new variants for Rubblemites and Rubble Shields based on the stone-like blocks found in the Overworld and Nether. Once you start to build in The End, eventually you may start to see Rubblemites with new types of shells around your builds. \\n\\n### <center> ⚠️ Usage Notice ⚠️ </center>\\nWhen using the data pack version, you need to download and enable the required resource pack from the Versions page.\\n\\nRubblemites will still only spawn in The End. They can be spawned by placing appropriate blocks in The End.","body_url":null,"published":"2026-08-14T02:12:17.823386Z","updated":"2026-10-13T23:21:23.344760Z","approved":"2026-08-17T21:01:47.372242Z","queued":"2026-08-16T18:49:42.280764Z","status":"approved","requested_status":"approved","moderator_message":null,"license":{"id":"CC-BY-NC-SA-4.0","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","url":null},"downloads":548,"followers":19,"categories":["equipment","mobs"],"additional_categories":[],"loaders":["datapack","fabric"],"versions":["ZmNE0MzQ","9JMgersD","ZcmWe5Mf","4oajK87k","InTdFFCB","1MElXfnd"],"icon_url":"https://cdn.modrinth.com/data/JXNbGotZ/a63e0f740270a1466ab96153cf94a7b84809ab10_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/JXNbGotZ/a63e0f740270a1466ab96153cf94a7b84809ab10.png","issues_url":"https://github.com/Penumbra-MC/rubble-colony/issues","source_url":"https://github.com/Penumbra-MC/rubble-colony","wiki_url":null,"discord_url":"https://discord.gg/bksj9aqqgb","donation_urls":[],"gallery":[{"url":"https://cdn.modrinth.com/data/JXNbGotZ/images/390a751c2ecc56727fead9eb61c0ec50bcb0b895_350.webp","raw_url":"https://cdn.modrinth.com/data/JXNbGotZ/images/390a751c2ecc56727fead9eb61c0ec50bcb0b895.png","featured":true,"title":"RubbleTree (Rubblemites under a Tree)","description":"Taken by Konci with CliffTree data pack.\\nRubblemites do not spawn in the Overworld.","created":"2026-08-16T08:13:52.084622Z","ordering":0},{"url":"https://cdn.modrinth.com/data/JXNbGotZ/images/20ec28e763b2047d2e368b126cc5d8d7b043cef0_350.webp","raw_url":"https://cdn.modrinth.com/data/JXNbGotZ/images/20ec28e763b2047d2e368b126cc5d8d7b043cef0.png","featured":false,"title":"Suspicious Sandstone","description":"Taken by Konci with Clif