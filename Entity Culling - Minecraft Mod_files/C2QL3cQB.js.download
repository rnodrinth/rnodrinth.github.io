3007_350.webp","raw_url":"https://cdn.modrinth.com/data/DFqQfIBR/images/197bbd5158cb5ddf43bf1d64be1aa650d8482e4d.png","featured":false,"title":"Overworld Display","description":"Default Config; In a Singleplayer Game in the Overworld","created":"2022-08-08T16:27:11.075410Z","ordering":0},{"url":"https://cdn.modrinth.com/data/DFqQfIBR/images/ac40602b01b61db45f23e81a9630e12652d36217_350.webp","raw_url":"https://cdn.modrinth.com/data/DFqQfIBR/images/ac40602b01b61db45f23e81a9630e12652d36217.png","featured":false,"title":"Nether Display","description":"Default Config; In a Singleplayer Game in the Nether","created":"2022-08-08T16:27:11.075410Z","ordering":0},{"url":"https://cdn.modrinth.com/data/DFqQfIBR/images/ee6b1a34105e8a4f725ab7d8341e47ef4ec915cc_350.webp","raw_url":"https://cdn.modrinth.com/data/DFqQfIBR/images/ee6b1a34105e8a4f725ab7d8341e47ef4ec915cc.png","featured":false,"title":"The End Display","description":"Default Config; In a Singleplayer Game in the End","created":"2022-08-08T16:27:11.075410Z","ordering":0},{"url":"https://cdn.modrinth.com/data/DFqQfIBR/images/b6441eef900be26f86aa87ccb0f52f6594967beb_350.webp","raw_url":"https://cdn.modrinth.com/data/DFqQfIBR/images/f6c3d3083e6fb279f02f553a83e61e14ab2e7cbe.png","featured":false,"title":"Example Server Display (Hypixel)","description":"Hypixel Display with Small Icon Modified. Server Server MSG Config: mc.hypixel.net;Playing on Hypixel!;hypixel","created":"2022-08-08T16:27:11.075410Z","ordering":0}],"color":5519395,"thread_id":"DFqQfIBR","monetization_status":"monetized"},{"client_side":"required","server_side":"required","game_versions":["1.18.1","1.18.2"],"environment":["client_and_server"],"id":"jVvDUhcz","slug":"smashing","project_type":"mod","team":"CMY1vRoM","organization":null,"title":"Smashing!","description":"A Minecraft mod inspired by Terraria\'s pots!","body":"![Title](https://media.discordapp.net/attachments/926370297362411520/954910188337512498/trimmed.png?width=1025&height=269)\\n\\n\\n\\n\\n\\n\\n\\nThis mod adds breakable pots that drop helpful loot when broken, which can range from torches to emeralds and plenty in between! Pots also drop shards that you can use to make pots of your own!\\n\\nIn the future we plan on having biome variant pots with specialized loot, and mod compat so you can get things like ropes and bombs from other mods!\\n\\nRequires [Pollen](https://www.curseforge.com/minecraft/mc-mods/pollen)!\\n\\n![Demo Image](https://media.discordapp.net/attachments/840459799774232596/953454805588791386/unknown.png?width=741&height=473)\\n","body_url":null,"published":"2022-03-23T11:53:00.075429Z","updated":"2022-05-12T04:47:42.538406Z","approved":"2022-03-23T11:53:00.075429Z","queued":null,"status":"approved","requested_status":null,"moderator_message":null,"license":{"id":"LGPL-3.0-only","name":"GNU Lesser General Public License v3.0 only","url":null},"downloads":1547,"followers":25,"categories":["adventure","decoration","worldgen"],"additional_categories":[],"loaders":["fabric","forge"],"versions":["Q6nJwBQe","INDxLmoz","2ezcfPbS","vZ3RRTfE","Qeeqx9Eo","IhnofCv0"],"icon_url":"https://cdn.modrinth.com/data/jVvDUhcz/f7e31fd32579ffac3b8ff3f6be60a14e337e2831_96.webp","raw_icon_url":"https://cdn.modrinth.com/data/jVvDUhcz/icon.png","issues_url":"https://github.com/Chalkboard-Mods/smashing/issues","source_url":"https://github.com/Chalkboard-Mods/smashing","wiki_url":null,"discord_url":"https://discord.gg/w46vPg53Gd","donation_urls":[],"gallery":[],"color":5650483,"thread_id":"jVvDUhcz","monetization_status":"monetized"},{"client_side":"required","server_side":"unsupported","game_versions":["1.10.2","1.11","1.11.2","1.12","1.12.1","1.12.2","1.14.4","1.15.2","1.16.1","1.16.2","1.16.3","1.16.4","1.16.5","1.17","1.17.1","1.18","1.18.1","1.18.2","1.19","1.19.1","1.19.2","1.19.3","1.19.4","1.20","1.20.1","1.20.2","1.20.3","1.20.4","1.20.6","1.21","1.21.1","1.21.10","1.21.11","1.21.2","1.21.3","1.21.4","1.21.5","1.21.6","1.21.7","1.21.8","1.21.9","1.8","1.8.9","1.9.4","26.1","26.1.1","26.1.2","26.2","26.3"],"environment":["client_only"],"id":"Nv2fQJo5","slug":"replaymod","project_type":"mod","team":"l4RHvuzg","organization":null,"title":"ReplayMod","description":"A Minecraft Mod to record, relive and share your experience.","body":"The ReplayMod allows you to record, replay and share your gaming experience.\\n\\nIt\'s easy to use, but an incredibly powerful tool. Create perfect Minecraft videos within minutes.\\n\\nReplay Files are in a lightweight format - an average recording over 1 hour is less than 10 Megabytes large. You can easily share your Replays with your friends simply by sending them the file.\\n\\nComing with a built-in video creator, the Replay Mod allows everyone to make perfect clips without any external software. The simple User Interface makes it very easy to design awesome Camera Paths.","body_url":null,"published":"2022-08-09T15:07:08.084510Z","updated":"2026-10-18T15:40:02.854244Z","approved":null,"queued":null,"status":"approved","requested_status":null,"moderator_message":null,"license":{"id":"GPL-3.0-or-later","name":"GNU General Public License v3.0 or later","url":null},"downloads":19371668,"followers":4524,"categories":["utility"],"additional_categories":[],"loaders":["fabric","forge"],"versions":["LAdb5qRt","Bg7RAHyJ","sQVYgpOo","58ltb58q","4clpWNTC","fpD0rrcN","WQZaoKq7","UlwxDwga","sXD2DQ4C","Wa796DiZ","oB9rCIQ3","pSeNqPLG","2jcrjeH9","yRzXlkbS","iPTJ3Zg4","d40s9baB","8fXhWBcR","5CxMrid7","EsOxUHNK","LIVeUIqD","1IAzC6AX","iMFoo1IA","thijJjIp","1rOZN1zo","ndcLZoMa","Qe1waaR6","WLE7L2Tr","BVuva3fz","RCeY0aqJ","KIWAOVvq","volcHOdL","QtrMwqKM","81jL9qWp","Cl8Krcqb","IKpv0q93","xDKX1srD","DSbGQic7","okcFOvQB","JVvnSjwE","z93btwUO","YtwBv8Wx","InlvtwmO","EcNOFu8c","6yy8gtDQ","ke9ZuM1y","tuL0Wy4t","7H88dLh3","2q2c14V5","ViDqRNbv","7PD0BOWI","WcMD8WyW","Xi51Pi93","CmWWcgPa","XEgvQEao","XRiofskF","QEnGJzQi","JR4YzF0B","hrjyOCCd","NzL9uuuq","Yc2W8QF2","vpwF1AEt","4KnSuv5i","RTpOrhlB","C1eDr4u8",